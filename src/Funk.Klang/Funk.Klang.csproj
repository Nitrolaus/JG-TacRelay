<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Gebaute native DLLs (native\skripte\*.ps1). In Arbeitskopien per absolutem Pfad, weil die DLLs nicht im Repository liegen. -->
    <FunkNativeOrdner Condition="'$(FunkNativeOrdner)' == ''">C:\Claude\work\JG-TacRelay\native\out\win-x64</FunkNativeOrdner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(FunkNativeOrdner)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
