<!-- JG TacRelay - Maintainer: Sarevoc -->
<!--
  Eigene Symbole als Vektorpfade in einem 24x24-Feld, zum Nachzeichnen mit Strich (Stil "Symbol"). Keine fremden
  Grafiken, keine fremde Symbolschrift für Zustände: Senden, Hören und Aus müssen auch dort erscheinen, wo
  Segoe Fluent Icons fehlt (Windows 10). Die Knöpfe der Titelleiste nutzen die Systemschrift Segoe Fluent Icons
  mit Rückfall auf Segoe MDL2 Assets.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Senden: Punkt mit zwei Wellen je Seite -->
    <Geometry x:Key="Symbol.Senden">M 10,12 A 2,2 0 1 0 14,12 A 2,2 0 1 0 10,12 Z M 8.2,8.2 A 5.4,5.4 0 0 0 8.2,15.8 M 15.8,8.2 A 5.4,5.4 0 0 1 15.8,15.8 M 5.3,5.3 A 9.5,9.5 0 0 0 5.3,18.7 M 18.7,5.3 A 9.5,9.5 0 0 1 18.7,18.7</Geometry>

    <!-- Hören: Kopfhörer -->
    <Geometry x:Key="Symbol.Hoeren">M 4,15 V 12 A 8,8 0 0 1 20,12 V 15 M 4,14 H 7.5 V 20 H 5 A 1,1 0 0 1 4,19 Z M 20,14 H 16.5 V 20 H 19 A 1,1 0 0 0 20,19 Z</Geometry>

    <!-- Aus: Kreis mit Schrägstrich -->
    <Geometry x:Key="Symbol.Aus">M 12,3 A 9,9 0 1 1 11.99,3 Z M 5.6,5.6 L 18.4,18.4</Geometry>

    <!-- Sprachaktivierung: Wellenform -->
    <Geometry x:Key="Symbol.Sprachaktivierung">M 4,10 V 14 M 8,7 V 17 M 12,4 V 20 M 16,8 V 16 M 20,10 V 14</Geometry>

    <!-- Sprechtaste: Taste mit Druckpunkt -->
    <Geometry x:Key="Symbol.Sprechtaste">M 5,6 H 19 A 2,2 0 0 1 21,8 V 16 A 2,2 0 0 1 19,18 H 5 A 2,2 0 0 1 3,16 V 8 A 2,2 0 0 1 5,6 Z M 10,12 A 2,2 0 1 0 14,12 A 2,2 0 1 0 10,12 Z</Geometry>

    <!-- Lautstärke: Lautsprecher mit zwei Bögen -->
    <Geometry x:Key="Symbol.Lautstaerke">M 3,9 H 7 L 12,5 V 19 L 7,15 H 3 Z M 15.5,8.5 A 5,5 0 0 1 15.5,15.5 M 18,6 A 8.5,8.5 0 0 1 18,18</Geometry>

    <!-- Mikrofon -->
    <Geometry x:Key="Symbol.Mikrofon">M 9,6 A 3,3 0 0 1 15,6 V 11 A 3,3 0 0 1 9,11 Z M 6,11 A 6,6 0 0 0 18,11 M 12,17 V 21 M 9,21 H 15</Geometry>

    <!-- Mikro stumm (Klangstufe C2b): dasselbe Mikrofon mit Querstrich von links oben nach rechts unten, selbst gezeichnet -->
    <Geometry x:Key="Symbol.MikrofonStumm">M 9,6 A 3,3 0 0 1 15,6 V 11 A 3,3 0 0 1 9,11 Z M 6,11 A 6,6 0 0 0 18,11 M 12,17 V 21 M 9,21 H 15 M 3.5,3 L 20.5,21</Geometry>

    <!-- Ausrufezeichen der Auto Dauersend-Dämpfung (Klangstufe C2b) im 14x14-Feld des gelben Kreises: Strich und Punkt (kurzer Strich mit runden Enden) -->
    <Geometry x:Key="Symbol.Ausrufe">M 7,3.4 V 8.4 M 7,10.9 V 11</Geometry>

    <!-- Global: Kugel mit Längen- und Breitenkreis -->
    <Geometry x:Key="Symbol.Global">M 12,3 A 9,9 0 1 1 11.99,3 Z M 3,12 H 21 M 12,3 A 12,12 0 0 1 12,21 M 12,3 A 12,12 0 0 0 12,21</Geometry>

    <!-- Entfernen: schlichtes Kreuz -->
    <Geometry x:Key="Symbol.Entfernen">M 7,7 L 17,17 M 17,7 L 7,17</Geometry>

    <!-- Sprecher: Person -->
    <Geometry x:Key="Symbol.Sprecher">M 12,4 A 4,4 0 1 1 11.99,4 Z M 4,21 A 8,7 0 0 1 20,21</Geometry>

    <!-- Schiff: stilisierter Rumpf von oben -->
    <Geometry x:Key="Symbol.Schiff">M 12,2 L 16,9 V 18 L 20,21 H 4 L 8,18 V 9 Z M 12,9 V 15</Geometry>

    <!-- Start: Haus mit Tür (Leiste, seit 0.6.0), selbst gezeichnet -->
    <Geometry x:Key="Symbol.Start">M 3.5,11.5 L 12,4 L 20.5,11.5 M 6,9.5 V 20 H 18 V 9.5 M 10,20 V 14.5 H 14 V 20</Geometry>

    <!-- Verbindung: zwei verbundene Knoten -->
    <Geometry x:Key="Symbol.Verbindung">M 5,12 A 2.5,2.5 0 1 0 10,12 A 2.5,2.5 0 1 0 5,12 Z M 14,12 A 2.5,2.5 0 1 0 19,12 A 2.5,2.5 0 1 0 14,12 Z M 10,12 H 14 M 7.5,9.5 V 4 M 16.5,14.5 V 20</Geometry>

    <!-- Schwelle: Kurve mit Linie -->
    <Geometry x:Key="Symbol.Schwelle">M 2,18 L 6,14 L 9,16 L 13,6 L 16,12 L 19,10 L 22,15 M 2,10 H 22</Geometry>

    <!-- Funkfeld: Kachelraster -->
    <Geometry x:Key="Symbol.Funkfeld">M 3,5 H 10 V 11 H 3 Z M 14,5 H 21 V 11 H 14 Z M 3,14 H 10 V 20 H 3 Z M 14,14 H 21 V 20 H 14 Z</Geometry>

    <!-- Ansichten des Funkfelds: A Raster (2 Reihen Kacheln), C Liste (Zeilen) -->
    <Geometry x:Key="Symbol.AnsichtRaster">M 2.5,6 H 8 V 11 H 2.5 Z M 9.5,6 H 15 V 11 H 9.5 Z M 16.5,6 H 22 V 11 H 16.5 Z M 2.5,13 H 8 V 18 H 2.5 Z M 9.5,13 H 15 V 18 H 9.5 Z M 16.5,13 H 22 V 18 H 16.5 Z</Geometry>
    <Geometry x:Key="Symbol.AnsichtListe">M 4,4.5 H 7 V 7.5 H 4 Z M 10,6 H 20.5 M 4,10.5 H 7 V 13.5 H 4 Z M 10,12 H 20.5 M 4,16.5 H 7 V 19.5 H 4 Z M 10,18 H 20.5</Geometry>

    <!-- Durchsichtigkeit (A30): Kreis, die rechte Hälfte schraffiert -->
    <Geometry x:Key="Symbol.Durchsicht">M 12,3 A 9,9 0 1 1 11.99,3 Z M 12,3 V 21 M 12,8 H 19.5 M 12,12 H 20.5 M 12,16 H 19.5</Geometry>

    <!-- Einstellungen: Regler -->
    <Geometry x:Key="Symbol.Einstellungen">M 4,6 H 20 M 4,12 H 20 M 4,18 H 20 M 9,4 V 8 M 15,10 V 14 M 7,16 V 20</Geometry>

    <!-- Hinweis: Kreis mit i (der Punkt ist ein kurzer Strich mit runden Enden) -->
    <Geometry x:Key="Symbol.Hinweis">M 12,3 A 9,9 0 1 1 11.99,3 Z M 12,11 V 17 M 12,7.4 V 7.6</Geometry>

    <!-- Haken: geprüft und in Ordnung -->
    <Geometry x:Key="Symbol.Haken">M 5,12.5 L 10,17 L 19,7</Geometry>

    <!-- Schlüssel: Ring, Schaft, zwei Zähne -->
    <Geometry x:Key="Symbol.Schluessel">M 3,12 A 4,4 0 1 0 11,12 A 4,4 0 1 0 3,12 Z M 11,12 H 21 M 17,12 V 15.5 M 20.5,12 V 15</Geometry>

    <!-- Brett der Einsatzleitung (Bereich Raid): drei Spalten mit Karten, selbst gezeichnet -->
    <Geometry x:Key="Symbol.Brett">M 3,4 H 21 V 20 H 3 Z M 9,4 V 20 M 15,4 V 20 M 4.5,7.5 H 7.5 M 10.5,7.5 H 13.5 M 10.5,11 H 13.5 M 16.5,7.5 H 19.5</Geometry>

    <!-- Abzeichen (Bereich Abzeichen, 0.11.7): Schild mit einem Winkel, selbst gezeichnet -->
    <Geometry x:Key="Symbol.Abzeichen">M 5,3.5 H 19 V 13 L 12,20.5 L 5,13 Z M 8.5,8.5 L 12,12 L 15.5,8.5</Geometry>

    <!-- Sprecheranzeige (Abschnitt der Einstellungen, 0.11.9): Monitor mit einer Zeile oben links, selbst gezeichnet -->
    <Geometry x:Key="Symbol.Sprecheranzeige">M 3,4 H 21 V 16 H 3 Z M 12,16 V 20 M 8,20 H 16 M 6,7.5 H 13</Geometry>

    <!-- Meldungen (Abschnitt der Einstellungen, 0.12.0): Monitor mit einem Zeichen oben in der Mitte, selbst gezeichnet -->
    <Geometry x:Key="Symbol.Meldungen">M 3,4 H 21 V 16 H 3 Z M 12,16 V 20 M 8,20 H 16 M 10,6.5 H 14 V 10.5 H 10 Z</Geometry>

</ResourceDictionary>
