<Application x:Class="Funk.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:se="clr-namespace:Funk.Client.Steuerelemente"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/Farben.xaml" />
                <ResourceDictionary Source="Design/Symbole.xaml" />
                <!-- Glasdesign (extern\Glasdesign): Farbstellung Anthrazit (Petrol) und die Glas.*-Stile, ohne deren Vorgabestile;
                     Stile.xaml stellt Knopf, Knopf.Haupt, Umschalter und ToolTip darauf. -->
                <ResourceDictionary Source="/Glasdesign;component/Farbstellungen/Anthrazit.xaml" />
                <ResourceDictionary Source="/Glasdesign;component/Glas.Stile.xaml" />
                <ResourceDictionary Source="Design/Stile.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <se:SichtbarWenn x:Key="SichtbarWenn" />
            <se:SichtbarWenn x:Key="SichtbarWennNicht" Umkehren="True" />
            <se:SichtbarWennWert x:Key="SichtbarWennWert" />
            <se:Ressource x:Key="Ressource" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
