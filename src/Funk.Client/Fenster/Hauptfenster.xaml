<!-- JG TacRelay - Maintainer: Sarevoc -->
<Window x:Class="Funk.Client.Fenster.Hauptfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Funk.Client.Modelle"
        xmlns:f="clr-namespace:Funk.Client.Fenster"
        xmlns:se="clr-namespace:Funk.Client.Steuerelemente"
        xmlns:gd="clr-namespace:Glasdesign;assembly=Glasdesign"
        x:Name="Fenster"
        WindowStartupLocation="Manual" Style="{StaticResource Fenster.Basis}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary Source="Bereiche.xaml" />
    </Window.Resources>

    <!-- Seit dem Umbau der Einstellungen (E2): Strg+1 Start, Strg+2 Einstellungen, Strg+5 Raid, Strg+9 Verwaltung; Strg+3 und Strg+4 gibt es nicht mehr. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding BereichWaehlenCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding BereichWaehlenCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="NumPad1" Command="{Binding BereichWaehlenCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="NumPad2" Command="{Binding BereichWaehlenCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding BereichWaehlenCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="NumPad5" Command="{Binding BereichWaehlenCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding BereichWaehlenCommand}" CommandParameter="9" />
        <KeyBinding Modifiers="Control" Key="NumPad9" Command="{Binding BereichWaehlenCommand}" CommandParameter="9" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding WerIstDa.UmschaltenCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad6" Command="{Binding WerIstDa.UmschaltenCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding FunkfeldZeigenCommand}" />
        <!-- Umbau der Einstellungen (Q87, E2): Strg+T öffnet die Seite Sprachaktivierung, wenn es sie gibt; ein Aufklappen unten gibt es nicht mehr. -->
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding SprachaktivierungEinstellenCommand}" />
    </Window.InputBindings>

    <!-- ui-fix (Q40): über dem Inhalt das Popup des Einmessens; solange es offen ist, ist der Inhalt weichgezeichnet und nicht bedienbar -->
    <Grid x:Name="Wurzelraster">
    <Grid x:Name="Inhalt">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BeendenFrageOffen}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="10" KernelType="Gaussian" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="IsHitTestVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Audio.Korridor.PopupOffen}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="10" KernelType="Gaussian" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="IsHitTestVisible" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <!-- Titelleiste, Inhalt, Statuszeile "Mikrofon" (seit dem Umbau der Einstellungen, Q87, statt der Leiste Sprachaktivierung), Fußzeile -->
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titelleiste: Leitfarbe als Fläche, weiße Schrift (13,3:1), Fokus weiß (der Akzent hätte hier nur 3,3:1); ihre Knöpfe bleiben flach -->
        <Grid x:Name="TitelLeiste" Background="{StaticResource Pinsel.Leitfarbe}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,18,0" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="15">
                    <Run Text="JG " FontWeight="Light" /><Run Text="TACRELAY" FontWeight="Bold" />
                </TextBlock>
                <!-- Fassung aus der Assembly (Hauptfenster.xaml.cs), klein hinter dem Namen -->
                <TextBlock x:Name="FassungText" Margin="8,3,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center" Background="#33000000">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Verbindung}" Width="14" Height="14" Margin="0,0,6,0"
                          Stroke="{StaticResource Pinsel.Text}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <!--
              Wer spricht; Klangstufe C2b: davor das gelbe "!", wenn einer davon ein Dauersender ist (Tooltip nennt ihn, Klick: die Auswahl).
              Seit dem Umbau der Einstellungen (E23) fällt die Zeile unter 700 Fensterbreite weg (Hauptfenster.xaml.cs, TitelleisteSetzen); wer spricht, zeigt dann das Funkfeld.
            -->
            <DockPanel x:Name="SprechendPlatz" Grid.Column="2" Margin="16,0">
                <se:Klappwahl x:Name="SprechendZeichen" DockPanel.Dock="Left" Style="{StaticResource Klappwahl.Ausrufe}" Margin="0,0,6,0"
                              FocusVisualStyle="{StaticResource Fokus.RahmenHell}" WindowChrome.IsHitTestVisibleInChrome="True"
                              DataContext="{Binding SprechendZeichen}" Visibility="{Binding Converter={StaticResource SichtbarWennWert}}" />
                <TextBlock x:Name="SprechendText" VerticalAlignment="Center" FontSize="13" Text="{Binding Sprechend}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <!--
              Seit dem Umbau der Einstellungen (E23, Prüfbericht Mischung Punkt 3): Unter 900 Fensterbreite zeigen beide Knöpfe nur Zeichen und Zahl, damit "spricht: ..."
              daneben Platz hat; der Name bleibt im Hilfetext und für Bildschirmleser. Umschalten in Hauptfenster.xaml.cs (TitelleisteSetzen).
            -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <!--
                  Meldesystem (Sarevoc 16.10.2026): "Bereit melden", nur solange die Leitung fragt (Bereit-Abfrage offen, du bist gefragt); nach dem Melden "gemeldet".
                  Dasselbe tut die Taste "Bereit" unter Einstellungen > Tasten > Erweitert.
                -->
                <Button x:Name="BereitKnopf" Command="{Binding Bereit.MeldenCommand}" WindowChrome.IsHitTestVisibleInChrome="True" Padding="12,3" MinHeight="28"
                        Margin="0,0,8,0" FocusVisualStyle="{StaticResource Fokus.RahmenHell}" gd:Hilfe.Text="{x:Static m:Bereitmeldung.Hilfe}"
                        AutomationProperties.Name="{Binding Bereit.KnopfText}" Visibility="{Binding Bereit.Offen, Converter={StaticResource SichtbarWenn}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Knopf.Flach}">
                            <Setter Property="Background" Value="{StaticResource Pinsel.Senden}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Senden}" />
                            <Setter Property="Foreground" Value="{StaticResource Pinsel.AufFarbe}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bereit.Gemeldet}" Value="True">
                                    <Setter Property="Background" Value="#26000000" />
                                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="BereitText" Text="{Binding Bereit.KnopfText}" FontSize="12" FontWeight="SemiBold" />
                </Button>
                <!-- A48: wer gerade eingeloggt ist; öffnet die Spalte rechts -->
                <Button x:Name="WerIstDaKnopf" Style="{StaticResource Knopf.Flach}" Command="{Binding WerIstDa.UmschaltenCommand}" WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,3" MinHeight="28"
                        Margin="0,0,8,0" Background="#26000000" BorderBrush="#66FFFFFF" FocusVisualStyle="{StaticResource Fokus.RahmenHell}"
                        gd:Hilfe.Text="Wer ist da: zeigt rechts, wer gerade eingeloggt ist." gd:Hilfe.Taste="Strg+6" AutomationProperties.Name="Wer ist da">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Sprecher}" Width="14" Height="14" />
                        <TextBlock x:Name="WerIstDaText" Text="{Binding WerIstDa.KnopfText}" FontSize="12" Margin="6,0,0,0" />
                        <!-- Kurz: nur die Zahl; ist niemand online, steht nur das Zeichen da. -->
                        <Border x:Name="WerIstDaKurzPlatz" Visibility="Collapsed">
                            <TextBlock x:Name="WerIstDaKurz" Text="{Binding WerIstDa.KnopfKurz}" FontSize="12" Margin="6,0,0,0"
                                       Visibility="{Binding WerIstDa.KnopfKurz, Converter={StaticResource SichtbarWennWert}}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="FunkfeldKnopf" Style="{StaticResource Knopf.Flach}" Command="{Binding FunkfeldZeigenCommand}" WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,3" MinHeight="28"
                        Background="#26000000" BorderBrush="#66FFFFFF" FocusVisualStyle="{StaticResource Fokus.RahmenHell}" gd:Hilfe.Text="Funkfeld: holt das Funkfeld nach vorn."
                        gd:Hilfe.Taste="Strg+F" AutomationProperties.Name="Funkfeld">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Funkfeld}" Width="14" Height="14" />
                        <TextBlock x:Name="FunkfeldText" Text="Funkfeld" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Knopf.Titel}" Content="&#xE921;" Command="SystemCommands.MinimizeWindowCommand"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimieren" AutomationProperties.Name="Minimieren" Height="44" />
                <Button x:Name="MaxKnopf" Style="{StaticResource Knopf.Titel}" Content="&#xE922;" Click="MaxKnopf_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximieren" AutomationProperties.Name="Maximieren" Height="44" />
                <Button Style="{StaticResource Knopf.Schliessen}" Content="&#xE8BB;" Command="SystemCommands.CloseWindowCommand"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Schließen" AutomationProperties.Name="Schließen" Height="44" />
            </StackPanel>
        </Grid>

        <!-- Navigation und Inhalt (bis zum Umbau der Einstellungen mit der Leiste der Sprachaktivierung darunter) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!--
                  Sarevoc 14.10.2026: "Die Wer-ist-da-Liste sollte ohne Abstand zum Hauptfenster platziert sein, der freie Bereich muss weg." Auf den
                  Seiten mit Bildlauf (Start, Einstellungen; Inhalt höchstens 820 breit) wird der Platz der Seite bei offener Spalte nicht breiter
                  als der Inhalt, die Spalte steht direkt daneben; was übrig bleibt, liegt rechts davon. Raid, Verwaltung und Sprachaktivierung
                  nutzen die ganze Breite und reichen ohnehin bis an die Spalte.
                -->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding WerIstDa.InSpalte}" Value="True" />
                                        <Condition Binding="{Binding MitBildlauf}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="MaxWidth" Value="{x:Static f:Fenstergroessen.SeiteMitBildlaufBreite}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Pinsel.FlaecheTief}" Width="200">
                <!--
                  Bereiche und Unterpunkte (Stufe 2c: Sprachaktivierung, nur wenn sie benutzt wird; seit dem Umbau der Einstellungen unter Einstellungen).
                  Seit den Abzeichen steht ein Bereich mit Unten (Abzeichen) ganz unten: dieselbe Liste (eine Auswahl, Pfeiltasten wie bisher), die Einträge in
                  einem DockPanel, oben gestapelt, Unten am Boden; ohne Bildlauf, damit die Liste die ganze Höhe hat.
                -->
                <ListBox x:Name="Navi" Style="{StaticResource Navigation}" Margin="0,12,0,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Navigation}" SelectedItem="{Binding AktiverBereich}" AutomationProperties.Name="Bereiche">
                    <ListBox.Resources>
                        <!--
                          Fällt ein Eintrag heraus (Unterpunkt Sprachaktivierung, Abzeichen), nimmt die Liste ihm den Stil aus ItemContainerStyle; ohne
                          diesen Stil griffe dann die Vorgabe von ListBoxItem, deren Bindung an die Liste ins Leere geht (Bindungsfehler).
                        -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Navigation.Eintrag}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel LastChildFill="False" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Navigation.Eintrag}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="DockPanel.Dock" Value="Top" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Unten}" Value="True">
                                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                                    <Setter Property="Margin" Value="8,2,8,12" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Bereich}">
                            <StackPanel x:Name="Eintrag" Orientation="Horizontal" ToolTip="{Binding Taste}">
                                <Path x:Name="EintragSymbol" Style="{StaticResource Symbol}" Data="{Binding Symbol, Converter={StaticResource Ressource}}" Width="18" Height="18"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <!-- Die Namen bleiben sichtbar (Q7); nur Symbole wird eine Option in Stufe 3. -->
                                <TextBlock x:Name="EintragText" Text="{Binding Titel}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <!-- Unterpunkt: eingerückt unter den Bereich davor, Symbol und Schrift eine Spur kleiner -->
                                <DataTrigger Binding="{Binding Unterpunkt}" Value="True">
                                    <Setter TargetName="Eintrag" Property="Margin" Value="22,0,0,0" />
                                    <Setter TargetName="EintragSymbol" Property="Width" Value="15" />
                                    <Setter TargetName="EintragSymbol" Property="Height" Value="15" />
                                    <Setter TargetName="EintragText" Property="Margin" Value="9,0,0,0" />
                                    <Setter TargetName="EintragText" Property="FontSize" Value="13" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <!--
              Platz der Seiten mit Bildlauf (Start, Einstellungen). Liegt "Wer ist da" als Schublade über Start, setzt Hauptfenster.xaml.cs hier
              f:Hauptfenster.UnterSchublade (geerbt); die verdeckte Spalte Hören nimmt sich dann aus der Tastaturbedienung (Q93 a, Befund der Prüfung).
            -->
            <ScrollViewer x:Name="SeitenPlatz" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding MitBildlauf, Converter={StaticResource SichtbarWenn}}">
                <!-- Headset-Frage und Gerätewarnung stehen nur noch auf der Startseite (Q10, Bereiche.xaml). -->
                <StackPanel Margin="24,18,24,16">
                    <ContentControl Content="{Binding SeitenInhalt}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Raid: Das Brett braucht Breite und Höhe ohne den Bildlauf der übrigen Bereiche und bekommt einen eigenen Platz. -->
            <ContentControl x:Name="BrettPlatz" Grid.Column="1" Content="{Binding BrettInhalt}" Focusable="False" Margin="8,8,8,6"
                            Visibility="{Binding IstBrett, Converter={StaticResource SichtbarWenn}}" />

            <!-- Verwaltung: eigener Platz ohne den Bildlauf der Bereiche; sie rollt selbst, und die Leiste ihres Entwurfs bleibt unten. -->
            <ContentControl x:Name="VerwaltungPlatz" Grid.Column="1" Content="{Binding VerwaltungInhalt}" Focusable="False"
                            Visibility="{Binding IstVerwaltungsseite, Converter={StaticResource SichtbarWenn}}" />

            <!-- Abzeichen: wie die Verwaltung ein eigener Platz ohne den Bildlauf der Bereiche; die Seite rollt selbst. -->
            <ContentControl x:Name="AbzeichenPlatz" Grid.Column="1" Content="{Binding AbzeichenInhalt}" Focusable="False"
                            Visibility="{Binding IstAbzeichenseite, Converter={StaticResource SichtbarWenn}}" />

            <!--
              Seite Sprachaktivierung (Unterpunkt, Stufe 2c; seit dem Umbau der Einstellungen, Q87, unter Einstellungen): eigener Platz ohne den Bildlauf der Bereiche, die
              Grafik fest und groß, die Seite rollt um sie herum. Seitdem steht der Bereich fest hier (vorher setzte Hauptfenster.xaml.cs ihn
              zwischen unten und hier um); mit seinem eigenen Rand ergibt das denselben Abstand wie bei den übrigen Bereichen (24, 18, 24, 16).
            -->
            <ScrollViewer x:Name="SchwellenSeitenPlatz" Grid.Column="1" Padding="4,8,10,6" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding IstSprachaktivierungsseite, Converter={StaticResource SichtbarWenn}}">
                <f:Schwellenbereich x:Name="Schwellen" DataContext="{Binding Schwelle}" />
            </ScrollViewer>

            <!--
              Q93 a (Sarevoc 12.10.2026): Schatten der Schublade. In Klein ohne Platz zum Verbreitern liegt die Spalte "Wer ist da" rechts über Start, und
              dieser Verlauf steht an ihrer linken Kante; Start darunter behält seine Breite. Den Abstand rechts (die Breite der Spalte) setzt der
              Konstruktor in Hauptfenster.xaml.cs, SpalteAnordnen zeigt ihn nur; sonst ist er verborgen. Klicks gehen durch ihn hindurch.
            -->
            <Rectangle x:Name="WerIstDaSchatten" Grid.Column="1" Width="16" HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#73000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--
              A48: Wer ist da, eine Spalte rechts, kein eigenes Fenster; Breite aus Fenstergroessen.WerIstDaBreite. Seit Q93 a in Klein als Schublade
              über Start, wenn das Fenster nicht breiter werden kann (Hauptfenster.xaml.cs, SpalteAnordnen: Spalte 1, rechts).
            -->
            <Border x:Name="WerIstDaSpalte" Grid.Column="2" Width="{x:Static f:Fenstergroessen.WerIstDaBreite}" Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Linie}"
                    BorderThickness="1,0,0,0" Visibility="{Binding WerIstDa.InSpalte, Converter={StaticResource SichtbarWenn}}">
                <ContentControl Content="{Binding WerIstDa}" Focusable="False" />
            </Border>
        </Grid>

        <!--
          Statuszeile "Mikrofon" (Umbau der Einstellungen, Q87, Vorlage m-8; ersetzt die Leiste der Sprachaktivierung): die eine Stelle für Pegel und SENDET,
          auf jeder Seite, rollt nie weg. Links "Mikrofon", rechts der Hinweissatz (nur wenn du sprichst und nichts hinausgeht), der Pegel mit der
          Linie der Sprachaktivierung und die Marke SENDET, Ruhe oder Getrennt (Q90). Ohne dBFS und ohne Aufklappen; genau eingestellt wird auf der
          Seite Sprachaktivierung (Strg+T). Der Satz kürzt vor dem Überlaufen; alle fünf passen bei 640 Breite ganz (OberflaecheUmbauRahmenTests).
          Unter 700 Fensterbreite ist der Balken 120 statt 160 breit (Hauptfenster.xaml.cs, TitelleisteSetzen).
        -->
        <Border x:Name="Statuszeile" Grid.Row="2" DataContext="{Binding Statuszeile}" Background="{StaticResource Pinsel.FlaecheTief}"
                BorderBrush="{StaticResource Pinsel.Linie}" BorderThickness="0,1,0,0" Padding="16,7" gd:Hilfe.Text="{x:Static m:StatuszeileViewModel.Hilfe}">
            <DockPanel>
                <Path DockPanel.Dock="Left" Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Mikrofon}" Width="16" Height="16" Margin="0,0,8,0"
                      Stroke="{StaticResource Pinsel.Text}" />
                <TextBlock x:Name="StatusWeg" DockPanel.Dock="Left" Text="Mikrofon" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="StatusMarke" DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding MarkenText, StringFormat='Mikrofon: {0}'}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Pinsel.Flaeche}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Marke}" Value="{x:Static m:StatusMarke.Sendet}">
                                    <Setter Property="Background" Value="{StaticResource Pinsel.Senden}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="StatusMarkenText" Text="{Binding MarkenText}" FontSize="11" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Marke}" Value="{x:Static m:StatusMarke.Sendet}">
                                        <Setter Property="Foreground" Value="{StaticResource Pinsel.AufFarbe}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <se:Pegelbalken x:Name="StatusPegel" DockPanel.Dock="Right" Width="160" Height="10" VerticalAlignment="Center"
                                PegelDb="{Binding PegelDb}" SchwelleDb="{Binding LinieDb}" Sendet="{Binding Sendet}" WuerdeSenden="{Binding WuerdeSenden}"
                                Stumm="{Binding Stumm}" Hinweis="{Binding Hinweis}" HinweisImBalken="False" AutomationProperties.Name="Pegel des Mikrofons" />
                <TextBlock x:Name="StatusHinweis" DockPanel.Dock="Right" Style="{StaticResource Text.Hinweis}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Margin="12,0,10,0" VerticalAlignment="Center" Text="{Binding Hinweis}"
                           Visibility="{Binding Hinweis, Converter={StaticResource SichtbarWennWert}}" />
                <!-- Füllt den Rest, damit der Satz rechts beim Balken steht. -->
                <Border />
            </DockPanel>
        </Border>

        <!--
          Fußzeile (seit dem Umbau der Einstellungen, E13): rechts nur die Kürzel, links der letzte Hintergrundfehler, "als Funker bis ..." und die Warnungen beim Start.
          Der Klangtreiber ("Klang: WASAPI") steht seitdem unter Einstellungen > Fehlersuche.
        -->
        <Border x:Name="Fuss" Grid.Row="3" Background="{StaticResource Pinsel.FlaecheTief}" Padding="16,5">
            <DockPanel>
                <TextBlock x:Name="Tasten" DockPanel.Dock="Right" Style="{StaticResource Text.Hinweis}" Text="{Binding Tastenhinweis}" />
                <!-- Letzter Hintergrundfehler der Klangmaschine; auf der tiefen Fläche hat die rote Schrift genug Kontrast. -->
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Warnung}" FontSize="12" Margin="0,0,16,0" MaxWidth="520"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Audio.LetzterFehler}" ToolTip="{Binding Audio.LetzterFehler}"
                           Visibility="{Binding Audio.LetzterFehler, Converter={StaticResource SichtbarWennWert}}" />
                <!-- S2: "als Funker bis 04:00", solange der Modus läuft (6.15) -->
                <TextBlock x:Name="FunkerStand" DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"
                           Text="{Binding Funkermodus.StandText}" Visibility="{Binding Funkermodus.StandText, Converter={StaticResource SichtbarWennWert}}"
                           ToolTip="Heute als Funker. Wieder Admin unter Einstellungen oder im Menü des Symbols im Infobereich." />
                <TextBlock x:Name="Starthinweise" Style="{StaticResource Text.Hinweis}" Text="{Binding Starthinweise}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Starthinweise}" Visibility="{Binding Starthinweise, Converter={StaticResource SichtbarWennWert}}" />
            </DockPanel>
        </Border>
    </Grid>

    <!--
      Q40 (Sarevoc 04.10.2026): Einmessen als Popup über dem Fenster, zwei deutliche Schritte mit großem Countdown und Pegel: "Jetzt sprechen wie am Funk",
      kurze Pause, "Jetzt leise, wie zu jemandem im Raum", dann "Fertig" oder "noch einmal". Knöpfe aus Glas wie die anderen. Der Einmess-Kern bleibt
      (KorridorViewModel, Mindesteinmessung); die Knöpfe "Mindestlautstärke einmessen" unter Senden und auf der Seite Sprachaktivierung öffnen es.
    -->
    <Grid x:Name="EinmessPopup" DataContext="{Binding Audio}" Background="#73000000"
          Visibility="{Binding Korridor.PopupOffen, Converter={StaticResource SichtbarWenn}}">
        <Border Background="{StaticResource Pinsel.Flaeche}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="1" CornerRadius="6"
                Padding="28,22,28,12" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Abschnitt}" Text="Mindestlautstärke einmessen" />
                <TextBlock x:Name="EinmessTitel" Text="{Binding Korridor.PopupTitel}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock x:Name="EinmessZahl" Text="{Binding Korridor.PopupZahl}" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Visibility="{Binding Korridor.PopupZahl, Converter={StaticResource SichtbarWennWert}}" AutomationProperties.Name="Sekunden" />
                <se:Pegelbalken x:Name="EinmessPegel" Height="18" Margin="0,10,0,0" PegelDb="{Binding PegelDbfs}" Stumm="{Binding Stumm}"
                                AutomationProperties.Name="Pegel beim Einmessen" />
                <TextBlock x:Name="EinmessUnten" Style="{StaticResource Text.Hinweis}" Text="{Binding Korridor.PopupUnten}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <!-- Abstand rechts und unten: Platz für den Schatten der Glasknöpfe -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,8,12">
                    <Button x:Name="EinmessNochEinmal" Content="Noch einmal" Command="{Binding Korridor.NochEinmalCommand}" Margin="0,0,10,0"
                            gd:Hilfe.Text="Beginnt das Einmessen von vorn: erst wie am Funk, dann leise." />
                    <Button x:Name="EinmessSchliessen" Content="{Binding Korridor.PopupSchliessenText}" Command="{Binding Korridor.PopupSchliessenCommand}"
                            gd:Hilfe.Text="Bricht das Einmessen ab oder schließt das Fenster; ein fertiges Ergebnis bleibt." />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Sarevoc 08.10.2026: Beenden mit offener Admin-Sitzung braucht einen Klick mehr; gebaut wie das Popup des Einmessens. -->
    <Grid x:Name="BeendenFrage" Background="#73000000" Visibility="{Binding BeendenFrageOffen, Converter={StaticResource SichtbarWenn}}">
        <Border Background="{StaticResource Pinsel.Flaeche}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="1" CornerRadius="6"
                Padding="28,22,28,12" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{x:Static m:HauptViewModel.BeendenFrageText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Hinweis}" Text="{x:Static m:HauptViewModel.BeendenFrageHinweis}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,8,12">
                    <Button x:Name="BeendenAbbrechenKnopf" Content="Abbrechen" Command="{Binding BeendenAbbrechenCommand}" Margin="0,0,10,0"
                            gd:Hilfe.Text="Das Programm läuft weiter, die Admin-Sitzung bleibt offen." />
                    <Button x:Name="BeendenKnopf" Content="Beenden" Command="{Binding BeendenBestaetigenCommand}"
                            gd:Hilfe.Text="Beendet das Programm und damit auch die Admin-Sitzung." />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
