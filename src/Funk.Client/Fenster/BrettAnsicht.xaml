<!-- JG TacRelay - Maintainer: Sarevoc -->
<!--
  Die Raid-Seite der Einsatzleitung (Bereich Raid, Strg+5). DataContext: BrettViewModel. Seit 0.11.2 (Sarevoc 13.10.2026, ZUORDNUNG-ENTWURF
  "Stammbaum nach rechts"): oben LIVE mit Rückgängig und Abend beenden, links alle Namen (live oben, offline darunter), rechts eine Zeile
  Reiter (seit 0.11.3: ganz links die Rollenwahl wie im Funkfeld, daneben die ersten fünf Kanäle der Rolle) und darunter der Stammbaum des
  offenen Kanals: Kanal, rechts daneben seine Ch., ganz rechts die Leute, mit Linien in der Farbe des Kanals.
  Gezogen wird mit gong-wpf-dragdrop: Namen von links auf einen Ch., Personen im Baum auf einen anderen Ch. oder zurück nach links.
  Alles hängt an Sammlungen, die das Modell nur abgleicht; ein Push baut hier nichts neu (CODEMAP, Fallen).
-->
<UserControl x:Class="Funk.Client.Fenster.BrettAnsicht"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Funk.Client.Modelle"
             xmlns:f="clr-namespace:Funk.Client.Fenster"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:se="clr-namespace:Funk.Client.Steuerelemente"
             xmlns:gd="clr-namespace:Glasdesign;assembly=Glasdesign"
             Focusable="False" gd:Glas.Schatten="Einfach">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding RueckgaengigCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Kleines Schloss: Admin, teilt sich selbst ein -->
        <Geometry x:Key="Brett.Schloss">M 6,11 L 6,8 A 4,4 0 0 1 14,8 L 14,11 M 4,11 L 16,11 L 16,19 L 4,19 Z</Geometry>

        <!-- Rand eines Ablageziels: grün passt, gelb Tausch, rot geht nicht; die Farbe steht nie allein, der Satz steht daneben. -->
        <Style x:Key="Brett.Ziel" TargetType="Border">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ablagezustand}" Value="Passt">
                    <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Senden}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ablagezustand}" Value="Tausch">
                    <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Hoeren}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ablagezustand}" Value="GehtNicht">
                    <Setter Property="BorderBrush" Value="{StaticResource Pinsel.RotSchrift}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Satz zur gehaltenen Karte am Ziel ("passt: Schiff 3 - Pilot", "voll 1/1") -->
        <Style x:Key="Brett.AblageText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Text" Value="{Binding AblageText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AblageText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Brett.Gruppentitel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>

        <!-- Eine Person als Knopf: Klick oder Enter wählt, Rechtsklick oder Umschalt+F10 öffnet das Menü. -->
        <Style x:Key="Brett.Karte" TargetType="Button" BasedOn="{StaticResource Knopf.Flach}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource Pinsel.FlaecheTief}" />
            <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Linie}" />
        </Style>

        <!-- Kleiner Glasknopf; der Glaskörper rundet nach seiner Höhe, die Breite kommt aus dem Padding. -->
        <Style x:Key="Brett.Klein" TargetType="Button" BasedOn="{StaticResource Knopf}">
            <Setter Property="Padding" Value="12,0,12,1" />
            <!-- Knopf.Flach (seit 0.11.2) setzt MinHeight 32; ohne diese Zeile bliebe der kleine Knopf 32 hoch statt 28. -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- Das Abzeichen vor dem Namen (A49; seit 0.11.7 nur das eine vorn, alle sichtbaren im Tooltip und im Hilfetext der Karte), 14 Einheiten -->
        <DataTemplate x:Key="Brett.Zeichen" DataType="{x:Type m:BrettKarte}">
            <Image Source="{Binding Abzeichen}" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{Binding AbzeichenTitel}"
                   AutomationProperties.Name="{Binding AbzeichenTitel}" Visibility="{Binding HatAbzeichen, Converter={StaticResource SichtbarWenn}}" />
        </DataTemplate>

        <!-- Karte einer Person: Online-Punkt, Zeichen, Name, Rolle oder "zuletzt", Marke, Schloss -->
        <DataTemplate DataType="{x:Type m:BrettKarte}">
            <Button x:Name="Knopf" Style="{StaticResource Brett.Karte}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.WaehlenCommand, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}"
                    gd:Hilfe.Text="{Binding Beschreibung}" AutomationProperties.Name="{Binding Beschreibung}" ContextMenuOpening="Karte_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- online voll, offline nur Ring; der Satz im Tooltip sagt es auch -->
                    <Ellipse x:Name="Punkt" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource Pinsel.Senden}"
                             Stroke="{StaticResource Pinsel.Senden}" StrokeThickness="1.4" />
                    <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Brett.Zeichen}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock x:Name="Unterzeile" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="{Binding Rolle}" Visibility="{Binding Rolle, Converter={StaticResource SichtbarWennWert}}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource Pinsel.Text2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="{Binding Zuletzt}" Visibility="{Binding Zuletzt, Converter={StaticResource SichtbarWennWert}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Path x:Name="Sprecher" Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Sprecher}" Width="13" Height="13" Margin="0,0,5,0"
                              Stroke="{StaticResource Pinsel.Senden}" Visibility="Collapsed" ToolTip="spricht gerade" />
                        <TextBlock x:Name="WartetText" Text="wartet" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Margin="0,0,5,0" Visibility="Collapsed" />
                        <TextBlock Text="{Binding Marke}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Margin="0,0,5,0"
                                   Visibility="{Binding Marke, Converter={StaticResource SichtbarWennWert}}" />
                        <Path x:Name="Schloss" Data="{StaticResource Brett.Schloss}" Width="12" Height="12" Stretch="Uniform" Margin="5,0,0,0"
                              Stroke="{StaticResource Pinsel.Text2}" StrokeThickness="1.6" Visibility="Collapsed" ToolTip="Admin, teilt sich selbst ein" />
                        <!-- 6.15: Ein Admin, der heute als Funker spielt, hat kein Schloss; einteilen wie jeden. -->
                        <TextBlock x:Name="FunkerMarke" Text="als Funker" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Margin="5,0,0,0" Visibility="Collapsed"
                                   ToolTip="Admin, heute als Funker: einteilbar wie jeder" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Online}" Value="False">
                    <Setter TargetName="Punkt" Property="Fill" Value="Transparent" />
                    <Setter TargetName="Punkt" Property="Stroke" Value="{StaticResource Pinsel.Text2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Spricht}" Value="True">
                    <Setter TargetName="Sprecher" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Geschuetzt}" Value="True">
                    <Setter TargetName="Schloss" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AlsFunker}" Value="True">
                    <Setter TargetName="FunkerMarke" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Gewaehlt}" Value="True">
                    <Setter TargetName="Knopf" Property="BorderBrush" Value="{StaticResource Pinsel.Akzent}" />
                    <Setter TargetName="Knopf" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Wartet}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.6" />
                    <Setter TargetName="WartetText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Treffer}" Value="False">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          0.11.0 (Q98): eine Person in den Listen links als Personenkachel (Stile.xaml), zwei je Reihe. Klick wählt wie die Karte, Rechtsklick
          öffnet dasselbe Menü; Rolle, Platz, Marke und Admin stehen im Hilfetext. Gedimmt, während sie gezogen wird.
        -->
        <DataTemplate x:Key="Brett.Personenkachel" DataType="{x:Type m:BrettKarte}">
            <Button x:Name="Knopf" Style="{StaticResource Personenkachel.Knopf}" Margin="0,0,4,4" Content="{Binding}" ContentTemplate="{StaticResource Personenkachel.Inhalt}"
                    CommandParameter="{Binding}" Command="{Binding DataContext.WaehlenCommand, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}"
                    gd:Hilfe.Text="{Binding Beschreibung}" AutomationProperties.Name="{Binding Beschreibung}" ContextMenuOpening="Karte_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Gewaehlt}" Value="True">
                    <Setter TargetName="Knopf" Property="BorderBrush" Value="{StaticResource Pinsel.Akzent}" />
                    <Setter TargetName="Knopf" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Wartet}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Treffer}" Value="False">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Gezogen}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          Das Ziehbild an der Maus (dd:DragDrop.DragAdornerTemplate): dieselbe Kachel ohne Knopf, mit Akzentrand. Eine eigene Vorlage statt des
          Standardbilds von gong, denn das fotografiert die Kachel erst, wenn sie schon gedimmt ist.
        -->
        <DataTemplate x:Key="Brett.Personenkachel.Geist" DataType="{x:Type m:BrettKarte}">
            <Border Width="97" Height="30" Padding="4,0,7,0" CornerRadius="4" BorderThickness="1" Opacity="0.85" Background="{StaticResource Pinsel.Flaeche}"
                    BorderBrush="{StaticResource Pinsel.Akzent}" TextElement.Foreground="{StaticResource Pinsel.Text}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Personenkachel.Inhalt}" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- Die Listen links: Kacheln im Raster, rechts um eine Lücke über den Rand, damit die letzte Kachel keine braucht. -->
        <ItemsPanelTemplate x:Key="Brett.Kachelraster">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Das Kreuz an der Mini-Kachel in der Kanalliste: nimmt den Zusatzkanal weg (0.11.1). -->
        <Style x:Key="Brett.Kreuz" TargetType="Button" BasedOn="{StaticResource Knopf.Flach}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          Eine Person in einem Kanal der Kanalliste (0.11.1): Mini-Kachel mit Name (und Ch.); Kreuz und Ziehen nur an einem Zusatzkanal (Q116).
          Gedimmt, während ihre Karte gezogen wird.
        -->
        <DataTemplate x:Key="Brett.Kanalperson" DataType="{x:Type m:KanalPerson}">
            <Border x:Name="Kachel" CornerRadius="3" Padding="6,1,2,1" Margin="0,0,4,3" Background="{StaticResource Pinsel.Flaeche}" BorderBrush="{StaticResource Pinsel.Linie}"
                    BorderThickness="1" ToolTip="{Binding Beschreibung}" AutomationProperties.Name="{Binding Beschreibung}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                    <Button x:Name="Kreuz" Style="{StaticResource Brett.Kreuz}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.KanalPersonEntfernenCommand, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}"
                            Visibility="{Binding Zusatz, Converter={StaticResource SichtbarWenn}}" gd:Hilfe.Text="{Binding KreuzHilfe}" AutomationProperties.Name="{Binding KreuzName}">
                        <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Entfernen}" Width="9" Height="9" Stroke="{StaticResource Pinsel.Text2}" />
                    </Button>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Karte.Gezogen}" Value="True">
                    <Setter TargetName="Kachel" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Das Ziehbild der Mini-Kachel an der Maus -->
        <DataTemplate x:Key="Brett.Kanalperson.Geist" DataType="{x:Type m:KanalPerson}">
            <Border CornerRadius="3" Padding="6,2" BorderThickness="1" Opacity="0.85" Background="{StaticResource Pinsel.Flaeche}" BorderBrush="{StaticResource Pinsel.Akzent}"
                    TextElement.Foreground="{StaticResource Pinsel.Text}">
                <TextBlock Text="{Binding Text}" FontSize="11.5" />
            </Border>
        </DataTemplate>

        <!--
          Freier Platz, gestrichelt. Beim Ziehen zeigt der erste freie Platz des Ziels die Vorschau (0.11.1, Sarevocs Punkt 4): die gezogene Person
          gedämpft (Deckung 0,45) an der Stelle, an der sie landen würde, weich ein- und ausgeblendet (Weichblende, Steuerelemente/Sanft.cs);
          der Satz grün, gelb oder rot steht wie bisher am Block. Nicht trefferfähig, damit sie beim Ziehen kein Ziel wird; ohne Karte
          eingeklappt, damit nach dem Loslassen nichts in der nächsten Lücke nachblendet. Dieselbe Höhe wie der Platz: kein Layout rückt.
          "frei" dahinter geht weg, solange sie steht, sonst schiene es durch die gedämpfte Kachel (Bild 0111-4). In einem Block ohne
          Platzgrenze (Rollen ohne Einheit) hängt das Modell die Zeile nur für die Vorschau ein (BrettViewModel.VorschauZeigen).
        -->
        <DataTemplate DataType="{x:Type m:FreierPlatz}">
            <Grid Height="30" Margin="0,0,0,3" ToolTip="frei: hierher ziehen">
                <Rectangle Stroke="{StaticResource Pinsel.Grenze}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="4" RadiusY="4" />
                <TextBlock Text="frei" FontSize="12" Foreground="{StaticResource Pinsel.Text2}" Margin="10,0" VerticalAlignment="Center"
                           Visibility="{Binding VorschauSichtbar, Converter={StaticResource SichtbarWennNicht}}" />
                <se:Weichblende x:Name="Vorschau" Sichtbar="{Binding VorschauSichtbar}" Visibility="{Binding Vorschau, Converter={StaticResource SichtbarWennWert}}">
                    <Border CornerRadius="4" Padding="6,0" Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Linie}" BorderThickness="1">
                        <DockPanel VerticalAlignment="Center">
                            <Ellipse x:Name="VorschauPunkt" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{StaticResource Pinsel.Senden}" Stroke="{StaticResource Pinsel.Senden}" StrokeThickness="1.4" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Vorschau.Rolle}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding Vorschau.Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                    </Border>
                </se:Weichblende>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Vorschau.Online}" Value="False">
                    <Setter TargetName="VorschauPunkt" Property="Fill" Value="Transparent" />
                    <Setter TargetName="VorschauPunkt" Property="Stroke" Value="{StaticResource Pinsel.Text2}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          Rolle auf einer Einheit: Kopf, Satz beim Ziehen, Karten und freie Plätze; die Liste ist Quelle und Ziel zugleich.
          DropEventType Bubbled (0.11.1, Sarevocs Befund "landet auf Standard"): gong hängt sich bei allem, was kein ItemsControl ist, sonst an die
          Preview-Ereignisse von WPF, die von der Wurzel nach innen tunneln. Dann fing die Spalte der Einheit (das äußerste Ziel) jede
          Ablage auf einen Block in ihr ab und setzte ihren "besten Platz" statt des Blocks; bei Rollen ohne Einheit mit einer Spalte "Rollen ohne
          Einheit" war das immer die erste Rolle. Aufsteigend (Bubbled) gewinnt das innerste Ziel unter der Maus (OberflaecheZuordnungZiehenTests).
        -->
        <DataTemplate DataType="{x:Type m:RollenBlock}">
            <Border Style="{StaticResource Brett.Ziel}" CornerRadius="4" Padding="4,3" Margin="0,6,0,0" Background="{StaticResource Pinsel.Flaeche}"
                    dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.DropEventType="Bubbled" AutomationProperties.Name="{Binding Titel}">
                <StackPanel>
                    <DockPanel Margin="2,0,2,3">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Belegung}" FontSize="12" Foreground="{StaticResource Pinsel.Text2}" />
                        <TextBlock Text="{Binding Titel}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Brett.AblageText}" Margin="2,0,2,3" />
                    <ItemsControl ItemsSource="{Binding Eintraege}" Focusable="False"
                                  dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.UseDefaultEffectDataTemplate="True"
                                  dd:DragDrop.DragHandler="{Binding DataContext.Ziehen, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
          Eine Einheit: Kopf mit Belegung, Ampel und Netzen, darunter die Rollenblöcke; die ganze Spalte nimmt Karten an, aber nur dort,
          wo kein Block liegt (DropEventType Bubbled, siehe den Block).
        -->
        <DataTemplate DataType="{x:Type m:EinheitSpalte}">
            <Border Style="{StaticResource Brett.Ziel}" Width="240" Margin="0,0,10,0" Padding="8" CornerRadius="6" VerticalAlignment="Top"
                    Background="{StaticResource Pinsel.Flaeche}" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.DropEventType="Bubbled"
                    AutomationProperties.Name="{Binding Name}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Belegung}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Path DockPanel.Dock="Left" Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Schiff}" Width="15" Height="15" Margin="0,0,7,0"
                              Stroke="{StaticResource Pinsel.Text2}" />
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Typ}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Margin="22,0,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Typ, Converter={StaticResource SichtbarWennWert}}" />
                    <DockPanel x:Name="Ampelzeile" Margin="0,5,0,0" Visibility="{Binding AmpelText, Converter={StaticResource SichtbarWennWert}}">
                        <Ellipse x:Name="Lampe" DockPanel.Dock="Left" Width="10" Height="10" Margin="2,0,8,0" VerticalAlignment="Center" Fill="{StaticResource Pinsel.Senden}" />
                        <TextBlock Text="{Binding AmpelText}" FontSize="12" TextWrapping="Wrap" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Netze}" Focusable="False" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:EinheitNetz}">
                                <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,3" Background="{StaticResource Pinsel.FlaecheTief}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Punkt" Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center" Stroke="{StaticResource Pinsel.Text2}" StrokeThickness="1" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Spricht}" Value="True">
                                        <Setter TargetName="Punkt" Property="Fill" Value="{StaticResource Pinsel.Senden}" />
                                        <Setter TargetName="Punkt" Property="Stroke" Value="{StaticResource Pinsel.Senden}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Brett.AblageText}" />
                    <ItemsControl ItemsSource="{Binding Bloecke}" Focusable="False" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Ampel}" Value="Gelb">
                    <Setter TargetName="Lampe" Property="Fill" Value="{StaticResource Pinsel.Hoeren}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ampel}" Value="Rot">
                    <Setter TargetName="Lampe" Property="Fill" Value="{StaticResource Pinsel.RotSchrift}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ampel}" Value="Keine">
                    <Setter TargetName="Ampelzeile" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Spaltengruppe: Schiffe, Infanterie, Orga, Rollen ohne Einheit -->
        <DataTemplate DataType="{x:Type m:EinheitGruppe}">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Style="{StaticResource Brett.Gruppentitel}" Text="{Binding Titel}" />
                <ItemsControl ItemsSource="{Binding Spalten}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Ablage in einem Sondernetz: "hört" oder "hört + sendet" -->
        <DataTemplate DataType="{x:Type m:NetzAblage}">
            <Border Style="{StaticResource Brett.Ziel}" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" Background="{StaticResource Pinsel.FlaecheTief}"
                    dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.DropEventType="Bubbled" ToolTip="Hierher ziehen: Zusatzkanal, der Platz bleibt">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Pinsel.Text2}" />
                    <TextBlock Style="{StaticResource Brett.AblageText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="Brett.NurMitEintraegen" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          0.11.2: ein Name links als Name-Button über die ganze Breite, nichts gekürzt; gedimmt beim Ziehen und ohne Treffer der Suche. Rechts im
          Button die Zahl der Kanäle, in denen die Person sitzt (Sarevoc: "links die Übersicht behalten ... 1 heißt in einem Kanal"); ohne Kanal keine Zahl.
        -->
        <DataTemplate x:Key="Brett.Name" DataType="{x:Type m:BrettKarte}">
            <Grid Margin="0,0,0,3">
                <Button x:Name="Knopf" Style="{StaticResource Personenkachel.Knopf}" Width="Auto" HorizontalAlignment="Stretch" Content="{Binding}"
                        ContentTemplate="{StaticResource Personenkachel.Inhalt}" gd:Hilfe.Text="{Binding Beschreibung}" AutomationProperties.Name="{Binding Beschreibung}" />
                <TextBlock x:Name="Zahl" Text="{Binding KanalzahlText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Pinsel.Text2}" IsHitTestVisible="False" ToolTip="{Binding KanalzahlHilfe}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Wartet}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Treffer}" Value="False">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Gezogen}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Das Ziehbild an der Maus (0.11.2): der Name-Button, 200 breit, damit auch ein Name mit 22 Zeichen ganz steht. -->
        <DataTemplate x:Key="Brett.Name.Geist" DataType="{x:Type m:BrettKarte}">
            <Border Width="200" Height="30" Padding="4,0,7,0" CornerRadius="4" BorderThickness="1" Opacity="0.85" Background="{StaticResource Pinsel.Flaeche}"
                    BorderBrush="{StaticResource Pinsel.Akzent}" TextElement.Foreground="{StaticResource Pinsel.Text}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Personenkachel.Inhalt}" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Brett.Person.Geist" DataType="{x:Type m:KanalPerson}">
            <Border Width="200" Height="30" Padding="4,0,7,0" CornerRadius="4" BorderThickness="1" Opacity="0.85" Background="{StaticResource Pinsel.Flaeche}"
                    BorderBrush="{StaticResource Pinsel.Akzent}" TextElement.Foreground="{StaticResource Pinsel.Text}">
                <ContentPresenter Content="{Binding Karte}" ContentTemplate="{StaticResource Personenkachel.Inhalt}" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!--
          Ein Kanal-Reiter (seit 0.11.3, Sarevoc: "der erste Reiter ist wie im Funkfeld, der hat das Dropdown-Menü, das die Reiter daneben bestimmt"):
          ein Trapez mit runden Ecken (se:Reiterform), das den Nachbarn sichtbar überlappt wie ein echtes Register, rechts neben der Rollenwahl. Der offene ist dunkel wie die Fläche darunter, fett, mit dem glühenden Strich in Petrol oben.
          Klick öffnet; ein Name, beim Ziehen darüber, öffnet ihn (ein Kanal ohne Ch. nimmt ihn beim Loslassen auch auf; grüner Strich: passt).
        -->
        <DataTemplate x:Key="Brett.Reiter" DataType="{x:Type m:BaumKanal}">
            <Button x:Name="Knopf" Height="30" MinHeight="0" Margin="0,0,-14,1" VerticalAlignment="Bottom" Cursor="Hand" Background="{StaticResource Pinsel.FlaecheHover}" BorderBrush="Transparent"
                    Command="{Binding DataContext.ReiterWaehlenCommand, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}" CommandParameter="{Binding}"
                    dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.DropEventType="Bubbled"
                    gd:Hilfe.Text="{Binding Name, StringFormat='{}{0}: zeigt darunter den Stammbaum dieses Kanals. Einen Namen darauf ziehen öffnet ihn.'}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Reiter {0}'}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Spalte Auto: Das Trapez misst ohne Breitenvorgabe, so bestimmt die Schrift die Breite. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <se:Reiterform Fuellung="{TemplateBinding Background}" Rand="{StaticResource Pinsel.Linie}" />
                            <!-- Der Strich des offenen Reiters mit Glühen (Sarevoc 13.10.2026: "rein mit Glow"): seit 19.10.2026 im Akzent Petrol mit Glühen in Petrol hell (die dunkle Leitfarbe verschwand dort). -->
                            <Border Height="3" VerticalAlignment="Top" Margin="22,0,22,0" CornerRadius="1.5" Background="{TemplateBinding BorderBrush}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.75" Color="{StaticResource Farbe.Glut}" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter Margin="22,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="Text" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Pinsel.Text2}" />
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Aktiv}" Value="True">
                    <Setter TargetName="Knopf" Property="Height" Value="34" />
                    <Setter TargetName="Knopf" Property="Margin" Value="0,0,-14,0" />
                    <Setter TargetName="Knopf" Property="Background" Value="{StaticResource Pinsel.FlaecheTief}" />
                    <Setter TargetName="Knopf" Property="BorderBrush" Value="{StaticResource Pinsel.Akzent}" />
                    <Setter TargetName="Text" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Pinsel.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ablagezustand}" Value="Passt">
                    <Setter TargetName="Knopf" Property="BorderBrush" Value="{StaticResource Pinsel.Senden}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          Die Rollenwahl, der erste Reiter ganz links (seit 0.11.3, Sarevoc: das erste Register ist das Haupt-Dropdown wie am Funkfeld, es beginnt
          mit der ersten Rolle der Liste): ein Trapez mit der gewählten Rolle und einem Pfeil; Klick klappt die Rollen auf. Die Wahl
          bestimmt die Kanal-Reiter daneben.
        -->
        <Style x:Key="Brett.Rollenwahl" TargetType="se:Klappwahl">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,-14,0" />
            <Setter Property="ListenBreite" Value="240" />
            <Setter Property="Background" Value="{StaticResource Pinsel.Flaeche}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Fokus.Rahmen}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="se:Klappwahl">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <se:Reiterform x:Name="Flaeche" Fuellung="{TemplateBinding Background}" Rand="{StaticResource Pinsel.Linie}" />
                            <Border Height="3" VerticalAlignment="Top" Margin="22,0,22,0" CornerRadius="1.5" Background="{StaticResource Pinsel.Akzent}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.75" Color="{StaticResource Farbe.Glut}" />
                                </Border.Effect>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="22,0,22,0" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                                <Path Style="{StaticResource Symbol}" Data="M 0,0 L 4,4 L 8,0" Width="9" Height="5" StrokeThickness="1.6" Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
                                <Border Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Grenze}" BorderThickness="1" CornerRadius="3"
                                        Padding="2" MinWidth="{TemplateBinding ListenBreite}" MaxHeight="420">
                                    <ListBox x:Name="PART_Liste" ItemsSource="{TemplateBinding Eintraege}" ItemTemplate="{TemplateBinding EintragVorlage}"
                                             ItemContainerStyle="{StaticResource Klappliste.Ausrufe.Eintrag}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource Pinsel.Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Flaeche" Property="Fuellung" Value="{StaticResource Pinsel.FlaecheHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Flaeche" Property="Fuellung" Value="{StaticResource Pinsel.FlaecheHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="Brett.Rolleneintrag" DataType="{x:Type m:BaumRolle}">
            <TextBlock Text="{Binding Name}" FontSize="12.5" Padding="2,1" />
        </DataTemplate>

        <!--
          Eine Person im Stammbaum (0.11.2): der Name-Button, 200 breit; die Linie zu ihr zeichnet der Ch. (Stammbaumlinien). Ziehen setzt um oder,
          nach links, nimmt heraus.
        -->
        <DataTemplate x:Key="Brett.Baumperson" DataType="{x:Type m:KanalPerson}">
            <Grid Height="33">
                <Button x:Name="Knopf" Style="{StaticResource Personenkachel.Knopf}" Width="200" Content="{Binding Karte}"
                        ContentTemplate="{StaticResource Personenkachel.Inhalt}" gd:Hilfe.Text="{Binding Beschreibung}" AutomationProperties.Name="{Binding Beschreibung}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Karte.Wartet}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Karte.Gezogen}" Value="True">
                    <Setter TargetName="Knopf" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          Ein Ch. im Stammbaum (0.11.2): die ganze Zeile ist Ablageziel. Der Knoten (Rahmen in der Kanalfarbe, wenn besetzt), rechts daneben die
          geschwungenen Linien (Stammbaumlinien, Sarevoc: "geschwungen, nicht so eckig") zu den Leuten.
        -->
        <DataTemplate x:Key="Brett.BaumCh" DataType="{x:Type m:BaumCh}">
            <Grid MinHeight="32" Background="Transparent" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.DropEventType="Bubbled">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Knoten" Height="26" VerticalAlignment="Top" Margin="0,3.5,0,0" CornerRadius="5" BorderThickness="1"
                        BorderBrush="{StaticResource Pinsel.Linie}" Background="{StaticResource Pinsel.Flaeche}" gd:Hilfe.Text="{Binding Hilfe}" AutomationProperties.Name="{Binding Hilfe}">
                    <Grid>
                        <Border Style="{StaticResource Brett.Ziel}" CornerRadius="5" Margin="-1" IsHitTestVisible="False" />
                        <TextBlock x:Name="ChName" Text="{Binding Name}" FontSize="12.5" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <!-- "weitere Ch." (Sarevoc 13.10.2026): Klick zeigt oder verbirgt die leeren Ch.; beim Ziehen klappen sie nach kurzem Verweilen von selbst auf. -->
                        <Button x:Name="WeitereKnopf" Style="{StaticResource Knopf.Flach}" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8,0"
                                MinHeight="0" HorizontalContentAlignment="Left" Foreground="{StaticResource Pinsel.Text2}" FontSize="12"
                                Command="{Binding DataContext.WeitereUmschaltenCommand, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}"
                                CommandParameter="{Binding}" Content="{Binding Name}" gd:Hilfe.Text="{Binding Hilfe}" AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                </Border>
                <se:Stammbaumlinien Grid.Column="1" KnotenMitte="16.5" Liste="{Binding ElementName=Leute}" Farbe="{StaticResource Pinsel.Text}" IsHitTestVisible="False"
                                    Visibility="{Binding Besetzt, Converter={StaticResource SichtbarWenn}}" />
                <ItemsControl x:Name="Leute" Grid.Column="2" ItemsSource="{Binding Leute}" Focusable="False" ItemTemplate="{StaticResource Brett.Baumperson}"
                              dd:DragDrop.IsDragSource="True" dd:DragDrop.DragHandler="{Binding DataContext.Ziehen, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}"
                              dd:DragDrop.DragAdornerTemplate="{StaticResource Brett.Person.Geist}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Besetzt}" Value="True">
                    <Setter TargetName="Knoten" Property="BorderBrush" Value="{StaticResource Pinsel.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IstRuhe}" Value="True">
                    <Setter TargetName="ChName" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IstWeitere}" Value="True">
                    <Setter TargetName="ChName" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="WeitereKnopf" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Knoten" Property="Background" Value="Transparent" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          Ein Kanal im Stammbaum (0.11.2): links der Knoten, oben auf der Höhe seines ersten Ch. (Sarevoc: "nur nach rechts und unten wachsen"), rechts
          daneben die Linien zu den Ch. (oder zu den Leuten bei einem Kanal ohne Ch.). Seit 0.11.3 steht er allein unter den Reitern und ist
          immer aufgeklappt, ohne Pfeil.
        -->
        <DataTemplate x:Key="Brett.BaumKanal" DataType="{x:Type m:BaumKanal}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Knoten" Height="28" VerticalAlignment="Top" Margin="0,2.5,0,0" CornerRadius="5" BorderThickness="1.6" BorderBrush="{Binding Farbe}" Background="{StaticResource Pinsel.Flaeche}"
                        dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" dd:DragDrop.DropEventType="Bubbled" gd:Hilfe.Text="{Binding Hilfe}">
                    <Grid>
                        <Border Style="{StaticResource Brett.Ziel}" CornerRadius="5" Margin="-1.6" IsHitTestVisible="False" />
                        <DockPanel>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
                <se:Stammbaumlinien x:Name="ChLinien" Grid.Column="1" KnotenMitte="16.5" Liste="{Binding ElementName=ChListe}" Farbe="{Binding Farbe}" IsHitTestVisible="False" Visibility="Collapsed" />
                <se:Stammbaumlinien x:Name="LeuteLinien" Grid.Column="1" KnotenMitte="16.5" Liste="{Binding ElementName=Leuteliste}" Farbe="{StaticResource Pinsel.Text}" IsHitTestVisible="False" Visibility="Collapsed" />
                <ItemsControl x:Name="ChListe" Grid.Column="2" ItemsSource="{Binding Ch}" Focusable="False" ItemTemplate="{StaticResource Brett.BaumCh}" Visibility="Collapsed" />
                <ItemsControl x:Name="Leuteliste" Grid.Column="2" ItemsSource="{Binding Leute}" Focusable="False" ItemTemplate="{StaticResource Brett.Baumperson}" Visibility="Collapsed"
                              dd:DragDrop.IsDragSource="True" dd:DragDrop.DragHandler="{Binding DataContext.Ziehen, RelativeSource={RelativeSource AncestorType={x:Type f:BrettAnsicht}}}"
                              dd:DragDrop.DragAdornerTemplate="{StaticResource Brett.Person.Geist}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Offen}" Value="True">
                    <Setter TargetName="ChLinien" Property="Visibility" Value="Visible" />
                    <Setter TargetName="LeuteLinien" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ChListe" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Leuteliste" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      Seit 0.12.0: oben das Brett (nur mit der Einsatzleitung, Sichtbar), darunter das Feld "Meldungen" (nur wer senden darf, Meldungen.Sichtbar). Die
      Führung ohne Auftrag sieht die Seite nur mit dem Feld; dann fällt die Zeile des Bretts weg, und das Feld steht oben. Das Feld rollt selbst, wenn
      die Höhe nicht reicht, damit das Brett darüber nicht verschwindet.
    -->
    <Grid x:Name="Seitenraster">
        <Grid.RowDefinitions>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Setter Property="MinHeight" Value="220" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Sichtbar}" Value="False">
                                <Setter Property="Height" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Sichtbar}" Value="False">
                                <Setter Property="Height" Value="*" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

    <!-- LIVE: Der Rahmen im Akzent sagt, dass jede Ablage sofort wirkt. -->
    <Border x:Name="LiveRahmen" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="2" Background="{StaticResource Pinsel.Anthrazit}"
            Visibility="{Binding Sichtbar, Converter={StaticResource SichtbarWenn}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Kopf (0.11.2): LIVE und wer leitet, rechts Rückgängig und Abend beenden; sonst nichts. -->
            <Border Background="{StaticResource Pinsel.FlaecheTief}" Padding="10,6">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Umschalter}" IsChecked="{Binding AbendOffen}" Padding="8,2" MinHeight="26" FontSize="12" Margin="6,0,0,0"
                                  gd:Hilfe.Text="Klappt das Beenden des Abends auf: alle auf Standard, Auftrag abgeben.">
                        <AccessText Text="Abend b_eenden ..." />
                    </ToggleButton>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Brett.Klein}" Margin="10,0,0,0" Command="{Binding RueckgaengigCommand}"
                            gd:Hilfe.Text="Nimmt deine letzte Umstellung zurück." gd:Hilfe.Taste="Strg+Z">
                        <AccessText Text="_Rückgängig" />
                    </Button>
                    <Border DockPanel.Dock="Left" Background="{StaticResource Pinsel.Leitfarbe}" CornerRadius="3" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE - wirkt sofort" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Pinsel.Text}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding AuftragText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AuftragWarnung}" Foreground="{StaticResource Pinsel.Hoeren}" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding AuftragWarnung, Converter={StaticResource SichtbarWennWert}}" />
                </DockPanel>
            </Border>

            <!-- Abend beenden: was passiert, mit Häkchen -->
            <Border Grid.Row="1" Style="{StaticResource Warnung.Unterlage}" Margin="10,6,10,2" Padding="12,8" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="1"
                    Visibility="{Binding AbendOffen, Converter={StaticResource SichtbarWenn}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Knopf.Haupt}" Command="{Binding AbendBeendenCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                            gd:Hilfe.Text="Beendet den Abend jetzt. Je nach Häkchen gehen die Eingeteilten auf Standard und der Auftrag wird abgegeben. Wen du in Wer ist da stumm geschaltet hast, ist danach wieder zu hören.">
                        <AccessText Text="_Jetzt beenden" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Abend beenden" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Style="{StaticResource Schalter}" IsChecked="{Binding AbendStandard}" Margin="0,0,18,0"
                                      gd:Hilfe.Text="Setzt beim Beenden alle Eingeteilten, die online sind, zurück auf Standard.">
                                <AccessText Text="E_ingeteilte auf Standard setzen" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource Schalter}" IsChecked="{Binding AbendAbgeben}"
                                      gd:Hilfe.Text="Gibt am Ende auch die Einsatzleitung zurück, falls du sie im Auftrag hast.">
                                <AccessText Text="Auftrag danac_h abgeben" />
                            </CheckBox>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Körper (0.11.2): links alle Namen, rechts Reiter und Stammbaum. -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Links: alle Namen, live oben, offline unter der Linie. Als Ziel: eine Person aus dem Baum hierher nimmt sie aus dem Kanal. -->
                <Grid x:Name="Links" Background="{StaticResource Pinsel.Flaeche}" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding Teilnehmerziel}"
                      dd:DragDrop.DropEventType="Bubbled" AutomationProperties.Name="Teilnehmer">
                    <Border Style="{StaticResource Brett.Ziel}" DataContext="{Binding Teilnehmerziel}" IsHitTestVisible="False" Panel.ZIndex="1" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                            <TextBlock Style="{StaticResource Text.Abschnitt}" Text="Teilnehmer" Margin="0,0,0,6" />
                            <Label Target="{Binding ElementName=Suchfeld}" Padding="0" Margin="0,0,0,2">
                                <AccessText Style="{StaticResource Text.Zugang}" Text="_Suchen (Strg+E)" FontSize="12" />
                            </Label>
                            <TextBox x:Name="Suchfeld" Text="{Binding Suche, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="In der Funkfeld-Zuteilung suchen"
                                     ToolTip="Name, SC-Name und Discord-Name, auch Teile" />
                            <TextBlock Style="{StaticResource Brett.AblageText}" DataContext="{Binding Teilnehmerziel}" Margin="0,6,0,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel Margin="12,4,12,12">
                                <ItemsControl x:Name="NamenLiveListe" ItemsSource="{Binding NamenLive}" Focusable="False" ItemTemplate="{StaticResource Brett.Name}"
                                              dd:DragDrop.IsDragSource="True" dd:DragDrop.DragHandler="{Binding Ziehen}" dd:DragDrop.DragAdornerTemplate="{StaticResource Brett.Name.Geist}" />
                                <Border Height="1" Margin="0,6,0,8" Background="{StaticResource Pinsel.Linie}" Visibility="{Binding Visibility, ElementName=NamenOfflineListe}" />
                                <ItemsControl x:Name="NamenOfflineListe" Style="{StaticResource Brett.NurMitEintraegen}" ItemsSource="{Binding NamenOffline}" Focusable="False"
                                              ItemTemplate="{StaticResource Brett.Name}" dd:DragDrop.IsDragSource="True" dd:DragDrop.DragHandler="{Binding Ziehen}"
                                              dd:DragDrop.DragAdornerTemplate="{StaticResource Brett.Name.Geist}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- Rechts: eine Zeile Reiter wie im Browser (seit 0.11.3: Rollenwahl, daneben die Kanäle der Rolle), darunter der Stammbaum des offenen Kanals. -->
                <DockPanel Grid.Column="1" Margin="12,6,0,0">
                    <Grid DockPanel.Dock="Top" MinHeight="34">
                        <!-- Ohne Kanäle keine Reiter (die Reihe für Gruppen und Fraktionen kommt später) -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Reiter.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Pinsel.Linie}" />
                        <DockPanel Margin="6,0,0,0">
                            <se:Klappwahl x:Name="Rollenwahl" DockPanel.Dock="Left" Style="{StaticResource Brett.Rollenwahl}" Panel.ZIndex="2"
                                          Eintraege="{Binding Rollenwahl}" Gewaehlt="{Binding GewaehlteRolle, Mode=OneWay}" Waehlen="{Binding RolleWaehlenCommand}"
                                          EintragVorlage="{StaticResource Brett.Rolleneintrag}"
                                          Visibility="{Binding GewaehlteRolle, Converter={StaticResource SichtbarWennWert}}"
                                          gd:Hilfe.Text="Rollenwahl wie im Funkfeld: Klick klappt die Rollen auf; rechts daneben stehen dann die ersten fünf Kanäle der Rolle."
                                          AutomationProperties.Name="{Binding GewaehlteRolle.Name, StringFormat='Rolle {0}, Rollenwahl'}">
                                <TextBlock Text="{Binding GewaehlteRolle.Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Pinsel.Text}" />
                            </se:Klappwahl>
                            <ItemsControl x:Name="Reiterleiste" ItemsSource="{Binding Reiter}" Focusable="False" ItemTemplate="{StaticResource Brett.Reiter}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Eine Zeile (höchstens fünf Kanäle); reicht der Platz nicht, bricht sie um, statt abzuschneiden. -->
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Aktiv}" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>
                    <Border Background="{StaticResource Pinsel.FlaecheTief}">
                        <ScrollViewer x:Name="Baumlauf" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="Stammbaum" ItemsSource="{Binding Baum}" Focusable="False" Margin="12,14,12,12" ItemTemplate="{StaticResource Brett.BaumKanal}" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- Unten: nur die Meldung, wenn eine da ist. -->
            <Border Grid.Row="3" Background="{StaticResource Pinsel.FlaecheTief}" Padding="12,6" BorderBrush="{StaticResource Pinsel.Linie}" BorderThickness="0,1,0,0"
                    Visibility="{Binding Meldung, Converter={StaticResource SichtbarWennWert}}">
                <TextBlock Text="{Binding Meldung}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Border>

        <!-- Meldungen (0.12.0): an alle, die online sind; nur wer senden darf -->
        <ScrollViewer x:Name="MeldungenPlatz" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      DataContext="{Binding Meldungen}" Visibility="{Binding Sichtbar, FallbackValue=Collapsed, Converter={StaticResource SichtbarWenn}}">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Margin" Value="0" />
                    <Style.Triggers>
                        <!-- Mit dem Brett darüber höchstens 460 hoch und mit Abstand; allein nimmt das Feld die ganze Höhe. -->
                        <DataTrigger Binding="{Binding DataContext.Sichtbar, ElementName=Seitenraster}" Value="True">
                            <Setter Property="MaxHeight" Value="460" />
                            <Setter Property="Margin" Value="0,8,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <f:MeldungenFeld x:Name="Meldungen" />
        </ScrollViewer>
    </Grid>
</UserControl>
