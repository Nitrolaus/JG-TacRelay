<!-- JG TacRelay - Maintainer: Sarevoc -->
<!-- Vorlagen der vier Bereiche des Hauptfensters, je ViewModel eine. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Funk.Client.Modelle"
                    xmlns:se="clr-namespace:Funk.Client.Steuerelemente"
                    xmlns:f="clr-namespace:Funk.Client.Fenster"
                    xmlns:gd="clr-namespace:Glasdesign;assembly=Glasdesign">

    <!-- Für Auswahllisten: der Name des Eintrags (DisplayMemberPath erreicht das Auswahlfeld der eigenen Vorlage nicht). -->
    <DataTemplate x:Key="NameVorlage">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <!--
      Hören auf: Links, Beide, Rechts. Gemeint ist die Seite im Kopfhörer oder im Lautsprecher, auf der ein Kanal spielt; das hilft, Kanäle
      beim Zuhören zu trennen. Ohne Gruppenname bilden die Knöpfe eines Panels ihre eigene Gruppe. Unten 3 Einheiten Luft für den Schatten der
      Glasknöpfe (Glasdesign 0.3.1): Ist eine Zeile schmaler als ihr Inhalt, schneidet sie an ihrem Rand ab (bei 960 Breite, Stufe 2c gemessen).
    -->
    <DataTemplate x:Key="OhrVorlage" DataType="{x:Type m:OhrWahl}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
            <TextBlock x:Name="OhrEtikett" Style="{StaticResource Text.Etikett}" Text="Hören auf:" VerticalAlignment="Center" Margin="0,0,8,3"
                       ToolTip="Auf welcher Seite im Kopfhörer oder Lautsprecher du diesen Kanal hörst: links, beide oder rechts. Das hilft, Kanäle beim Zuhören zu trennen." />
            <RadioButton Style="{StaticResource Umschalter.Radio}" Padding="9,2" MinHeight="26" FontSize="12" Content="Links" IsChecked="{Binding Links}"
                         gd:Hilfe.Text="Diesen Kanal nur links hören: im Kopfhörer auf dem linken Ohr, bei Lautsprechern aus dem linken. Das hilft, Kanäle beim Zuhören zu trennen."
                         AutomationProperties.Name="{Binding Netz, StringFormat='{}{0}: hören auf links'}" />
            <RadioButton Style="{StaticResource Umschalter.Radio}" Padding="9,2" MinHeight="26" FontSize="12" Content="Beide" IsChecked="{Binding Beide}"
                         gd:Hilfe.Text="Diesen Kanal auf beiden Seiten hören: im Kopfhörer auf beiden Ohren, bei Lautsprechern aus beiden."
                         AutomationProperties.Name="{Binding Netz, StringFormat='{}{0}: hören auf beide'}" />
            <RadioButton Style="{StaticResource Umschalter.Radio}" Padding="9,2" MinHeight="26" FontSize="12" Content="Rechts" IsChecked="{Binding Rechts}"
                         gd:Hilfe.Text="Diesen Kanal nur rechts hören: im Kopfhörer auf dem rechten Ohr, bei Lautsprechern aus dem rechten. Das hilft, Kanäle beim Zuhören zu trennen."
                         AutomationProperties.Name="{Binding Netz, StringFormat='{}{0}: hören auf rechts'}" />
        </StackPanel>
    </DataTemplate>

    <!--
      A9: Lautstärke eines Kanals, derselbe Wert wie auf der Kachel im Funkfeld; unten Luft wie bei OhrVorlage. Seit 0.10.0 (E16) unter
      Einstellungen > Empfangen > Erweitert ohne VA/Taste: Womit ein Kanal sendet, stellt man im Funkfeld ein (bis 0.9.3 RegelVorlage unter Meine
      Kanäle mit dem Umschalter VA/Taste).
    -->
    <DataTemplate x:Key="LautstaerkeVorlage" DataType="{x:Type m:NetzRegelung}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,3">
            <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Lautstaerke}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource Pinsel.Text2}" />
            <Slider Width="100" Minimum="-30" Maximum="12" SmallChange="0.5" LargeChange="3" Value="{Binding LautstaerkeDb}" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Netz, StringFormat='Lautstärke {0}'}" gd:Hilfe.Text="{x:Static m:EinstellungenViewModel.KanalLautstaerkeHilfe}" />
            <TextBlock Text="{Binding LautstaerkeText}" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Pinsel.Text2}" />
        </StackPanel>
    </DataTemplate>

    <!-- Nur lesen, aber markier- und kopierbar (Registrierungscode, Anzeigeform zur Freigabe); Rand und Fokus wie jedes Textfeld. -->
    <Style x:Key="Feld.Kopierbar" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Kleiner Knopf in einer Tastenmarke (Entfernen). -->
    <Style x:Key="Knopf.Marke" TargetType="Button" BasedOn="{StaticResource Knopf.Flach}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      Fuß jedes Klappbereichs "Erweitert:" (seit 0.10.0, E6, Bilder m-4 und m-5): "Zurück auf Werkseinstellung" ohne Zugriffstaste (zurückstellen
      soll nicht über eine verrutschte Alt-Taste geschehen), daneben der Satz, was selbst gestellt ist. Rechts 8 Luft für den Glasschatten des Knopfs
      (Prüfberichte Mischung), unten ebenso: Der Fuß steht ganz unten im Klappbereich, und dessen Rand schneidet bei 175 % nach dem Runden auf
      Bildpunkte ab, was darüber hinausragt (gemessen in AP3: sonst fehlten unten zwei Einheiten des Schattens). DataContext: der Behälter
      (Klasse Feinheiten; in der Oberfläche heißt der Bereich seit 0.11.1 Erweitert).
    -->
    <DataTemplate x:Key="FeinheitenFuss" DataType="{x:Type m:Feinheiten}">
        <!-- Schmal (unter EinstellungenViewModel.FussNebeneinanderAb) steht der Satz unter dem Knopf, sonst bräche er bei 640 mitten im Wort. -->
        <se:Spaltenwechsel Margin="0,8,8,8" Ab="{x:Static m:EinstellungenViewModel.FussNebeneinanderAb}" Aufteilung="ErsteFest"
                           ErsteBreite="{x:Static m:EinstellungenViewModel.FussKnopfBreite}" Luecke="0" Zeilenluecke="6">
            <Button x:Name="FeinheitenZurueck" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" Content="Zurück auf Werkseinstellung"
                    Command="{Binding ZurueckCommand}" gd:Hilfe.Text="{Binding ZurueckHilfe}" gd:Hilfe.Gesperrt="Steht schon auf der Werkseinstellung."
                    AutomationProperties.Name="{Binding Abschnitt, StringFormat='Erweitert in {0} zurück auf Werkseinstellung'}" />
            <TextBlock x:Name="FeinheitenStand" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding StandSatz}" />
        </se:Spaltenwechsel>
    </DataTemplate>

    <!--
      Nachlauf der Sprechtaste (Q66, seit 0.9.3): 0 bis 1000 ms in 10-ms-Schritten. Seit 0.10.0 unter Einstellungen > Tasten > Erweitert in der Gruppe
      Sprechtaste (E17; bis AP2 ein eigener Klappbereich unter der Zeile Sprechtaste). Die Beschriftung steht über dem Regler (Prüfung 0.9.3):
      Daneben blieb dem Regler in schmalen Fenstern zu wenig Platz. Bis 600 breit und links. DataContext: NachlaufTeil.
    -->
    <DataTemplate x:Key="NachlaufVorlage" DataType="{x:Type m:NachlaufTeil}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="600" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Target="{Binding ElementName=NachlaufRegler}" Padding="0" HorizontalAlignment="Left">
                    <AccessText Style="{StaticResource Text.Zugang}" Text="Nachlau_f der Sprechtaste" />
                </Label>
                <DockPanel Margin="0,2,0,0">
                    <TextBlock x:Name="NachlaufWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding NachlaufText}" Width="64" TextAlignment="Right" />
                    <Slider x:Name="NachlaufRegler" Minimum="0" Maximum="1000" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True"
                            Value="{Binding Nachlauf}" AutomationProperties.Name="Nachlauf der Sprechtaste in Millisekunden"
                            gd:Hilfe.Text="{x:Static m:NachlaufTeil.NachlaufHilfe}" />
                </DockPanel>
                <TextBlock x:Name="NachlaufErklaerung" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,2,64,0" Text="{x:Static m:NachlaufTeil.NachlaufErklaerung}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Eine belegte Taste als Marke mit Entfernen; unter Einstellungen je Funktion, seit 0.10.0 auch die Sprechtaste auf Start (E17). -->
    <DataTemplate x:Key="TastenMarke" DataType="{x:Type m:BelegungZeile}">
        <Border x:Name="Marke" Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Linie}" BorderThickness="1"
                CornerRadius="12" Padding="10,1,2,1" Margin="0,2,6,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MarkenText" Text="{Binding Beschreibung}" FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource Knopf.Marke}" Command="{Binding LoeschenCommand}" Margin="4,0,0,0"
                        gd:Hilfe.Text="Entfernt diese Taste." AutomationProperties.Name="{Binding Name, StringFormat='{}{0} entfernen'}">
                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Entfernen}" Width="10" Height="10"
                          Stroke="{StaticResource Pinsel.Text2}" />
                </Button>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Verfuegbar}" Value="False">
                <Setter TargetName="MarkenText" Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
      Eine Funktion der globalen Tasten mit ihren Tasten und "Belegen"; für jeden und für die Einsatzleitung (seit 0.10.0 unter Einstellungen > Tasten >
      Erweitert). Links Titel und Erklärung in fester Breite, rechts die Marken und "Belegen"; schmal (unter TastenZeileNebeneinanderAb, etwa bei 640
      Fensterbreite) stehen die Marken darunter, statt neben dem Titel abgeschnitten zu werden.
    -->
    <DataTemplate x:Key="TastenZeileVorlage" DataType="{x:Type m:TastenFunktionZeile}">
        <se:Spaltenwechsel Margin="0,5" Ab="{x:Static m:EinstellungenViewModel.TastenZeileNebeneinanderAb}" Aufteilung="ErsteFest" ErsteBreite="190" Luecke="0"
                           Zeilenluecke="4">
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource Text.Wert}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Titel}" />
                <TextBlock Style="{StaticResource Text.Hinweis}" Text="{Binding Erklaerung}" />
            </StackPanel>
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" MinWidth="104" VerticalAlignment="Center" Margin="6,0,0,0" Command="{Binding BelegenCommand}" Content="{Binding BelegenText}"
                        gd:Hilfe.Text="Wartet auf die nächste Taste, Maustaste oder den Knopf am Joystick und belegt damit diese Funktion. Esc bricht ab."
                        AutomationProperties.Name="{Binding Titel, StringFormat='{}{0} belegen'}" />
                <ItemsControl ItemsSource="{Binding Belegungen}" ItemTemplate="{StaticResource TastenMarke}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </se:Spaltenwechsel>
    </DataTemplate>

    <!--
      Details der Verbindung, nur im Admin-Setup (Q3, Q14): Serverprofil mit Host und Port, Signatur und Herkunft, Server, Konto,
      Stufe, Gerät, die Adresse für das eigene Heimnetz und die letzte Meldung mit ihren Einzelheiten. Funker sehen nichts davon.
      Eine eigene Vorlage, damit sie in Stufe 3 unverändert nach Einstellungen, Erweitert umziehen kann. DataContext: VerbindungViewModel.
    -->
    <DataTemplate x:Key="VerbindungDetailsVorlage" DataType="{x:Type m:VerbindungViewModel}">
        <Border x:Name="DetailsKarte" Style="{StaticResource Karte}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Abschnitt}" Text="Erweitert: Details der Verbindung (nur im Admin-Setup)" Margin="0,0,0,2" />
                <!-- Serverprofil: kommt mit dem Client (3.1, ANMELDUNG-SICHERHEIT P1); hier nur zur Ansicht, eine Eingabe gibt es nicht.
                     Ein neueres, vom Eigentümer signiertes Profil übernimmt der Client nach der Freigabe vom Server (F1); dann steht die Herkunft da. -->
                <StackPanel x:Name="ProfilKarte" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13"
                               Text="Serverprofil und Profilschlüssel kommen mit dem Setup. Ein neueres Profil nimmt der Client nur vom Server, und nur mit der Unterschrift des Eigentümers. Wer dir eine Profildatei oder einen Schlüssel schickt, will dich auf einen falschen Server locken." />
                    <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ProfilZiel}" Visibility="{Binding ProfilZiel, Converter={StaticResource SichtbarWennWert}}" />
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding ProfilSignatur, Converter={StaticResource SichtbarWennWert}}">
                        <Path DockPanel.Dock="Left" Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Haken}" Width="14" Height="14" Margin="0,1,8,0"
                              VerticalAlignment="Top" Stroke="{StaticResource Pinsel.Text2}" />
                        <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Text="{Binding ProfilSignatur}" />
                    </DockPanel>
                    <TextBlock x:Name="ProfilHerkunftZeile" Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="22,2,0,0" Text="{Binding ProfilHerkunft}"
                               Visibility="{Binding ProfilHerkunft, Converter={StaticResource SichtbarWennWert}}" />
                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,8,0,0" Text="{Binding ProfilOffen}"
                               Visibility="{Binding ProfilOffen, Converter={StaticResource SichtbarWennWert}}" />
                    <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding ProfilFehler, Converter={StaticResource SichtbarWennWert}}">
                        <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding ProfilFehler}" />
                    </Border>
                    <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding ProfilWarnung, Converter={StaticResource SichtbarWennWert}}">
                        <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding ProfilWarnung}" />
                    </Border>
                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,6,0,0" Text="{Binding ProfilEinzelheit, StringFormat='Einzelheit zum Profil: {0}'}"
                               Visibility="{Binding ProfilEinzelheit, Converter={StaticResource SichtbarWennWert}}" />
                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,6,0,0" Text="{Binding HinweisEinzelheit, StringFormat='Einzelheit zur letzten Meldung: {0}'}"
                               Visibility="{Binding HinweisEinzelheit, Converter={StaticResource SichtbarWennWert}}" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Text.Etikett}" Text="Server" Margin="0,4,12,4" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Wert}" Text="{Binding Server}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Text.Etikett}" Text="Konto" Margin="0,4,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Wert}" Text="{Binding Konto}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Text.Etikett}" Text="Stufe" Margin="0,4,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Wert}" Text="{Binding Stufe}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Text.Etikett}" Text="Gerät" Margin="0,4,12,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Wert}" Text="{Binding Geraet}" />
                    <Label Grid.Row="4" Target="{Binding ElementName=AdresseFeld}" Padding="0" Margin="0,8,12,4" VerticalAlignment="Center">
                        <AccessText Style="{StaticResource Text.Zugang}" Text="Adresse" />
                    </Label>
                    <TextBox x:Name="AdresseFeld" Grid.Row="4" Grid.Column="1" Margin="0,4"
                             Text="{Binding Adresse, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Adresse"
                             ToolTip="Statt der Hosts aus dem Profil, etwa im eigenen Heimnetzwerk die LAN-Adresse des Servers. Der Pin aus dem Profil gilt trotzdem." />
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Text.Hinweis}"
                                   Text="Leer lassen, dann gelten Host und Port aus dem Profil. Im eigenen Heimnetzwerk geht auch die LAN-Adresse des Servers." />
                        <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,4,0,0" Visibility="{Binding AdresseFehler, Converter={StaticResource SichtbarWennWert}}">
                            <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding AdresseFehler}" />
                        </Border>
                        <!-- Während eines Verbindungsversuchs geändert: gilt erst nach Trennen und Verbinden; weiße Schrift auf der tiefen Fläche -->
                        <Border x:Name="AenderungRand" Background="{StaticResource Pinsel.FlaecheTief}" CornerRadius="4" Padding="10,6" Margin="0,4,0,0"
                                Visibility="{Binding AenderungWartet, Converter={StaticResource SichtbarWennWert}}">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding AenderungWartet}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--
      ============================== Start (0.6.0, Stufe 2; seit 0.10.0 nach der Mischung, Q87 bis Q92) ==============================
      Bilder m-1, m-2 und m-7c (Vorlage StartM.xaml): Logo und Name, Gerät freigegeben oder wartend mit Kennung, Verbinden groß, zwei Stecker mit
      Wort und Online-Zahl; darunter in einer Karte die Grundansicht in zwei Spalten, "Sprechen" (Mikrofon, Sprechtaste, Senden mit Stimme) und
      "Hören" (Ausgabe, Funk-Lautstärke, Headset oder Lautsprecher, die eine Hörprobe). Unter etwa 900 Fensterbreite stehen die Spalten
      untereinander (Q88, Spaltenwechsel). Pegel und SENDET stehen nur unten in der Statuszeile (Q87). Beim allerersten Start statt Verbinden der
      Willkommenssatz, die zwei offenen Angaben umrandet (Q76, E8). Mit Einheiten folgt die Karte Einsteigen (E10). Für Funker kein Server, kein
      Host, kein Port, keine Adresse, kein Gerätename (Q3 bis Q5). Ein Hauptknopf (Leitfarbe) auf der Karte: Verbinden (Q21). Kein Rollbalken in Klein
      (900 x 900, Q89), außer mit Einsteigen.
    -->
    <DataTemplate DataType="{x:Type m:StartViewModel}">
        <!-- Bis 820 breit und links: eine Spalte mit Höchstbreite (ein StackPanel mit MaxWidth stünde sonst in der Mitte) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="820" />
        </Grid.ColumnDefinitions>
        <StackPanel>

            <!-- Anmeldung, Code und Rückfrage: nur solange der Client danach fragt. -->
            <StackPanel DataContext="{Binding Verbindung}">
                <!-- A42: Anmelden mit SC-Name und Discord-Name, "stimmt das?". Kein Passwort, kein Code. Der Gerätename nur als Zeile (Q4). -->
                <Border x:Name="AnmeldungKarte" Style="{StaticResource Karte}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="2"
                        Visibility="{Binding ZeigtAnmeldung, Converter={StaticResource SichtbarWenn}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Abschnitt}" Text="{Binding AnmeldeFrage}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13"
                                   Text="Damit erkennt dich der Admin, bevor er dich freischaltet. Ein Passwort gibt es nicht; dein PC weist sich mit seinem eigenen Schlüssel aus." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Target="{Binding ElementName=ScNameFeld}" Padding="0" Margin="0,4,12,4" VerticalAlignment="Center">
                                <AccessText Style="{StaticResource Text.Zugang}" Text="Dein Name in _Star Citizen" />
                            </Label>
                            <TextBox x:Name="ScNameFeld" Grid.Column="1" Margin="0,4" MaxLength="22" Text="{Binding ScName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Dein Name in Star Citizen" ToolTip="Wie im Spiel, etwa Mustermann, höchstens 22 Zeichen" />
                            <Label Grid.Row="1" Target="{Binding ElementName=DiscordFeld}" Padding="0" Margin="0,4,12,4" VerticalAlignment="Center">
                                <AccessText Style="{StaticResource Text.Zugang}" Text="Dein Name in _Discord" />
                            </Label>
                            <TextBox x:Name="DiscordFeld" Grid.Row="1" Grid.Column="1" Margin="0,4" MaxLength="40" Text="{Binding DiscordName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Dein Name in Discord" ToolTip="Wie er auf deinem Discord-Server steht, etwa Mustermann/Max" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding GeraetenameSatz}" />
                        <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding NamenFehler, Converter={StaticResource SichtbarWennWert}}">
                            <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding NamenFehler}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Knopf.Haupt}" Content="{Binding AnmeldeKnopf}" Command="{Binding SoAnmeldenCommand}" Margin="0,0,8,0"
                                    gd:Hilfe.Text="Merkt deine Namen und stellt damit den Antrag; ein Admin gibt dein Gerät dann frei."
                                    gd:Hilfe.Gesperrt="Trag beide Namen so ein, wie sie im Spiel und in Discord stehen." />
                            <Button Content="Jetzt nicht" Command="{Binding AnmeldungAbbrechenCommand}"
                                    Visibility="{Binding AnmeldungWartet, Converter={StaticResource SichtbarWenn}}"
                                    gd:Hilfe.Text="Stellt jetzt keinen Antrag; Trennen geht jederzeit." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3.4: Code zum Verknüpfen (Weg mit Bot). Der Server schickt nur "/funk verknuepfen"; der Code steht deshalb groß und kopierbar allein. -->
                <Border Style="{StaticResource Karte}" Visibility="{Binding IstRegistrierung, Converter={StaticResource SichtbarWenn}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Abschnitt}" Text="Gerät mit dem Konto verknüpfen" />
                        <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13"
                                   Text="Das ist dein Registrierungscode. In Discord tippst du den Befehl darunter ein. Danach fragt der Client hier, ob das Konto stimmt." />
                        <TextBox Style="{StaticResource Feld.Kopierbar}" FontSize="28" Text="{Binding Code, Mode=OneWay}" Margin="0,10,0,6"
                                 AutomationProperties.Name="Registrierungscode" ToolTip="Markieren und mit Strg+C kopieren" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4">
                            <Run Text="In Discord: " Foreground="{StaticResource Pinsel.Text2}" /><Run Text="{Binding CodeBefehl, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Hinweis}" Text="{Binding CodeGueltig}" />
                        <!-- Nach dem dritten Code kommt von selbst keiner mehr (drei je Verbindung, 3.4): sagen und neu verbinden lassen. -->
                        <Border x:Name="CodeAbgelaufenRand" Style="{StaticResource Warnung.Unterlage}" Margin="0,10,0,0"
                                Visibility="{Binding CodeAbgelaufen, Converter={StaticResource SichtbarWenn}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Content="Neuen _Code holen"
                                        Command="{Binding NeuenCodeCommand}" gd:Hilfe.Text="Verbindet einmal neu; die neue Verbindung bekommt einen frischen Code." />
                                <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" VerticalAlignment="Center" Text="{Binding CodeAbgelaufenText}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="RueckfrageKarte" Style="{StaticResource Karte}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="2"
                        Visibility="{Binding HatRueckfrage, Converter={StaticResource SichtbarWenn}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Knopf.Haupt}" Content="_Ja, verknüpfen" Command="{Binding RueckfrageJaCommand}" Margin="0,0,8,0"
                                    gd:Hilfe.Text="Verknüpft dieses Gerät mit dem genannten Konto." />
                            <Button Content="_Nein" Command="{Binding RueckfrageNeinCommand}" gd:Hilfe.Text="Verknüpft nichts; das Gerät bleibt ohne Konto." />
                        </StackPanel>
                        <TextBlock Text="{Binding Rueckfrage}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="15" Margin="0,0,12,0" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Die Startkarte -->
            <Border x:Name="StartKarte" Style="{StaticResource Karte}" Padding="14,16,14,2">
                <!-- Innen 4 Einheiten Luft seitlich und 12 unten: Dort liegt der Schatten der Glasknöpfe, auch wenn das Feld beim Anordnen
                     um Bruchteile beschnitten wird (gemessen in OberflaecheStartseiteTests, SchattenFrei). -->
                <StackPanel Margin="4,0,4,12">
                    <!-- Logo (Gildenpaket, bis Stufe 4 der eingebaute Platzhalter), Name, Gerät -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LogoFeld" Width="96" Height="96" VerticalAlignment="Top">
                            <Image x:Name="Logo" Source="{Binding Logo}" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="Logo der Gilde" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <!-- Ein langer Name kürzt mit "..." (etwa bei Klein 900 mit offener Spalte "Wer ist da"); ganz steht er im Hilfetext. -->
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Haken}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Stroke="{StaticResource Pinsel.Senden}" Visibility="{Binding GeraetFreigegeben, Converter={StaticResource SichtbarWenn}}" />
                                <TextBlock Text="{Binding GeraetText}" FontSize="14" Foreground="{StaticResource Pinsel.Text2}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Warteraum (A42): die Kennung groß zum Vorlesen und Vergleichen, Kopieren, der Satz für Discord -->
                            <StackPanel Visibility="{Binding WartetAufFreigabe, Converter={StaticResource SichtbarWenn}}" Margin="0,8,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Content="_Kopieren" Command="{Binding Verbindung.KennungKopierenCommand}"
                                            Visibility="{Binding Verbindung.KannKopieren, Converter={StaticResource SichtbarWenn}}" gd:Hilfe.Text="Legt die Gerätekennung in die Zwischenablage." />
                                    <TextBox x:Name="KennungFeld" Style="{StaticResource Feld.Kopierbar}" FontSize="20" Padding="8,4" Text="{Binding Verbindung.GeraetAnzeige, Mode=OneWay}"
                                             AutomationProperties.Name="Gerätekennung dieses Geräts" ToolTip="Markieren und mit Strg+C kopieren" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,4,0,0" Text="{Binding Verbindung.Kopiert}"
                                           Visibility="{Binding Verbindung.Kopiert, Converter={StaticResource SichtbarWennWert}}" />
                                <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,4,0,0" Text="{x:Static m:VerbindungViewModel.WarteraumSatz}" />
                                <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding Verbindung.Vergeben, Converter={StaticResource SichtbarWennWert}}">
                                    <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding Verbindung.Vergeben}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--
                      Allererster Start (Q10, Q76, E8; Bild m-7c): an der Stelle von Verbinden der Willkommenssatz, bis die zwei Angaben da sind. Die zwei
                      Felder unten sind dann umrandet: "Ich höre mit" und die Sprechtaste mit ihrem Schritt. Bis 0.9.3 standen hier die zwei Knöpfe
                      Headset und Lautsprecher.
                    -->
                    <Border x:Name="ErststartHinweis" Margin="0,16,0,0" Padding="12,10" CornerRadius="6" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="2"
                            Visibility="{Binding ZeigtErststartHinweis, Converter={StaticResource SichtbarWenn}}">
                        <StackPanel>
                            <TextBlock x:Name="ErststartSatz" Text="{Binding ErststartSatz}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,4,0,0" Text="{Binding ErststartUmrandet}" />
                            <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,2,0,0"
                                       Text="Mikrofon und Ausgabe stehen schon auf dem Windows-Standard; alles andere regelt die Automatik." />
                        </StackPanel>
                    </Border>

                    <!-- Verbinden groß in der Leitfarbe (die Hauptaktion der Karte), verbunden Trennen -->
                    <Grid x:Name="KnopfZeile" Margin="0,16,0,0" Visibility="{Binding ZeigtKnopfZeile, Converter={StaticResource SichtbarWenn}}">
                        <Button x:Name="VerbindenKnopf" Style="{StaticResource Knopf.Haupt}" Height="44" FontSize="17" Content="_Verbinden" Command="{Binding VerbindenCommand}"
                                Visibility="{Binding ZeigtVerbinden, Converter={StaticResource SichtbarWenn}}"
                                gd:Hilfe.Text="Verbindet dich mit dem Funk der Gilde." gd:Hilfe.Gesperrt="{Binding VerbindenGesperrt}" />
                        <Button x:Name="TrennenKnopf" Height="44" FontSize="17" Content="_Trennen" Command="{Binding Verbindung.TrennenCommand}"
                                Visibility="{Binding ZeigtTrennen, Converter={StaticResource SichtbarWenn}}"
                                gd:Hilfe.Text="Trennt die Verbindung zum Funk; Einstellungen und Funkfeld bleiben." />
                    </Grid>
                    <!-- Was zum Verbinden fehlt und was zuletzt geschah, als Satz ohne Adresse und Port (Q5); weiße Schrift auf der tiefen Fläche -->
                    <Border x:Name="WasFehltRand" Background="{StaticResource Pinsel.FlaecheTief}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                            Visibility="{Binding Verbindung.ZeigtWasFehlt, Converter={StaticResource SichtbarWenn}}">
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <Run Text="Zum Verbinden fehlt noch: " FontWeight="SemiBold" /><Run Text="{Binding Verbindung.WasFehlt, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <!-- Gekürzt auf den ersten Satz mit Fehlernummer (Q23e), der ganze Satz im Hilfetext; sonst rollte die Startseite mit Gerätewarnung (Q12) -->
                    <Border x:Name="HinweisRand" Style="{StaticResource Warnung.Unterlage}" Margin="0,8,0,0" Visibility="{Binding Verbindung.Hinweis, Converter={StaticResource SichtbarWennWert}}"
                            ToolTip="{Binding Verbindung.HinweisGanz}">
                        <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding Verbindung.HinweisKurz}" />
                    </Border>

                    <!--
                      Zwei Stecker: Steuerkanal (Server) und Sprache; Farbe nie allein, daneben das Wort. Rechts Online. Seit dem Befund der Prüfung rutscht
                      die Zeile in schmalen Fenstern um, statt die Wörter abzuschneiden (bei Klein 900 mit offener Spalte "Wer ist da" stand "Serve" und
                      "verb" da): unter StartViewModel.OnlineDanebenAb steht Online darunter, unter StartViewModel.SteckerNebeneinanderAb auch Sprache unter
                      Server. Breit wie bisher verteilt: die zwei Stecker je in einer Hälfte, Online rechts.
                    -->
                    <se:Spaltenwechsel x:Name="SteckerZeile" Margin="0,14,0,0" Ab="{x:Static m:StartViewModel.OnlineDanebenAb}" Aufteilung="ZweiteNachInhalt"
                                       Luecke="0" Zeilenluecke="6">
                        <se:Spaltenwechsel.Resources>
                            <Style x:Key="Steckerwort" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
                            </Style>
                        </se:Spaltenwechsel.Resources>
                        <se:Spaltenwechsel x:Name="SteckerPaar" Ab="{x:Static m:StartViewModel.SteckerNebeneinanderAb}" Luecke="0" Zeilenluecke="6">
                            <DockPanel x:Name="ServerTeil" HorizontalAlignment="Left">
                                <se:Stecker x:Name="ServerStecker" DockPanel.Dock="Left" Zustand="{Binding Server}" AutomationProperties.Name="{Binding ServerWort, StringFormat='Server {0}'}" />
                                <StackPanel Margin="8,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Server" FontSize="12" Foreground="{StaticResource Pinsel.Text2}" />
                                    <TextBlock x:Name="ServerWort" Text="{Binding ServerWort}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Steckerwort}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Server}" Value="Verbunden">
                                                        <Setter Property="Foreground" Value="{StaticResource Pinsel.Senden}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel x:Name="SpracheTeil" HorizontalAlignment="Left">
                                <se:Stecker x:Name="SpracheStecker" DockPanel.Dock="Left" Zustand="{Binding Sprache}" AutomationProperties.Name="{Binding SpracheWort, StringFormat='Sprache {0}'}" />
                                <StackPanel Margin="8,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sprache" FontSize="12" Foreground="{StaticResource Pinsel.Text2}" />
                                    <TextBlock x:Name="SpracheWort" Text="{Binding SpracheWort}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Steckerwort}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sprache}" Value="Verbunden">
                                                        <Setter Property="Foreground" Value="{StaticResource Pinsel.Senden}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Sprache}" Value="Tunnel">
                                                        <Setter Property="Foreground" Value="{StaticResource Pinsel.Tunnel}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </se:Spaltenwechsel>
                        <TextBlock x:Name="OnlineText" Text="{Binding OnlineText}" FontSize="14" VerticalAlignment="Center" />
                    </se:Spaltenwechsel>

                    <Border Height="1" Background="{StaticResource Pinsel.Linie}" Margin="0,16,0,0" />

                    <!--
                      Die Grundansicht in zwei Spalten (Q87, Bild m-1): links Sprechen, rechts Hören; Mikrofon und Ausgabe stehen oben auf einer Höhe (Sarevoc,
                      Vorgabe l), die Funk-Lautstärke direkt unter der Ausgabe (Q74). Unter StartViewModel.ZweiSpaltenAb (etwa 846 Fensterbreite)
                      untereinander (Q88, Bild m-2). Funkfeld 5, Funkfeld 10, Wer ist da, der Pegel der Ausgabe und das Einmessen stehen seit 0.10.0
                      nicht mehr hier (E9).
                    -->
                    <se:Spaltenwechsel x:Name="Grundansicht" Margin="0,14,0,0" Ab="{x:Static m:StartViewModel.ZweiSpaltenAb}" Luecke="24" Zeilenluecke="22">

                        <!-- ============ Sprechen ============ -->
                        <StackPanel x:Name="SprechenSpalte">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Mikrofon}" Width="20" Height="20" Margin="0,0,8,0" Stroke="{StaticResource Pinsel.Text}" />
                                <TextBlock Text="Sprechen" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Etikett}" Text="Mikrofon" Margin="0,0,0,4" />
                            <ComboBox x:Name="MikrofonWahl" ItemsSource="{Binding Audio.Eingaenge}" SelectedItem="{Binding Audio.Eingang}" ItemTemplate="{StaticResource NameVorlage}"
                                      AutomationProperties.Name="Mikrofon" ToolTip="Das Mikrofon, mit dem du sendest." />
                            <!-- Seit 0.11.2 steht der Pegelbalken mit den Griffen unten auf Start unter "Senden" (Sarevoc 13.10.2026); bis 0.11.1 hier der Verweis auf die Statuszeile (Q87). -->

                            <!--
                              Sprechtaste (E17): belegt die Marken aller Sprechtasten mit Entfernen und "Ändern"; beim ersten Start der Schritt "Drück jetzt
                              deine Sprechtaste" (E8), umrandet; nach "Später" die Warnung mit "Belegen" (Q76). Oben und unten gleich viel Innenrand: Mit 8 und 6
                              schnitt das Layout bei 175 % den Glasschatten an (Prüfbericht Mischung).
                            -->
                            <Border x:Name="SprechtasteRahmen" Margin="0,14,0,0" CornerRadius="6" BorderBrush="{StaticResource Pinsel.Akzent}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SprechtasteSchrittOffen}" Value="True">
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Padding" Value="10,8,10,8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Etikett}" Text="Sprechtaste" Margin="0,0,0,4" />
                                    <!-- Belegt: die Tasten als Marken, daneben Ändern (ersetzt alle; mehrere unter Einstellungen) -->
                                    <WrapPanel x:Name="SprechtasteBelegt" Margin="0,0,0,3" Visibility="{Binding ZeigtSprechtasteBelegt, Converter={StaticResource SichtbarWenn}}">
                                        <ItemsControl ItemsSource="{Binding Sprechtaste.Belegungen}" ItemTemplate="{StaticResource TastenMarke}" VerticalAlignment="Center" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Button x:Name="AendernKnopf" Content="Ändern" MinWidth="96" VerticalAlignment="Center" Margin="6,0,0,0" Command="{Binding SprechtasteAendernCommand}"
                                                AutomationProperties.Name="Sprechtaste ändern" gd:Hilfe.Text="{x:Static m:StartViewModel.AendernHilfe}"
                                                gd:Hilfe.Gesperrt="{x:Static m:TastenViewModel.OhneQuelleGrund}" />
                                    </WrapPanel>
                                    <!-- Ändern oder Belegen wartet: das Wartefeld mit Abbrechen; zu schmal, steht Abbrechen darunter -->
                                    <StackPanel x:Name="SprechtasteWarten" Visibility="{Binding ZeigtSprechtasteWarten, Converter={StaticResource SichtbarWenn}}">
                                        <se:Spaltenwechsel Ab="{x:Static m:StartViewModel.SpaeterDanebenAb}" Aufteilung="ZweiteNachInhalt" Luecke="10" Zeilenluecke="8">
                                            <Border Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="1" CornerRadius="4"
                                                    Padding="10,7" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Sprechtaste}" Width="16" Height="16" Margin="0,0,8,0" Stroke="{StaticResource Pinsel.Text}" />
                                                    <TextBlock Text="Wartet auf deine Taste ..." FontSize="14" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="WartenAbbrechenKnopf" Content="Abbrechen" MinWidth="88" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Command="{Binding SprechtasteAbbrechenCommand}" gd:Hilfe.Text="{x:Static m:StartViewModel.AbbrechenHilfe}" />
                                        </se:Spaltenwechsel>
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,6,0,3" Text="Esc bricht ab; deine Sprechtasten bleiben, wie sie sind." />
                                    </StackPanel>
                                    <!--
                                      Erster Start (Q76, E8): Die Seite wartet gleich auf die Taste, ohne erst "Belegen" zu verlangen, ohne Frist, solange sie vorn ist.
                                      Esc bricht das Warten ab (dann steht hier "Belegen"), Später lässt den Schritt aus; die Warnung steht danach an dieser Stelle.
                                      Ist die Spalte schmal (Klein 900 mit zwei Spalten), steht Später unter dem Wartefeld (Prüfbericht Mischung).
                                    -->
                                    <StackPanel x:Name="SprechtasteSchritt" Visibility="{Binding SprechtasteSchrittOffen, Converter={StaticResource SichtbarWenn}}">
                                        <TextBlock Text="Drück jetzt deine Sprechtaste" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,2,0,0"
                                                   Text="Eine Taste, eine Maustaste oder einen Knopf am Joystick. Sie wirkt auch, wenn das Spiel vorn ist." />
                                        <se:Spaltenwechsel x:Name="SchrittZeile" Margin="0,8,0,0" Ab="{x:Static m:StartViewModel.SpaeterDanebenAb}" Aufteilung="ZweiteNachInhalt"
                                                           Luecke="10" Zeilenluecke="8">
                                            <Grid>
                                                <Border x:Name="WarteFeld" Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,7" VerticalAlignment="Center" gd:Hilfe.Text="{x:Static m:StartViewModel.WarteFeldHilfe}"
                                                        Visibility="{Binding ZeigtWarteFeld, Converter={StaticResource SichtbarWenn}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Sprechtaste}" Width="16" Height="16" Margin="0,0,8,0" Stroke="{StaticResource Pinsel.Text}" />
                                                        <TextBlock Text="Wartet auf deine Taste ..." FontSize="14" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="SchrittBelegenKnopf" Content="Belegen" MinWidth="88" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding ZeigtSchrittBelegen, Converter={StaticResource SichtbarWenn}}" Command="{Binding SprechtasteBelegenCommand}"
                                                        AutomationProperties.Name="Sprechtaste belegen" gd:Hilfe.Text="{x:Static m:StartViewModel.BelegenHilfe}"
                                                        gd:Hilfe.Gesperrt="{x:Static m:TastenViewModel.OhneQuelleGrund}" />
                                            </Grid>
                                            <Button x:Name="SpaeterKnopf" Content="Später" MinWidth="88" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Command="{Binding SpaeterCommand}" gd:Hilfe.Text="{x:Static m:StartViewModel.SpaeterHilfe}" />
                                        </se:Spaltenwechsel>
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,6,0,0"
                                                   Text="Esc bricht ab. Später: In Kanälen auf Taste, etwa Global, geht dann nichts hinaus; Start erinnert dich daran." />
                                    </StackPanel>
                                    <!-- Nach Später oder ohne Taste: die Warnung bleibt auf Start, bis eine Taste belegt ist (Q76) -->
                                    <Border x:Name="SprechtasteWarnung" Style="{StaticResource Warnung.Unterlage}" Padding="10,6,6,6" Margin="0,0,0,3"
                                            Visibility="{Binding ZeigtSprechtasteWarnung, Converter={StaticResource SichtbarWenn}}">
                                        <DockPanel>
                                            <Button x:Name="WarnungBelegenKnopf" DockPanel.Dock="Right" Content="Belegen" VerticalAlignment="Center" Margin="10,0,0,0"
                                                    Command="{Binding SprechtasteBelegenCommand}" AutomationProperties.Name="Sprechtaste belegen"
                                                    gd:Hilfe.Text="{x:Static m:StartViewModel.BelegenHilfe}" gd:Hilfe.Gesperrt="{x:Static m:TastenViewModel.OhneQuelleGrund}" />
                                            <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" VerticalAlignment="Center"
                                                       Text="Noch keine Sprechtaste: In Kanälen auf Taste, etwa Global, geht nichts hinaus." />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Senden mit Stimme an oder aus (das Klangmodul Sprachaktivierung, Q48) -->
                            <CheckBox x:Name="StimmeSchalter" IsChecked="{Binding Audio.SprachaktivierungAn}" Margin="0,16,0,0" VerticalAlignment="Top"
                                      AutomationProperties.Name="Senden mit Stimme" gd:Hilfe.Text="{x:Static m:AudioViewModel.SprachaktivierungHilfe}">
                                <StackPanel>
                                    <TextBlock Text="Senden mit Stimme" />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" Text="Sendet, sobald du sprichst. Aus: nur mit der Sprechtaste." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!--
                          ============ Hören ============
                          Liegt "Wer ist da" in Klein als Schublade über Start, liegt diese Spalte darunter (Q93 a). Dann ist sie aus Tab-Kreis und
                          Pfeilnavigation genommen, damit sich Ausgabe, Funk-Lautstärke, Hörweise und Hörprobe nicht blind ändern lassen (Befund der
                          Prüfung); f:Hauptfenster.UnterSchublade setzt das Hauptfenster auf den Platz der Seiten, sie wird hierher geerbt.
                        -->
                        <StackPanel x:Name="HoerenSpalte">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="f:Hauptfenster.UnterSchublade" Value="True">
                                            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
                                            <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="None" />
                                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Hoeren}" Width="20" Height="20" Margin="0,0,8,0" Stroke="{StaticResource Pinsel.Text}" />
                                <TextBlock Text="Hören" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Etikett}" Text="Ausgabe" Margin="0,0,0,4" />
                            <ComboBox x:Name="AusgabeWahl" ItemsSource="{Binding Audio.Ausgaenge}" SelectedItem="{Binding Audio.Ausgang}" ItemTemplate="{StaticResource NameVorlage}"
                                      AutomationProperties.Name="Ausgabe" ToolTip="Das Gerät, über das du den Funk hörst." />
                            <!-- Funk-Lautstärke (Q74, E7): alles, was JG TacRelay abspielt; Windows und das Spiel bleiben -->
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Etikett}" Text="Funk-Lautstärke" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock x:Name="FunkLautstaerkeWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding Audio.FunkLautstaerkeText}" Width="44"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider x:Name="FunkLautstaerke" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Audio.FunkLautstaerke}" VerticalAlignment="Center" AutomationProperties.Name="Funk-Lautstärke in Prozent"
                                        gd:Hilfe.Text="{x:Static m:AudioViewModel.FunkLautstaerkeHilfe}" />
                            </DockPanel>

                            <!-- Headset oder Lautsprecher, beim ersten Start umrandet mit dem Satz, was die Wahl bewirkt (Q10) -->
                            <Border x:Name="HoerweiseRahmen" Margin="0,14,0,0" CornerRadius="6" BorderBrush="{StaticResource Pinsel.Akzent}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Audio.FrageOffen}" Value="True">
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Padding" Value="10,8,10,8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Etikett}" Text="Ich höre mit" Margin="0,0,0,4" />
                                    <WrapPanel Margin="0,0,0,3">
                                        <RadioButton x:Name="HeadsetWahl" Style="{StaticResource Umschalter.Radio}" GroupName="Hoerweise" IsChecked="{Binding Audio.Headset}"
                                                     AutomationProperties.Name="Ich höre mit Headset" gd:Hilfe.Text="{x:Static m:AudioViewModel.HeadsetHilfe}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Hoeren}" Width="15" Height="15" Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                <TextBlock Text="Headset" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="LautsprecherWahl" Style="{StaticResource Umschalter.Radio}" GroupName="Hoerweise" IsChecked="{Binding Audio.Lautsprecher}"
                                                     AutomationProperties.Name="Ich höre über Lautsprecher" gd:Hilfe.Text="{x:Static m:AudioViewModel.LautsprecherHilfe}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Lautstaerke}" Width="15" Height="15" Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                <TextBlock Text="Lautsprecher" />
                                            </StackPanel>
                                        </RadioButton>
                                    </WrapPanel>
                                    <TextBlock x:Name="HoerweiseFrage" Style="{StaticResource Text.Hinweis}" Margin="0,4,0,0"
                                               Visibility="{Binding Audio.FrageOffen, Converter={StaticResource SichtbarWenn}}"
                                               Text="Headset: Echounterdrückung aus. Lautsprecher: an, sonst hören die anderen sich selbst." />
                                </StackPanel>
                            </Border>

                            <!-- Die eine Hörprobe, auch verbunden (Q75); bei einer Gerätewarnung nicht, sie bräuchte beide Geräte -->
                            <StackPanel x:Name="HoerprobeZeile" Margin="0,16,0,0" Visibility="{Binding ZeigtHoerprobe, Converter={StaticResource SichtbarWenn}}">
                                <TextBlock Style="{StaticResource Text.Etikett}" Text="So hören dich die anderen" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button x:Name="HoerprobeKnopf" DockPanel.Dock="Left" Content="{Binding HoerprobeKnopfText}" MinWidth="104" VerticalAlignment="Top" Margin="0,0,12,3"
                                            Command="{Binding HoerprobeCommand}" AutomationProperties.Name="Hörprobe"
                                            gd:Hilfe.Text="{x:Static m:StartViewModel.HoerprobeHilfe}" gd:Hilfe.Gesperrt="{Binding HoerprobeGesperrt}" />
                                    <TextBlock x:Name="HoerprobeText" Style="{StaticResource Text.Hinweis}" FontSize="13" VerticalAlignment="Center" Text="{Binding HoerprobeText}" />
                                </DockPanel>
                            </StackPanel>

                            <!--
                              Ein Gerät ging nicht auf (etwa das Mikrofon, vom Datenschutz gesperrt): deutlich und mit "Erneut versuchen", an der Stelle der
                              Hörprobe (sie bräuchte beide Geräte). Seit 0.10.0 in der Spalte Hören statt unter beiden Spalten: Beim ersten Start ist Sprechen
                              mit dem Schritt Sprechtaste die längere Spalte, so bleibt Start in Klein 900 x 900 ohne Rollbalken (gemessen in
                              OberflaecheStartseiteTests). Der Knopf steht unter dem Satz, in der schmalen Spalte bliebe daneben kaum Platz.
                            -->
                            <Border x:Name="MikrofonWarnung" Style="{StaticResource Warnung.Unterlage}" Margin="0,16,0,0"
                                    Visibility="{Binding Audio.HatGeraeteWarnung, Converter={StaticResource SichtbarWenn}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Mikrofon}" Width="18" Height="18"
                                              Margin="0,0,10,0" VerticalAlignment="Top" Stroke="{StaticResource Pinsel.RotSchrift}" />
                                        <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding Audio.GeraeteWarnungKurz}" ToolTip="{Binding Audio.GeraeteWarnung}" />
                                    </DockPanel>
                                    <Button HorizontalAlignment="Left" Margin="28,8,0,3" Command="{Binding Audio.WiederholenCommand}" Content="Erneut versuchen"
                                            gd:Hilfe.Text="Öffnet Mikrofon und Wiedergabe sofort neu, etwa nachdem du sie im Datenschutz von Windows erlaubt hast." />
                                </StackPanel>
                            </Border>
                                <!-- Seit 0.11.2 keine Meldung "Mikrofon und Wiedergabe sind zu" mehr auf Start (Sarevoc 13.10.2026: "wer braucht das"); "Audio starten" steht unter Einstellungen > Fehlersuche. -->
                        </StackPanel>
                    </se:Spaltenwechsel>

                    <!--
                      Senden auf Start (0.11.2, Sarevoc 13.10.2026: "Auf der Startseite sollen auf alle Fälle unten, wie sonst auch, aber nur das Notwendige zum
                      Senden angezeigt werden, also mit Schiebeschaltern die Module, mit Link zu den erweiterten Einstellungen. Und der Audio-Live-Balken
                      mit den verschiebbaren vertikalen Linien muss auf die Startseite."): der Pegelbalken mit den Griffen (Mindest-Funklautstärke und
                      Obergrenze) und Einmessen wie unter Einstellungen > Senden, darunter die Schiebeschalter der Klangmodule nur mit Namen (die
                      Erklärung steht im Hovertext), dann "Erweitert:" zu den Einstellungen. Die Sprachaktivierung steht schon links als "Senden mit
                      Stimme" (Q48) und kommt nicht doppelt; die Echounterdrückung folgt Headset oder Lautsprecher.
                    -->
                    <StackPanel x:Name="StartSenden" Margin="0,16,0,6" DataContext="{Binding Audio}">
                        <TextBlock Text="Senden" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button x:Name="StartEinmessenKnopf" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Content="{Binding Korridor.EinmessKnopfKurz}" Command="{Binding Korridor.EinmessenCommand}"
                                    AutomationProperties.Name="Mindestlautstärke einmessen" gd:Hilfe.Text="{x:Static m:KorridorViewModel.HilfeEinmessen}"
                                    gd:Hilfe.Gesperrt="{Binding Korridor.EinmessenGesperrt}" />
                            <se:Pegelbalken x:Name="StartPegel" Height="36" PegelDb="{Binding PegelDbfs}" SchwelleDb="{Binding SchwelleDb}" Sendet="{Binding Sendet}"
                                            WuerdeSenden="{Binding WuerdeSenden}" Korridor="{Binding Korridor}" Stumm="{Binding Stumm}" Hinweis="{Binding NichtsGesendet}"
                                            HinweisImBalken="False" AutomationProperties.Name="Eingangspegel" />
                        </DockPanel>
                        <WrapPanel x:Name="StartModule" Margin="0,10,0,0">
                            <CheckBox x:Name="StartRauschSchalter" IsChecked="{Binding Rauschunterdrueckung}" Content="Rauschunterdrückung" Margin="0,0,24,8"
                                      AutomationProperties.Name="Rauschunterdrückung" gd:Hilfe.Text="{x:Static m:AudioViewModel.RauschunterdrueckungHilfe}" />
                            <CheckBox x:Name="StartEchoschutzSchalter" IsChecked="{Binding Echoschutz}" Content="Echoschutz" Margin="0,0,24,8"
                                      AutomationProperties.Name="Echoschutz" gd:Hilfe.Text="{x:Static m:AudioViewModel.EchoschutzHilfe}" />
                            <CheckBox x:Name="StartLautstaerkeSchalter" DataContext="{Binding Lautstaerke}" IsChecked="{Binding Automatisch}" Content="Automatische Lautstärke"
                                      Margin="0,0,24,8" AutomationProperties.Name="Automatische Lautstärke" gd:Hilfe.Text="{x:Static m:AudioViewModel.AutomatikHilfe}" />
                            <CheckBox x:Name="StartMindestSchalter" IsChecked="{Binding MindestFunklautstaerke}" Content="Mindest-Funklautstärke" Margin="0,0,24,8"
                                      AutomationProperties.Name="Mindest-Funklautstärke" gd:Hilfe.Text="{x:Static m:AudioViewModel.MindestHilfe}" />
                            <!-- "Erweitert:" in derselben Reihe wie die Schalter (0.11.2: Start passt in Klein 900 x 900 ohne Rollbalken, Q89) -->
                            <Button x:Name="StartErweitertKnopf" VerticalAlignment="Center" Margin="0,0,0,8"
                                    Command="{Binding DataContext.BereichWaehlenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2"
                                    AutomationProperties.Name="Erweitert: alle Einstellungen zum Senden"
                                    gd:Hilfe.Text="Öffnet die Einstellungen; unter Senden steht alles Weitere, unter Erweitert, was selten jemand braucht. Die Griffe am Balken lassen sich ziehen." gd:Hilfe.Taste="Strg+2">
                                <TextBlock TextWrapping="Wrap"><Run FontWeight="Bold" Text="Erweitert:" /><Run Text=" alle Einstellungen zum Senden" /></TextBlock>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Seit 0.11.2 keine Karte "Einsteigen" mehr auf Start (Sarevoc 13.10.2026: "auf der Startseite nur das Audio, nichts weiter"); 0.10.0 bis 0.11.1 stand sie hier. -->
        </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Eine Zeile einer Liste als Knopf, links ausgerichtet (Wer ist da). -->
    <Style x:Key="Knopf.Zeile" TargetType="Button" BasedOn="{StaticResource Knopf.Flach}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Background" Value="{StaticResource Pinsel.Flaeche}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Linie}" />
    </Style>

    <!-- Kleines Schloss: vom Admin eingetragen, nicht abwählbar -->
    <Geometry x:Key="Form.Schloss">M 6,11 L 6,8 A 4,4 0 0 1 14,8 L 14,11 M 4,11 L 16,11 L 16,19 L 4,19 Z</Geometry>
    <!-- Stern: erste Wahl -->
    <Geometry x:Key="Form.Stern">M 10,2 L 12.4,7.6 L 18.5,8.1 L 13.9,12.1 L 15.3,18 L 10,14.9 L 4.7,18 L 6.1,12.1 L 1.5,8.1 L 7.6,7.6 Z</Geometry>

    <!-- A49: Zeichen neben Namen, aus dem eingebauten Satz (Design\Zeichensatz.cs), 14 Einheiten -->
    <DataTemplate x:Key="ZeichenVorlage">
        <ItemsControl ItemsSource="{Binding}" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding Bild}" Width="14" Height="14" Margin="0,0,4,0" ToolTip="{Binding Titel}"
                           AutomationProperties.Name="{Binding Titel}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!--
      ============================== Wer ist da (A48) ==============================
      Seit 0.11.5 (Sarevoc 13.10.2026: "Ein Name-Button je Zeile, alle untereinander, alle gleich lang; nicht abschneiden ... Keine Kacheln drei je
      Reihe mehr, keine Gruppierung nach Untergilde"; Sarevoc 14.10.2026: Mikrofon, Statusgrafik und Wippe hinter dem Namen): eine flache Liste, die
      rollt. Je Zeile der Name-Knopf (Abzeichen mit Online-Punkt und Name), das Mikrofon, der Status und die Wippe, sonst nichts; Maße in
      Stile.xaml (WerIstDa.*). Bis 0.11.4 Kacheln drei je Reihe in Gruppen, das gelbe "!" der Dauersend-Dämpfung und unten die Mitgliedskarte.
    -->
    <DataTemplate DataType="{x:Type m:WerIstDaViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="14,12,10,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource Knopf.Marke}" Command="{Binding SchliessenCommand}" gd:Hilfe.Text="Schließt die Spalte Wer ist da." gd:Hilfe.Taste="Strg+6"
                        AutomationProperties.Name="Wer ist da schließen">
                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Entfernen}" Width="10" Height="10" Stroke="{StaticResource Pinsel.Text2}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Knopf.Marke}" Command="{Binding LoesenCommand}" Margin="0,0,6,0" gd:Hilfe.Text="{Binding LoesenHilfe}"
                        AutomationProperties.Name="{Binding LoesenText, StringFormat='Wer ist da {0}'}">
                    <TextBlock Text="{Binding LoesenText}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Knopf.Marke}" Command="{Binding NachladenCommand}" Margin="0,0,6,0" gd:Hilfe.Text="Baut die Liste neu auf; mit &quot;auch offline&quot; holt es auch die Liste aller Mitglieder neu vom Server."
                        AutomationProperties.Name="Wer ist da aktualisieren">
                    <TextBlock Text="neu" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" />
                </Button>
                <TextBlock Style="{StaticResource Text.Abschnitt}" Text="{Binding KnopfText}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="14,4,14,8">
                <TextBlock Style="{StaticResource Text.Etikett}" FontSize="12" Text="Suchen: Name, SC-Name oder Discord-Name" Margin="0,0,0,2" />
                <TextBox x:Name="WerIstDaSuche" Text="{Binding Suche, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="In Wer ist da suchen"
                         ToolTip="Suche über Name, SC-Name und Discord-Name, auch Teile" />
                <!-- 0.11.0: nur für die Einsatzleitung, ohne Zugriffstaste (Brett und Wer ist da teilen sich die Tasten) -->
                <ToggleButton x:Name="AuchOfflineSchalter" Style="{StaticResource Umschalter}" IsChecked="{Binding AuchOffline}" HorizontalAlignment="Left"
                              Padding="10,2" MinHeight="26" FontSize="12" Margin="0,6,0,0" Content="auch offline" AutomationProperties.Name="Auch offline zeigen"
                              gd:Hilfe.Text="Zeigt auch, wer offline ist (nur für die Einsatzleitung)."
                              Visibility="{Binding AuchOfflineSichtbar, Converter={StaticResource SichtbarWenn}}" />
                <Border Style="{StaticResource Warnung.Unterlage}" Background="{StaticResource Pinsel.Anthrazit}" Margin="0,6,0,0"
                        Visibility="{Binding Fehler, Converter={StaticResource SichtbarWennWert}}">
                    <TextBlock Style="{StaticResource Text.Warnung}" FontSize="12" Text="{Binding Fehler}" />
                </Border>
            </StackPanel>

            <!-- Rechts 4 Rand: Dort liegt der Rollbalken (10), die Zeilen (310) passen mit und ohne ihn, ohne zu springen. -->
            <ScrollViewer x:Name="WerIstDaLauf" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="14,0,4,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Hinweis}" Text="{Binding Leer}" Margin="0,8,0,0" Visibility="{Binding Leer, Converter={StaticResource SichtbarWennWert}}" />
                    <ItemsControl x:Name="WerIstDaListe" ItemsSource="{Binding Zeilen}" Focusable="False" Margin="0,4,0,0" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:WerIstDaZeile}">
                                <StackPanel x:Name="Zeile" Orientation="Horizontal" Margin="0,0,0,4">
                                    <!-- 0. Abzeichen mit Online-Punkt (Sarevoc 14.10.2026: "erst Abzeichen, dann Name"): ein Admin im Admin-Setup springt in die Verwaltung zu diesem Mitglied -->
                                    <Button x:Name="AbzeichenKnopf" Style="{StaticResource WerIstDa.Klein}" Margin="0,0,4,0" Padding="2,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource Personenkachel.Abzeichen}"
                                            Command="{Binding AbzeichenOeffnenCommand}" gd:Hilfe.Text="{Binding AbzeichenHilfe}" gd:Hilfe.Gesperrt="{Binding AbzeichenGesperrt}"
                                            AutomationProperties.Name="{Binding AbzeichenAnsage}" />
                                    <!-- 1. Name: mit der Einsatzleitung öffnet er die Raid-Seite, sonst nur Anzeige (gesperrt, hell lesbar); kürzt nie -->
                                    <Button x:Name="NameKnopf" Style="{StaticResource WerIstDa.Name}" Content="{Binding}" ContentTemplate="{StaticResource WerIstDa.NurName}"
                                            Command="{Binding RaidOeffnenCommand}" gd:Hilfe.Text="{Binding NameHilfe}" gd:Hilfe.Gesperrt="{Binding Beschreibung}"
                                            AutomationProperties.Name="{Binding Beschreibung}" />
                                    <!-- 2. Mikrofon: stumm schalten (Einsatzleitung), stumm mit Querstrich in Blutrot -->
                                    <Button x:Name="StummKnopf" Style="{StaticResource WerIstDa.Klein}" Command="{Binding MikroCommand}"
                                            gd:Hilfe.Text="{Binding MikroHilfe}" gd:Hilfe.Gesperrt="{Binding MikroGesperrt}" AutomationProperties.Name="{Binding MikroAnsage}">
                                        <Path x:Name="StummSymbol" Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Mikrofon}" Width="15" Height="15" StrokeThickness="1.8" />
                                    </Button>
                                    <!-- 3. Status: grün in Kanälen, gelb in keinem, grauer Ring unbekannt; im Admin-Setup ein Sprung in die Verwaltung -->
                                    <Button x:Name="StatusKnopf" Style="{StaticResource WerIstDa.Klein}" Command="{Binding StatusCommand}"
                                            gd:Hilfe.Text="{Binding StatusHilfe}" gd:Hilfe.Gesperrt="{Binding StatusGesperrt}" AutomationProperties.Name="{Binding StatusAnsage}">
                                        <Grid>
                                            <Ellipse x:Name="Lampe" Width="10" Height="10" Fill="Transparent" Stroke="{StaticResource Pinsel.Text2}" StrokeThickness="1.4" />
                                            <!-- Grün mit der Zahl der Kanäle (Sarevoc 14.10.2026: "1 bedeutet in einem Kanal", höchstens 9) -->
                                            <TextBlock x:Name="Zahl" Text="{Binding KanalzahlText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Pinsel.FlaecheTief}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <!-- 4. Wippe quer (Sarevoc 14.10.2026: "seitlich, rechts lauter, links leiser"): je Klick 2 dB, nicht in der eigenen Zeile -->
                                    <Border x:Name="Wippe" Style="{StaticResource WerIstDa.Wippe}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="LeiserKnopf" Style="{StaticResource WerIstDa.WippenHaelfte}" Command="{Binding LeiserCommand}"
                                                    gd:Hilfe.Text="{Binding LeiserHilfe}" gd:Hilfe.Gesperrt="{Binding LeiserGesperrt}" AutomationProperties.Name="{Binding LeiserAnsage}">
                                                <Path Style="{StaticResource Symbol}" Data="M 1,4.5 H 8" Width="9" Height="9" StrokeThickness="1.8" Stretch="None" />
                                            </Button>
                                            <Rectangle Grid.Column="1" Width="1" Margin="0,6" Fill="{StaticResource Pinsel.Linie}" />
                                            <Button x:Name="LauterKnopf" Grid.Column="2" Style="{StaticResource WerIstDa.WippenHaelfte}" Command="{Binding LauterCommand}"
                                                    gd:Hilfe.Text="{Binding LauterHilfe}" gd:Hilfe.Gesperrt="{Binding LauterGesperrt}" AutomationProperties.Name="{Binding LauterAnsage}">
                                                <Path Style="{StaticResource Symbol}" Data="M 1,4.5 H 8 M 4.5,1 V 8" Width="9" Height="9" StrokeThickness="1.8" Stretch="None" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Stumm}" Value="True">
                                        <Setter TargetName="StummSymbol" Property="Data" Value="{StaticResource Symbol.MikrofonStumm}" />
                                        <Setter TargetName="StummSymbol" Property="Stroke" Value="{StaticResource Pinsel.RotSchrift}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kanalstand}" Value="{x:Static m:Kanalstand.Eingeteilt}">
                                        <Setter TargetName="Lampe" Property="Fill" Value="{StaticResource Pinsel.Senden}" />
                                        <Setter TargetName="Lampe" Property="Stroke" Value="{StaticResource Pinsel.Senden}" />
                                        <Setter TargetName="Lampe" Property="Width" Value="17" />
                                        <Setter TargetName="Lampe" Property="Height" Value="17" />
                                        <Setter TargetName="Zahl" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kanalstand}" Value="{x:Static m:Kanalstand.OhneKanal}">
                                        <Setter TargetName="Lampe" Property="Fill" Value="{StaticResource Pinsel.OhneKanal}" />
                                        <Setter TargetName="Lampe" Property="Stroke" Value="{StaticResource Pinsel.OhneKanal}" />
                                    </DataTrigger>
                                    <!-- Die eigene Zeile hat keine Wippe; ihr Platz bleibt, damit die Spalten bündig stehen. -->
                                    <DataTrigger Binding="{Binding HatWippe}" Value="False">
                                        <Setter TargetName="Wippe" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ============================== Raid: das Brett der Einsatzleitung ============================== -->
    <DataTemplate DataType="{x:Type m:BrettViewModel}">
        <f:BrettAnsicht />
    </DataTemplate>

    <!-- ============================== Verwaltung (A45): Ansicht aus dem Verwaltungsteil ============================== -->
    <DataTemplate DataType="{x:Type m:VerwaltungsBereich}">
        <ContentControl Content="{Binding Ansicht, Mode=OneTime}" Focusable="False" />
    </DataTemplate>

    <!-- ============================== Abzeichen (0.11.7): Seite aus dem Verwaltungsteil, nur in der Admin-Sitzung ============================== -->
    <DataTemplate DataType="{x:Type m:AbzeichenBereich}">
        <ContentControl Content="{Binding Ansicht, Mode=OneTime}" Focusable="False" />
    </DataTemplate>

    <!--
      Kopf eines Abschnitts der Einstellungen (seit 0.10.0, E6, Bild m-4): Zeichen und Name, daneben der Kasten "Läuft von selbst" oder bei
      Fehlersuche ein Satz. Die Namen stehen in einer Spalte fester Breite (EinstellungenViewModel.NamenBreite), damit die Kästen bündig stehen; schmal
      (unter KastenDanebenAb) steht der Kasten unter dem Namen (Prüfbericht Mischung, m-4c). DataContext: Einstellabschnitt.
    -->
    <DataTemplate x:Key="AbschnittKopf" DataType="{x:Type m:Einstellabschnitt}">
        <se:Spaltenwechsel x:Name="Kopfzeile" Ab="{x:Static m:EinstellungenViewModel.KastenDanebenAb}" Aufteilung="ErsteFest"
                           ErsteBreite="{x:Static m:EinstellungenViewModel.NamenBreite}" Luecke="0" Zeilenluecke="6">
            <StackPanel Style="{StaticResource Abschnitt.Kopf}">
                <Path Style="{StaticResource Symbol}" Data="{Binding Symbol, Converter={StaticResource Ressource}}" Width="18" Height="18" Margin="0,0,8,0"
                      Stroke="{StaticResource Pinsel.Text}" />
                <TextBlock x:Name="AbschnittName" Style="{StaticResource Abschnitt.Name}" Text="{Binding Name}" />
            </StackPanel>
            <Grid>
                <Border x:Name="Kasten" Style="{StaticResource Automatik}" Visibility="{Binding Automatik, Converter={StaticResource SichtbarWennWert}}">
                    <DockPanel>
                        <Path x:Name="KastenZeichen" DockPanel.Dock="Left" Style="{StaticResource Automatik.Haken}" />
                        <TextBlock x:Name="KastenText" Style="{StaticResource Automatik.Text}" Text="{Binding KastenText}" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="Satz" Style="{StaticResource Automatik.Text}" Margin="10,5,0,5" Text="{Binding Satz}"
                           Visibility="{Binding Satz, Converter={StaticResource SichtbarWennWert}}" />
            </Grid>
        </se:Spaltenwechsel>
        <DataTemplate.Triggers>
            <!-- Seit 0.11.9: ein Hinweis statt "Läuft von selbst" (Sprecheranzeige, das Spiel im exklusiven Vollbild), mit dem Zeichen Hinweis -->
            <DataTrigger Binding="{Binding HatHinweis}" Value="True">
                <Setter TargetName="KastenZeichen" Property="Data" Value="{StaticResource Symbol.Hinweis}" />
                <Setter TargetName="KastenZeichen" Property="Stroke" Value="{StaticResource Pinsel.Ausrufe}" />
                <Setter TargetName="KastenText" Property="Foreground" Value="{StaticResource Pinsel.Text}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
      ============================== Einstellungen (seit 0.10.0 nach der Mischung, Q87, Bilder m-4 und m-5) ==============================
      Oben offen die Karte "Ich" (E14), darunter in einer Karte die Abschnitte Tasten, Empfangen, Senden, Funkfeld und Darstellung, Sprecheranzeige und Fehlersuche, je
      mit dem Kasten "Läuft von selbst" (Fehlersuche mit einem Satz) und dem zugeklappten Klappbereich "Erweitert:" (E6; bis 0.11.0 unter anderem
      Namen): Kopfzeile mit dem fetten Wort, dem Stand und dem Inhalt, Zwischenüberschriften, unten "Zurück auf Werkseinstellung" mit dem Satz, was
      selbst gestellt ist. Ob ein Klappbereich offen ist, merken die Einstellungen. Unter Senden stehen seit 0.11.1 die Klangmodule und die
      Funkschwelle offen über dem Klappbereich (Sarevoc 12.10.2026). Bis 0.9.3 standen hier Karten (globale Tasten, Funkfeld, Farben, Tooltips, Start,
      Tastatur, Ablage), dazu gab es die Seiten Audio und Meine Kanäle; ihr Inhalt steht jetzt unter Senden und in den Klappbereichen, Geräte, Headset
      oder Lautsprecher und die Hörprobe auf Start. Seit 0.11.9 steht vor Fehlersuche der Abschnitt Sprecheranzeige (ohne Zugriffstasten). Die Details der
      Verbindung (nur Admin-Setup) bleiben eine eigene Karte (E21). Die Seite darf rollen (Q89). Zugriffstasten nur S, E (Ich), F (Nachlauf),
      R (Rauschunterdrückung, seit 0.11.1 offen), D, K, G, Z, N, O, P (Meldezeile, seit 0.11.1), H, W, U, A, V (Funkfeld und Darstellung); die Knöpfe
      "Zurück auf ..." und "Genau einstellen ..." haben keine.
    -->
    <DataTemplate DataType="{x:Type m:EinstellungenViewModel}">
        <!-- Bis 820 breit und links: eine Spalte mit Höchstbreite, damit jede Karte dieselbe Breite hat -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="820" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Ueberschrift}" Text="Einstellungen" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,0,0,14"
                       Text="Was du zum Funken brauchst, steht auf Start. Hier: dein Name, das Senden und unter Erweitert, was selten jemand braucht. Ab Werk passt alles." />

            <!-- ============ Ich: Namen und Rollenwünsche offen, Zeichen und Sichtbarkeit unter Erweitert (E14, A46, A49) ============ -->
            <Border x:Name="IchKarte" Style="{StaticResource Karte}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Sprecher}" Width="18" Height="18" Margin="0,0,8,0" Stroke="{StaticResource Pinsel.Text}" />
                        <TextBlock Style="{StaticResource Text.Abschnitt}" Text="Ich" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="NameKarte" DataContext="{Binding MeinProfil}">
                        <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,0,0,6" Visibility="{Binding NichtAktiv, Converter={StaticResource SichtbarWenn}}"
                                   Text="Ändern geht, sobald du verbunden und freigegeben bist. Vor der Freigabe stehen die Namen auf Start." />
                        <!--
                          Seit dem Befund der Prüfung schmaler (220, 220 und 180 statt je 240): So stehen die drei auch in der Größe ab Werk (960 breit, mit
                          Rollbalken 661 für die Karte) in einer Zeile, und Tasten und Empfangen sind ohne Rollen zu sehen (m-4b). Darunter brechen sie um.
                        -->
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <Label Target="{Binding ElementName=MeinScName}" Padding="0" Margin="0,0,0,4" HorizontalAlignment="Left">
                                    <AccessText Style="{StaticResource Text.Zugang}" Text="Mein _SC-Name" />
                                </Label>
                                <TextBox x:Name="MeinScName" MaxLength="22" Text="{Binding ScName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Aktiv}"
                                         AutomationProperties.Name="Mein SC-Name" ToolTip="Wie im Spiel, etwa Mustermann, höchstens 22 Zeichen" />
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <Label Target="{Binding ElementName=WeitereScNamen}" Padding="0" Margin="0,0,0,4" HorizontalAlignment="Left">
                                    <AccessText Style="{StaticResource Text.Zugang}" Text="W_eitere SC-Namen" />
                                </Label>
                                <TextBox x:Name="WeitereScNamen" MaxLength="80" Text="{Binding WeitereScNamen, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Aktiv}"
                                         AutomationProperties.Name="Weitere SC-Namen" ToolTip="Bis zu zwei Zweitkonten im Spiel, durch Komma getrennt" />
                            </StackPanel>
                            <!-- Nur angezeigt (A53): Den Discord-Namen ändert nur ein Admin, der Server nimmt ihn aus ProfilSetzen nicht an. -->
                            <StackPanel Width="180" Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource Text.Etikett}" Text="Mein Discord-Name" Margin="0,0,0,4" />
                                <TextBlock x:Name="MeinDiscordName" Text="{Binding DiscordNameAnzeige, Mode=OneWay}" FontSize="14" TextWrapping="Wrap"
                                           AutomationProperties.Name="Mein Discord-Name" />
                                <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{x:Static m:MeinProfilViewModel.DiscordNameKurz}"
                                           ToolTip="{x:Static m:MeinProfilViewModel.DiscordNameHinweis}" />
                            </StackPanel>
                        </WrapPanel>

                        <!--
                          Rollen (A46), seit dem Befund der Prüfung wie in Vorlage m-4: je Katalogrolle ein Umschalter, umbrechend. Vom Admin eingetragene
                          stehen nur einmal, an ihrer Stelle gesperrt mit Schloss (bis dahin zusätzlich als Liste "Vom Admin eingetragen"). Neben jeder
                          gewählten Rolle ein kleiner Stern zum Markieren der ersten Wahl; die erste Wahl trägt ihn gefüllt. Bis dahin war jede Rolle eine
                          eigene Zeile mit Schalter und Knopf "erste Wahl", und die Karte wuchs mit dem Katalog. Bis zu 8 Wünsche.
                        -->
                        <StackPanel x:Name="RollenKarte">
                            <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,4,0,4" Visibility="{Binding OhneKatalog, Converter={StaticResource SichtbarWenn}}"
                                       Text="Noch kein Rollenkatalog. Sobald der Admin einen anlegt, wählst du hier deine Lieblingsrollen (bis zu 8, eine als erste Wahl)." />
                            <StackPanel Visibility="{Binding HatKatalog, Converter={StaticResource SichtbarWenn}}" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Text.Etikett}" TextWrapping="Wrap" Text="Rollenwünsche; die erste Wahl trägt den Stern" Margin="0,0,0,4" />
                                <ItemsControl x:Name="RollenWahl" ItemsSource="{Binding Wuensche}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:RollenWunsch}">
                                            <!-- Unten 3 Luft für den Glasschatten, rechts 8 bis zur nächsten Rolle -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                                <ToggleButton x:Name="RolleUmschalter" Style="{StaticResource Umschalter}" IsChecked="{Binding Gewaehlt}" IsEnabled="{Binding Waehlbar}"
                                                              AutomationProperties.Name="{Binding Text}" gd:Hilfe.Text="{Binding Hilfe}"
                                                              gd:Hilfe.Gesperrt="{x:Static m:RollenWunsch.VomAdminGrund}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path x:Name="RolleSchloss" Style="{StaticResource Symbol}" Data="{StaticResource Form.Schloss}" Width="12" Height="12" Margin="0,0,6,0"
                                                              StrokeThickness="1.6" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              Visibility="{Binding VomAdmin, Converter={StaticResource SichtbarWenn}}" />
                                                        <TextBlock x:Name="RolleName" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <!-- Der Stern: nur an gewählten (und vom Admin eingetragenen) Rollen; gefüllt die erste Wahl -->
                                                <ToggleButton x:Name="ErsteWahlKnopf" Style="{StaticResource Umschalter}" Padding="5,2" MinHeight="24" MinWidth="28" Margin="4,0,0,0"
                                                              VerticalAlignment="Center" IsChecked="{Binding ErsteWahl}"
                                                              AutomationProperties.Name="{Binding Name, StringFormat='{}{0} als erste Wahl'}" gd:Hilfe.Text="{x:Static m:RollenWunsch.ErsteWahlHilfe}">
                                                    <Path x:Name="ErsteWahlStern" Data="{StaticResource Form.Stern}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.2"
                                                          Stroke="{StaticResource Pinsel.Hoeren}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ErsteWahl}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Pinsel.Hoeren}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </ToggleButton>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SternZeigen}" Value="False">
                                                    <Setter TargetName="ErsteWahlKnopf" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ein Knopf für Namen und Wünsche (E14); kein Hauptknopf, den hat in dieser Karte nur "Ja, als Funker" für Admins -->
                        <DockPanel Margin="0,8,8,4">
                            <Button x:Name="SpeichernKnopf" DockPanel.Dock="Left" Content="Speichern" MinWidth="104" Margin="0,0,12,0" VerticalAlignment="Center"
                                    Command="{Binding SpeichernCommand}" gd:Hilfe.Text="{x:Static m:MeinProfilViewModel.SpeichernHilfe}"
                                    gd:Hilfe.Gesperrt="{x:Static m:MeinProfilViewModel.SpeichernGesperrt}" />
                            <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding SpeichernHinweis}"
                                       Visibility="{Binding SpeichernHinweis, Converter={StaticResource SichtbarWennWert}}" />
                            <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Mit diesen Namen findet dich die Einsatzleitung; sie sieht auch deine Wünsche." />
                        </DockPanel>
                        <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding NamenFehler, Converter={StaticResource SichtbarWennWert}}">
                            <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding NamenFehler}" />
                        </Border>
                        <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding RollenFehler, Converter={StaticResource SichtbarWennWert}}">
                            <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding RollenFehler}" />
                        </Border>

                        <!-- S2 "Heute als Funker" (6.15): nur für Admins an Servern ab 0.5.0, statt einer zweiten Anmeldung -->
                        <StackPanel x:Name="FunkerKarte" DataContext="{Binding Funkermodus}" Margin="0,12,0,0" Visibility="{Binding Sichtbar, Converter={StaticResource SichtbarWenn}}">
                            <Border Height="1" Background="{StaticResource Pinsel.Linie}" Margin="0,0,0,12" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,8,0">
                                    <Button Content="Als Funker" Command="{Binding EinschaltenCommand}"
                                            Visibility="{Binding Aus, Converter={StaticResource SichtbarWenn}}" gd:Hilfe.Text="Heute als Funker; erst kommt eine Rückfrage mit den Folgen." />
                                    <Button Content="Wieder Admin" Command="{Binding WiederAdminCommand}" Visibility="{Binding An, Converter={StaticResource SichtbarWenn}}"
                                            gd:Hilfe.Text="Wieder Admin, sofort und ohne Code." />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Text.Abschnitt}" Text="{x:Static m:FunkermodusViewModel.Titel}" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Text="{x:Static m:FunkermodusViewModel.Erklaerung}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding StandText, StringFormat='Läuft: {0}'}"
                                               Visibility="{Binding StandText, Converter={StaticResource SichtbarWennWert}}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Warnung.Unterlage}" BorderBrush="{StaticResource Pinsel.Akzent}" BorderThickness="2" Margin="0,10,0,0" Padding="12,8"
                                    Visibility="{Binding HatRueckfrage, Converter={StaticResource SichtbarWenn}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource Knopf.Haupt}" Content="Ja, als Funker" Command="{Binding JaCommand}" gd:Hilfe.Text="Du funkst heute als Funker: Führung und Einteilen ruhen bis 04:00, die Verwaltung bleibt." Margin="0,0,8,0" />
                                        <Button Content="Abbrechen" Command="{Binding NeinCommand}" gd:Hilfe.Text="Lässt alles, wie es ist." />
                                    </StackPanel>
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding Rueckfrage}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding Fehler, Converter={StaticResource SichtbarWennWert}}">
                                <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding Fehler}" />
                            </Border>
                            <CheckBox Content="Beim Verbinden als Funker" IsChecked="{Binding BeimVerbinden}" Margin="0,10,0,0"
                                      gd:Hilfe.Text="Schaltet den Modus nach jedem Verbinden ein, einmal je Verbindung; nach &quot;Wieder Admin&quot; erst am nächsten Abend wieder. Auf diesem PC gespeichert." />
                        </StackPanel>
                    </StackPanel>

                    <!-- Erweitert unter Ich: Zeichen und Sichtbarkeit. Die zwei Schalter am Konto stehen hier, zählen aber nicht als selbst gestellt (E6). -->
                    <Expander x:Name="IchFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,4,0,0" Header="{Binding AbschnittIch.Feinheiten}"
                              Tag="{Binding AbschnittIch.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittIch.Feinheiten.Offen}">
                        <StackPanel x:Name="ZeichenKarte" Margin="0,0,8,0">
                            <StackPanel DataContext="{Binding MeinProfil}" MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Gruppe}" Text="An deinem Konto" Margin="0,2,0,4" />
                                <!-- Seit 0.11.7 heißt aus: alle aus, egal was unter Meine Abzeichen steht. -->
                                <CheckBox Content="Mein Zeichen anderen zeigen" IsChecked="{Binding ZeichenZeigen}" gd:Hilfe.Text="Zeigt dein Zeichen und deine Abzeichen bei den anderen neben deinem Namen. Aus heißt: alle aus, egal was unter Meine Abzeichen steht. Steht an deinem Konto, nicht auf diesem PC." />
                                <!--
                                  Meine Abzeichen (0.11.7, Sarevoc: "ein Abzeichen haben ist eine Sache, es zeigen eine eigene Entscheidung"): je eigenes Abzeichen Bild, Titel,
                                  die Wahl "vorn" (eine, auch keine) und der Haken "zeigen". Jede Änderung geht sofort an den Server.
                                -->
                                <StackPanel x:Name="MeineAbzeichenTeil" Margin="0,8,0,4">
                                    <TextBlock Style="{StaticResource Text.Etikett}" Text="Meine Abzeichen" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" TextWrapping="Wrap" Text="{x:Static m:MeinProfilViewModel.OhneAbzeichenText}"
                                               Visibility="{Binding OhneAbzeichen, Converter={StaticResource SichtbarWenn}}" />
                                    <ItemsControl x:Name="MeineAbzeichenListe" ItemsSource="{Binding MeineAbzeichen}" Focusable="False"
                                                  Visibility="{Binding HatAbzeichen, Converter={StaticResource SichtbarWenn}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MeinAbzeichen}">
                                                <DockPanel Margin="0,2,0,2">
                                                    <Image DockPanel.Dock="Left" Source="{Binding Bild}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"
                                                           AutomationProperties.Name="{Binding Titel}" />
                                                    <CheckBox DockPanel.Dock="Right" Content="zeigen" IsChecked="{Binding Zeigen}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                              AutomationProperties.Name="{Binding ZeigenAnsage}" gd:Hilfe.Text="{x:Static m:MeinProfilViewModel.ZeigenHilfe}" />
                                                    <CheckBox DockPanel.Dock="Right" Content="vorn" IsChecked="{Binding Vorn}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                              AutomationProperties.Name="{Binding VornAnsage}" gd:Hilfe.Text="{x:Static m:MeinProfilViewModel.VornHilfe}" />
                                                    <TextBlock Text="{Binding Titel}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- Seit der Gegenprüfung 0.11.5 ohne "Rollen": Wer ist da zeigt keine Karte mehr; Zeichen und Abzeichen schickt der Server Mitgliedern ohne Einsatzleitung nur mit diesem Häkchen (seit 0.11.8 ohne Untergilde). -->
                                <CheckBox IsChecked="{Binding KarteFreigeben}" Margin="0,4,0,0" gd:Hilfe.Text="Zeigt allen dein Zeichen und deine Abzeichen neben deinem Namen, in Wer ist da und im Funkfeld; ohne Häkchen nur der Einsatzleitung und den Admins. Steht an deinem Konto.">
                                    <TextBlock TextWrapping="Wrap" Text="Meine Angaben in Wer ist da zeigen: Zeichen und Abzeichen. Aus heißt: Andere sehen nur deinen Namen, ohne Zeichen und Abzeichen; die Einsatzleitung und Admins sehen weiter alles." />
                                </CheckBox>
                                <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding SchalterFehler, Converter={StaticResource SichtbarWennWert}}">
                                    <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Text="{Binding SchalterFehler}" />
                                </Border>
                                <TextBlock Style="{StaticResource Gruppe}" Text="Auf diesem PC" />
                                <CheckBox Content="Zeichen neben Namen sehen" IsChecked="{Binding ZeichenNebenNamen}" gd:Hilfe.Text="Zeigt dir die Zeichen der anderen neben ihren Namen, in Wer ist da und im Funkfeld. Ab Werk an." />
                                <!-- Bricht um: bei 640 Fensterbreite war die Zeile sonst rechts beschnitten (gemessen in AP3). -->
                                <CheckBox IsChecked="{Binding ZeichenImFunkfeld}" Margin="0,4,0,0" AutomationProperties.Name="Zeichen auch im Funkfeld"
                                          gd:Hilfe.Text="Zeigt die Zeichen auch im Funkfeld; ab Werk aus, damit es kompakt bleibt.">
                                    <TextBlock TextWrapping="Wrap" Text="Zeichen auch im Funkfeld (klein, ab Werk aus)" />
                                </CheckBox>

                                <!--
                                  Antwort 4: Führung und Einsatzleitung ergänzen den Katalog; entfernen und umbenennen nur der Admin. Seit dem Befund der Prüfung
                                  hier unter Erweitert statt offen in der Karte Ich (dort verdrängte er mit den Rollen alle Abschnitte aus dem Bild). Unter 440
                                  stehen Gruppe und "Hinzufügen" unter dem Namen (bei 640 Fensterbreite blieben dem Namen sonst gut 50). Die Tab-Reihenfolge folgt
                                  dem Lesen: Name, Gruppe, Knopf.
                                -->
                                <StackPanel x:Name="KatalogTeil" Visibility="{Binding KannErgaenzen, Converter={StaticResource SichtbarWenn}}">
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Rollenkatalog" />
                                    <TextBlock Style="{StaticResource Text.Etikett}" TextWrapping="Wrap" Text="Rolle zum Katalog hinzufügen (Führung, Einsatzleitung): Name, daneben die Gruppe" Margin="0,0,0,2" />
                                    <se:Spaltenwechsel Ab="440" Aufteilung="ZweiteNachInhalt" Luecke="8" Zeilenluecke="6">
                                        <TextBox MaxLength="40" Text="{Binding NeueRolle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Neue Rolle für den Katalog" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="150" MaxLength="20" Text="{Binding NeueGruppe, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Gruppe der neuen Rolle" ToolTip="Gruppe, etwa Flug, Geschütz, Technik, Boden, Orga" />
                                            <Button Content="Hinzufügen" Command="{Binding RolleErgaenzenCommand}" gd:Hilfe.Text="Nimmt die eingetragene Rolle in den Rollenkatalog auf." Margin="8,0,0,0" />
                                        </StackPanel>
                                    </se:Spaltenwechsel>
                                </StackPanel>
                            </StackPanel>
                            <ContentControl Content="{Binding AbschnittIch.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ============ Die übrigen Abschnitte (Bild m-4): je Kopf mit Kasten, darunter der Klappbereich Erweitert ============ -->
            <Border x:Name="AbschnitteKarte" Style="{StaticResource Karte}">
                <StackPanel x:Name="Abschnitte">

                    <!-- ================= Tasten (als erster Abschnitt ohne Linie darüber) ================= -->
                    <StackPanel x:Name="AbschnittTasten">
                        <ContentControl Content="{Binding AbschnittTasten}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                        <Expander x:Name="TastenFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,4,0,0" Header="{Binding AbschnittTasten.Feinheiten}"
                                  Tag="{Binding AbschnittTasten.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittTasten.Feinheiten.Offen}">
                            <StackPanel Margin="0,0,8,0">
                                <!-- A3, A5: globale Tasten, auch wenn das Spiel vorn ist; mehrere je Funktion -->
                                <StackPanel DataContext="{Binding Tasten}">
                                    <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,2,0,4"
                                               Text="{Binding ArtenText, StringFormat='Das Spiel bekommt die Tasten trotzdem. Belegbar: {0}. Mehrere Tasten je Funktion sind erlaubt.'}" />
                                    <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,4,0,4" Visibility="{Binding Verfuegbar, Converter={StaticResource SichtbarWennNicht}}">
                                        <TextBlock Style="{StaticResource Text.Warnung}" Text="Globale Tasten sind nicht verfügbar; Raw Input ließ sich nicht einrichten." />
                                    </Border>

                                    <TextBlock Style="{StaticResource Gruppe}" Text="Sprechtaste" />
                                    <ContentControl Content="{Binding Sprechen}" ContentTemplate="{StaticResource TastenZeileVorlage}" Focusable="False" />
                                    <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,4,0,4" Visibility="{Binding OhneSprechtaste, Converter={StaticResource SichtbarWenn}}">
                                        <TextBlock Style="{StaticResource Text.Warnung}" Text="Noch keine Sprechtaste belegt: In Kanälen auf Taste (etwa Global) geht dann nichts hinaus." />
                                    </Border>
                                    <ContentControl Content="{Binding Nachlauf}" ContentTemplate="{StaticResource NachlaufVorlage}" Focusable="False" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,8,0,0" Text="{x:Static m:TastenViewModel.SpielHinweis}" />

                                    <TextBlock Style="{StaticResource Gruppe}" Text="Kanal und Melde-Taste" />
                                    <ItemsControl ItemsSource="{Binding KanalTasten}" Style="{StaticResource Liste}" ItemTemplate="{StaticResource TastenZeileVorlage}" />
                                    <!-- S2: wohin die Melde-Taste spricht (RAID-S2-ENTWURF Abschnitt 4) -->
                                    <se:Spaltenwechsel Margin="0,8,0,0" Ab="{x:Static m:EinstellungenViewModel.TastenZeileNebeneinanderAb}" Aufteilung="ErsteFest" ErsteBreite="190"
                                                       Luecke="0" Zeilenluecke="4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource Text.Wert}" FontWeight="SemiBold" Text="Melde-Taste spricht in" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" Text="Ohne Wahl in Kommando." />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding Meldenetze}" SelectedItem="{Binding GewaehltesMeldenetz}" ItemTemplate="{StaticResource NameVorlage}"
                                                  MaxWidth="320" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Melde-Taste spricht in" />
                                    </se:Spaltenwechsel>

                                    <TextBlock Style="{StaticResource Gruppe}" Text="Weitere Tasten" />
                                    <ItemsControl ItemsSource="{Binding WeitereTasten}" Style="{StaticResource Liste}" ItemTemplate="{StaticResource TastenZeileVorlage}" />

                                    <!-- S2: Phasen schalten, nur mit Einsatzleitung (ZUWEISEN); seit 0.10.0 nur dann zu sehen (E18) -->
                                    <StackPanel x:Name="EinsatzleitungTasten" Visibility="{Binding LeitungSichtbar, Converter={StaticResource SichtbarWenn}}">
                                        <TextBlock Style="{StaticResource Gruppe}" Text="Einsatzleitung" />
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,0,0,6"
                                                   Text="Wirken nur, solange du die Einsatzleitung hast. Ohne Einsatzleitung bleibt ein Druck ohne Folge." />
                                        <ItemsControl ItemsSource="{Binding Leitung}" Style="{StaticResource Liste}" ItemTemplate="{StaticResource TastenZeileVorlage}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,8,0,0" Text="{Binding Hinweis}"
                                               Visibility="{Binding Hinweis, Converter={StaticResource SichtbarWennWert}}" />
                                </StackPanel>

                                <!--
                                  Funk-Klick (A11, A63; seit 0.10.0 hier, bis 0.9.3 eine Karte im Bereich Audio): eigene Taste und andere Sprecher je an oder aus
                                  mit Lautstärke, bei Sprachaktivierung dezent oder aus, Anhören. Ohne Zugriffstasten, bedienbar mit Tab und Leertaste.
                                -->
                                <TextBlock Style="{StaticResource Gruppe}" Text="Funk-Klick" />
                                <Border x:Name="KlickKarte" DataContext="{Binding Audio.Klick}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Text="{x:Static m:KlickViewModel.Erklaerung}" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <StackPanel Width="300" Margin="0,8,24,0">
                                                <CheckBox IsChecked="{Binding EigeneAn}" AutomationProperties.Name="Klick bei deiner Taste"
                                                          gd:Hilfe.Text="Spielt ein kurzes Rauschen, wenn du deine Sprechtaste oder Melde-Taste drückst und loslässt, auch am Joystick.">
                                                    <StackPanel>
                                                        <TextBlock Text="Bei deiner Taste" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Text.Hinweis}" Text="Drücken und Loslassen: Sprechtaste, Melde-Taste, Joystick." />
                                                    </StackPanel>
                                                </CheckBox>
                                                <DockPanel Margin="0,8,0,0" IsEnabled="{Binding EigeneAn}">
                                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Pinsel.Text}" FontWeight="SemiBold" Text="{Binding EigeneText}" />
                                                    <TextBlock Style="{StaticResource Text.Etikett}" Text="Lautstärke" />
                                                </DockPanel>
                                                <Slider Minimum="-30" Maximum="-6" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Value="{Binding EigeneDb}" IsEnabled="{Binding EigeneAn}" AutomationProperties.Name="Lautstärke des Klicks bei deiner Taste" />
                                                <!-- C1 (Q6): Über Lautsprecher spielt der eigene Klick nicht; die anderen hören ihn weiter. -->
                                                <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding EigenerKlickHinweis}"
                                                           Visibility="{Binding EigenerKlickHinweis, Converter={StaticResource SichtbarWennWert}}" />
                                            </StackPanel>
                                            <StackPanel Width="300" Margin="0,8,0,0">
                                                <CheckBox IsChecked="{Binding AndereAn}" AutomationProperties.Name="Klick bei anderen Sprechern"
                                                          gd:Hilfe.Text="Spielt ein kurzes Rauschen, wenn jemand anderes zu sprechen beginnt oder aufhört.">
                                                    <StackPanel>
                                                        <TextBlock Text="Bei anderen Sprechern" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Text.Hinweis}" Text="Wenn jemand zu sprechen beginnt und aufhört." />
                                                    </StackPanel>
                                                </CheckBox>
                                                <DockPanel Margin="0,8,0,0" IsEnabled="{Binding AndereAn}">
                                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Pinsel.Text}" FontWeight="SemiBold" Text="{Binding AndereText}" />
                                                    <TextBlock Style="{StaticResource Text.Etikett}" Text="Lautstärke" />
                                                </DockPanel>
                                                <Slider Minimum="-30" Maximum="-6" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Value="{Binding AndereDb}" IsEnabled="{Binding AndereAn}" AutomationProperties.Name="Lautstärke des Klicks bei anderen Sprechern" />
                                                <CheckBox IsChecked="{Binding BeiSprachaktivierung}" IsEnabled="{Binding AndereAn}" Margin="0,8,0,0"
                                                          AutomationProperties.Name="Bei Sprachaktivierung dezent"
                                                          gd:Hilfe.Text="Klickt leiser, wenn jemand per Sprachaktivierung spricht; ohne Häkchen klickt es dann gar nicht."
                                                          gd:Hilfe.Gesperrt="Geht nur, wenn der Klick bei anderen Sprechern an ist.">
                                                    <StackPanel>
                                                        <TextBlock Text="Bei Sprachaktivierung dezent" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Text.Hinweis}"
                                                                   Text="Spricht jemand per Sprachaktivierung, klickt es 18 dB leiser; ausgeschaltet gar nicht." />
                                                    </StackPanel>
                                                </CheckBox>
                                            </StackPanel>
                                        </WrapPanel>
                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Anhören" Command="{Binding AnhoerenCommand}" Margin="0,0,12,0" VerticalAlignment="Top"
                                                    AutomationProperties.Name="Funk-Klick anhören"
                                                    gd:Hilfe.Text="Spielt den Klick mit deinen jetzigen Einstellungen vor. Dafür muss die Wiedergabe laufen." />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" VerticalAlignment="Center" Text="{Binding Hinweis}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl Content="{Binding AbschnittTasten.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ================= Empfangen ================= -->
                    <Border Style="{StaticResource Abschnitt.Trenner}">
                        <StackPanel x:Name="AbschnittEmpfangen">
                            <ContentControl Content="{Binding AbschnittEmpfangen}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                            <Expander x:Name="EmpfangenFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,4,0,0" Header="{Binding AbschnittEmpfangen.Feinheiten}"
                                      Tag="{Binding AbschnittEmpfangen.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittEmpfangen.Feinheiten.Offen}">
                                <!-- Viele Glasknöpfe (Hören auf je Kanal): einfacher Schatten, gemessen in OberflaecheGlasTests.Glas_Renderzeit_SchattenJeSeite -->
                                <StackPanel Margin="0,0,8,0" gd:Glas.Schatten="Einfach">
                                    <!--
                                      Je Kanal (bis 0.9.3 unter Meine Kanäle): zwei Zeilen je Feld, oben die Nummer und der ganze Kanalname mit Ch. (er bricht um),
                                      unten hören, Hören auf und Lautstärke; die untere Zeile bricht bei schmalem Fenster selbst um. Ohne VA/Taste (E16): Womit ein
                                      Kanal sendet, stellt man im Funkfeld ein. Hören steht am Server, Hören auf und Lautstärke nur auf diesem PC.
                                    -->
                                    <Border x:Name="FelderKarte" DataContext="{Binding Netze}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Je Kanal" Margin="0,2,0,4" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,0,0,8"
                                                       Text="Ob du einen Kanal hörst, auf welcher Seite und wie laut. Die Rolle und den Ch. wählst du im Funkfeld, ebenso ob ein Kanal mit Sprachaktivierung (VA) oder Taste sendet." />
                                            <ItemsControl ItemsSource="{Binding Felder}" Style="{StaticResource Liste}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource Text.Etikett}" Text="{Binding FeldText}" />
                                                                <TextBlock x:Name="KanalName" Grid.Column="1" Style="{StaticResource Text.Wert}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Kanal}" />
                                                                <Border Grid.Column="2" CornerRadius="3" Padding="6,1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                        Background="{StaticResource Pinsel.Senden}" Visibility="{Binding Sendet, Converter={StaticResource SichtbarWenn}}">
                                                                    <TextBlock Text="SENDET" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Pinsel.AufFarbe}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Etikett}" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                           Text="{Binding ZustandText}" Visibility="{Binding Sendet, Converter={StaticResource SichtbarWennNicht}}" />
                                                            </Grid>
                                                            <WrapPanel Margin="28,2,0,0">
                                                                <CheckBox IsChecked="{Binding Hoeren}" Content="hören" Margin="0,0,16,3" VerticalAlignment="Center"
                                                                          gd:Hilfe.Text="Schaltet diesen Kanal für dich stumm oder wieder hörbar. Steht am Server, gilt also auch auf einem anderen PC."
                                                                          AutomationProperties.Name="{Binding Netz, StringFormat='{}{0} hören'}" />
                                                                <ContentControl Content="{Binding Ohr}" ContentTemplate="{StaticResource OhrVorlage}" Focusable="False" />
                                                                <ContentControl Content="{Binding Regelung}" ContentTemplate="{StaticResource LautstaerkeVorlage}" Focusable="False" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,0,0,4" Text="Noch keine Kanäle: Sie kommen mit der Verbindung und deiner Rolle.">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Hinweis}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Felder.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel x:Name="GlobalZeile" Margin="0,4,0,0" Visibility="{Binding GlobalOhr, Converter={StaticResource SichtbarWennWert}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Global}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Stroke="{StaticResource Pinsel.Text2}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Wert}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding GlobalOhr.Netz}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Etikett}" Margin="12,0,0,0" Text="hört immer" />
                                                </Grid>
                                                <WrapPanel Margin="28,2,0,0">
                                                    <ContentControl Content="{Binding GlobalOhr}" ContentTemplate="{StaticResource OhrVorlage}" Focusable="False" />
                                                    <ContentControl Content="{Binding GlobalRegelung}" ContentTemplate="{StaticResource LautstaerkeVorlage}" Focusable="False" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Je Person (A4): am Konto gespeichert, gilt in allen Kanälen -->
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Je Person" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,0,0,8" Text="Gilt in allen Kanälen und wird am Konto gespeichert." />
                                            <ItemsControl x:Name="FunkerListe" ItemsSource="{Binding Funker}" Style="{StaticResource Liste}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!--
                                                          Seit 0.10.0 (AP3) zwei Spalten, die im schmalen Fenster untereinander rutschen: links Name und Platz, rechts Regler und Wert.
                                                          Unter Empfangen > Erweitert ist es enger als auf der alten Seite Meine Kanäle; die vier festen Spalten (mindestens 390) ragten
                                                          bei 700 über die Karte. Der Regler behält mindestens 100 (Prüfung der Regler, 02.10.2026). Herleitung der Grenze in
                                                          EinstellungenViewModel.PersonZeileNebeneinanderAb.
                                                        -->
                                                        <se:Spaltenwechsel Margin="0,3" Ab="{x:Static m:EinstellungenViewModel.PersonZeileNebeneinanderAb}" Aufteilung="ErsteFest"
                                                                           ErsteBreite="300" Luecke="12" Zeilenluecke="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="160" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Klangstufe C2b: gelbes "!" an einem Dauersender, rechts im Namensfeld (die Namen bleiben bündig) -->
                                                                <DockPanel>
                                                                    <se:Klappwahl x:Name="DauersendZeichen" DockPanel.Dock="Right" Style="{StaticResource Klappwahl.Ausrufe}" Margin="4,0,8,0"
                                                                                  DataContext="{Binding Dauersend}" Visibility="{Binding Converter={StaticResource SichtbarWennWert}}" />
                                                                    <TextBlock Style="{StaticResource Text.Wert}" FontWeight="SemiBold" Text="{Binding Name}" />
                                                                </DockPanel>
                                                                <!-- Der Platz bricht um statt gekürzt zu werden, etwa "Kapitän, Schiff 2" (NichtsAbgeschnitten). -->
                                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Etikett}" Text="{Binding Platz}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Etikett}" Text="{Binding PegelText}" Width="56" TextAlignment="Right" Margin="8,0,0,0" />
                                                                <Slider MinWidth="100" Minimum="-30" Maximum="12" SmallChange="0.5" LargeChange="3" Value="{Binding PegelDb}"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat='Pegel für {0}'}" />
                                                            </DockPanel>
                                                        </se:Spaltenwechsel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Gerade ist niemand sonst online.">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Hinweis}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Funker.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" Margin="0,6,0,0" Text="{Binding Hinweis}"
                                                       Visibility="{Binding Hinweis, Converter={StaticResource SichtbarWennWert}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Klangstufe C2b (Q1, Q2, Q13, Q26): Auto Dauersend-Dämpfung, ab Werk an, und die Stufe in Wörtern; "Leises Reden aussperren" ist weg (E15). -->
                                    <StackPanel x:Name="DaempfungKarte" DataContext="{Binding Audio}">
                                        <TextBlock Style="{StaticResource Gruppe}" Text="Dauersender" />
                                        <CheckBox x:Name="DaempfungSchalter" IsChecked="{Binding DaempfungAn}" AutomationProperties.Name="Auto Dauersend-Dämpfung"
                                                  gd:Hilfe.Text="{x:Static m:AudioViewModel.DaempfungHilfe}">
                                            <StackPanel>
                                                <TextBlock Text="Auto Dauersend-Dämpfung" />
                                                <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.DaempfungErklaerung}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Margin="50,0,0,0">
                                            <TextBlock Style="{StaticResource Text.Etikett}" TextWrapping="Wrap" Text="Andere Dauersender bei dir höchstens" Margin="0,6,0,4" />
                                            <WrapPanel IsEnabled="{Binding DaempfungAn}">
                                                <RadioButton x:Name="StufeEtwasLeiserKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Daempfung" Content="etwas leiser" Margin="0,0,6,6"
                                                             IsChecked="{Binding StufeEtwasLeiser}" AutomationProperties.Name="Dauersender höchstens etwas leiser"
                                                             gd:Hilfe.Text="{x:Static m:AudioViewModel.EtwasLeiserHilfe}" gd:Hilfe.Gesperrt="{x:Static m:AudioViewModel.StufeGesperrt}" />
                                                <RadioButton x:Name="StufeDeutlichLeiserKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Daempfung" Content="deutlich leiser" Margin="0,0,6,6"
                                                             IsChecked="{Binding StufeDeutlichLeiser}" AutomationProperties.Name="Dauersender höchstens deutlich leiser"
                                                             gd:Hilfe.Text="{x:Static m:AudioViewModel.DeutlichLeiserHilfe}" gd:Hilfe.Gesperrt="{x:Static m:AudioViewModel.StufeGesperrt}" />
                                                <RadioButton x:Name="StufeFastWegKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Daempfung" Content="fast weg" Margin="0,0,6,6"
                                                             IsChecked="{Binding StufeFastWeg}" AutomationProperties.Name="Dauersender bis fast weg"
                                                             gd:Hilfe.Text="{x:Static m:AudioViewModel.FastWegHilfe}" gd:Hilfe.Gesperrt="{x:Static m:AudioViewModel.StufeGesperrt}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding DaempfungText}" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Gruppe}" Text="Pegelausgleich" />
                                        <CheckBox x:Name="PegelausgleichSchalter" IsChecked="{Binding Pegelausgleich}" AutomationProperties.Name="Pegelausgleich"
                                                  gd:Hilfe.Text="{x:Static m:AudioViewModel.PegelausgleichHilfe}">
                                            <StackPanel>
                                                <TextBlock Text="Pegelausgleich" />
                                                <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.PegelausgleichErklaerung}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                    <ContentControl Content="{Binding AbschnittEmpfangen.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!--
                      ================= Senden (Bild m-5; seit 0.11.1 nach Sarevocs Vorgabe vom 12.10.2026) =================
                      "Auch wenn wir das prinzipiell so lassen, muss das Senden, insbesondere die Funk-Schwelle und die Schiebe-Buttons, wo Rauschunterdrückung
                      usw. einzustellen ist, wieder sichtbar sein." Darum offen, ohne Aufklappen: die Schiebeschalter der Klangmodule mit ihren kurzen
                      Erklärungen in der Reihenfolge von 0.9.3 (Seite Audio, Karte Klangmodule, Spalte Senden) und die Funkschwelle, der Pegelbalken mit
                      seinen Griffen (Mindest-Funklautstärke und Obergrenze), "Einmessen" und "Genau einstellen ...". Unter Erweitert steht, was selten
                      jemand anfasst: die feste Verstärkung (gilt nur ohne automatische Lautstärke), Mithören und die Klangfarbe. Bis 0.11.0 stand alles im
                      Klappbereich.
                    -->
                    <Border Style="{StaticResource Abschnitt.Trenner}">
                        <StackPanel x:Name="AbschnittSenden">
                            <ContentControl Content="{Binding AbschnittSenden}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                            <!--
                              Zwei Spalten (Spaltenwechsel, unter SendenZweiSpaltenAb untereinander), in der Reihenfolge von 0.9.3 erst links, dann rechts:
                              links Echounterdrückung, Echoschutz und Rauschunterdrückung, rechts automatische Lautstärke, Sprachaktivierung und
                              Mindest-Funklautstärke; darunter über beide die Funkschwelle. Rechts 8 Luft: "Einmessen" steht bündig rechts, und sein Schatten
                              reicht darüber hinaus (Prüfbericht Mischung, wf7-3 Punkt 10). Links ebenso 8 Luft für die Schatten von "Automatisch" und "Genau
                              einstellen ...": Der Abschnitt bekommt nach dem Runden auf Bildpunkte einen Rand, der links bei 0 abschneidet (gemessen in 0.11.1
                              bei offenem Erweitert: 0,6 Einheiten Höhe zu wenig; Schatten links 5 und 6,5); bis 0.11.0 lag alles 21 eingerückt im Klappbereich.
                              Keine neuen Zugriffstasten: R wie bisher.
                            -->
                            <se:Spaltenwechsel x:Name="SendenSpalten" Margin="8,8,8,6" Ab="{x:Static m:EinstellungenViewModel.SendenZweiSpaltenAb}" Luecke="24" Zeilenluecke="10"
                                               DataContext="{Binding Audio}">
                                <!-- links: Echounterdrückung, Echoschutz, Rauschunterdrückung -->
                                <StackPanel x:Name="SendenSpalteKlang">
                                    <!--
                                      E11: dreistufig; Automatisch folgt Headset oder Lautsprecher auf Start. Name und Satz wie der Schalter bis 0.9.3, der
                                      ausführliche Hovertext an Name und Satz, die drei Knöpfe mit je eigenem.
                                    -->
                                    <StackPanel x:Name="EchounterdrueckungKopf" Background="Transparent" gd:Hilfe.Text="{x:Static m:AudioViewModel.EchounterdrueckungHilfe}">
                                        <TextBlock Text="Echounterdrückung" Foreground="{StaticResource Pinsel.Text}" />
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Text="{x:Static m:AudioViewModel.EchounterdrueckungErklaerung}" />
                                    </StackPanel>
                                    <WrapPanel x:Name="EchounterdrueckungWahl" Margin="0,6,0,0">
                                        <RadioButton x:Name="EchoAutomatischKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Echounterdrueckung" Content="Automatisch" Margin="0,0,6,6"
                                                     IsChecked="{Binding EchoAutomatisch}" AutomationProperties.Name="Echounterdrückung automatisch" gd:Hilfe.Text="{x:Static m:AudioViewModel.EchoAutomatischHilfe}" />
                                        <RadioButton x:Name="EchoAnKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Echounterdrueckung" Content="An" Margin="0,0,6,6"
                                                     IsChecked="{Binding EchoAn}" AutomationProperties.Name="Echounterdrückung an" gd:Hilfe.Text="{x:Static m:AudioViewModel.EchoAnHilfe}" />
                                        <RadioButton x:Name="EchoAusKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Echounterdrueckung" Content="Aus" Margin="0,0,6,6"
                                                     IsChecked="{Binding EchoAus}" AutomationProperties.Name="Echounterdrückung aus" gd:Hilfe.Text="{x:Static m:AudioViewModel.EchoAusHilfe}" />
                                    </WrapPanel>
                                    <TextBlock x:Name="EchoHinweisText" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{Binding EchoHinweis}" />

                                    <CheckBox x:Name="EchoschutzSchalter" IsChecked="{Binding Echoschutz}" Margin="0,12,0,0" AutomationProperties.Name="Echoschutz"
                                              gd:Hilfe.Text="{x:Static m:AudioViewModel.EchoschutzHilfe}">
                                        <StackPanel>
                                            <TextBlock Text="Echoschutz" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.EchoschutzErklaerung}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock x:Name="EchoschutzWarnungText" TextWrapping="Wrap" Margin="50,2,0,0" Foreground="{StaticResource Pinsel.RotSchrift}"
                                               Text="{x:Static m:AudioViewModel.EchoschutzWarnung}" Visibility="{Binding Echoschutz, Converter={StaticResource SichtbarWennNicht}}" />

                                    <!-- Klangstufe B: genau ein Rauschfilter, ab Werk Standard (RNNoise); Stark (DeepFilterNet3) fällt bei zu wenig Rechenzeit zurück. -->
                                    <CheckBox x:Name="RauschunterdrueckungSchalter" IsChecked="{Binding Rauschunterdrueckung}" Margin="0,12,0,0" AutomationProperties.Name="Rauschunterdrückung"
                                              gd:Hilfe.Text="{x:Static m:AudioViewModel.RauschunterdrueckungHilfe}">
                                        <StackPanel>
                                            <AccessText Text="_Rauschunterdrückung" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.RauschunterdrueckungErklaerung}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <WrapPanel Margin="50,4,0,0" IsEnabled="{Binding Rauschunterdrueckung}">
                                        <RadioButton x:Name="RauschfilterStandardKnopf" Style="{StaticResource Umschalter.Radio}" GroupName="Rauschfilter" Content="Standard" Margin="0,0,6,6"
                                                     IsChecked="{Binding RauschfilterStandard}" AutomationProperties.Name="Rauschfilter Standard" gd:Hilfe.Text="{x:Static m:AudioViewModel.StandardHilfe}" />
                                        <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="Rauschfilter" Content="Stark" Margin="0,0,6,6"
                                                     IsChecked="{Binding RauschfilterStark}" AutomationProperties.Name="Rauschfilter Stark" gd:Hilfe.Text="{x:Static m:AudioViewModel.StarkHilfe}" />
                                    </WrapPanel>
                                    <TextBlock x:Name="RauschfilterHinweisText" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="50,2,0,0" Text="{Binding RauschfilterHinweis}" />
                                </StackPanel>

                                <!-- rechts: automatische Lautstärke, Sprachaktivierung, Mindest-Funklautstärke -->
                                <StackPanel x:Name="SendenSpalteSchwelle">
                                    <!--
                                      Klangstufe A: automatische Lautstärke (Halteregel). Die feste Verstärkung, die ohne sie gilt, misst man unter Erweitert ein
                                      (FesteVerstaerkungTeil); ist die Automatik aus, sagt der Satz darunter, wo. Ohne Zugriffstasten.
                                    -->
                                    <StackPanel x:Name="LautstaerkeTeil" DataContext="{Binding Lautstaerke}">
                                        <CheckBox IsChecked="{Binding Automatisch}" AutomationProperties.Name="Automatische Lautstärke"
                                                  gd:Hilfe.Text="{x:Static m:AudioViewModel.AutomatikHilfe}">
                                            <StackPanel>
                                                <TextBlock Text="Automatische Lautstärke" />
                                                <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.AutomatikErklaerung}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock x:Name="AutomatikAusHinweis" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="50,2,0,0"
                                                   Text="{x:Static m:EinstellungenViewModel.AutomatikAusSatz}" Visibility="{Binding Automatisch, Converter={StaticResource SichtbarWennNicht}}" />
                                    </StackPanel>
                                    <!-- Das Klangmodul Sprachaktivierung, derselbe Schalter wie "Senden mit Stimme" auf Start (Q48) -->
                                    <CheckBox x:Name="SprachaktivierungSchalter" IsChecked="{Binding SprachaktivierungAn}" Margin="0,12,0,0" AutomationProperties.Name="Sprachaktivierung"
                                              gd:Hilfe.Text="{x:Static m:AudioViewModel.SprachaktivierungHilfe}">
                                        <StackPanel>
                                            <TextBlock Text="Sprachaktivierung" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.SprachaktivierungErklaerung}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="MindestSchalter" IsChecked="{Binding MindestFunklautstaerke}" Margin="0,12,0,0" AutomationProperties.Name="Mindest-Funklautstärke"
                                              gd:Hilfe.Text="{x:Static m:AudioViewModel.MindestHilfe}">
                                        <StackPanel>
                                            <TextBlock Text="Mindest-Funklautstärke" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:AudioViewModel.MindestErklaerung}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>

                                <!--
                                  Unten über beide Spalten die Funkschwelle (bis 0.9.3 die Karte Pegel auf der Seite Audio, bis 0.11.0 im Klappbereich): Griffe
                                  und Einmessen an EINER Stelle (Endfassung, Klangstufe C1, Q17, Q18), der Balken mit dem Korridor (18 hoch, darüber und darunter je
                                  9 für Linien und Griffe; linker Griff Mindest-Funklautstärke, rechter Obergrenze), daneben "Einmessen", darunter "Genau einstellen
                                  ...". Über die ganze Breite, damit die Griffe auch in Klein Platz haben (in der rechten Spalte blieben dem Balken bei 900 nur 122).
                                -->
                                <StackPanel x:Name="SendenFunkschwelle">
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Funkschwelle" Margin="0,4,0,6" />
                                    <DockPanel>
                                        <Button x:Name="AudioEinmessenKnopf" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                                Content="{Binding Korridor.EinmessKnopfKurz}" Command="{Binding Korridor.EinmessenCommand}"
                                                AutomationProperties.Name="Mindestlautstärke einmessen"
                                                gd:Hilfe.Text="{x:Static m:KorridorViewModel.HilfeEinmessen}"
                                                gd:Hilfe.Gesperrt="{Binding Korridor.EinmessenGesperrt}" />
                                        <se:Pegelbalken x:Name="AudioPegel" Height="36" PegelDb="{Binding PegelDbfs}" SchwelleDb="{Binding SchwelleDb}" Sendet="{Binding Sendet}"
                                                        WuerdeSenden="{Binding WuerdeSenden}" Korridor="{Binding Korridor}" Stumm="{Binding Stumm}" Hinweis="{Binding NichtsGesendet}"
                                                        HinweisImBalken="False" AutomationProperties.Name="Eingangspegel" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Korridor.ZeileText}"
                                               Visibility="{Binding Korridor.ZeileText, Converter={StaticResource SichtbarWennWert}}" />
                                    <TextBlock x:Name="GriffeSatzText" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="{x:Static m:EinstellungenViewModel.GriffeSatz}" />

                                    <!-- E3: öffnet die Seite Sprachaktivierung mit Schwelle und Korridor; ohne den Unterpunkt gesperrt mit Grund. Ohne Zugriffstaste. -->
                                    <StackPanel x:Name="SendenSprachaktivierung" Margin="0,10,0,0">
                                        <Button x:Name="GenauEinstellenKnopf" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.SprachaktivierungEinstellenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                AutomationProperties.Name="Sprachaktivierung genau einstellen" gd:Hilfe.Text="{x:Static m:EinstellungenViewModel.GenauEinstellenHilfe}"
                                                gd:Hilfe.Taste="Strg+T" gd:Hilfe.Gesperrt="{x:Static m:HauptViewModel.SprachaktivierungGesperrt}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Schwelle}" Width="16" Height="16" Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Genau einstellen ..." />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static m:EinstellungenViewModel.GenauEinstellenSatz}" />
                                    </StackPanel>
                                </StackPanel>
                            </se:Spaltenwechsel>

                            <!--
                              Erweitert unter Senden (seit 0.11.1): was selten jemand anfasst. Zwei Spalten wie oben, darunter der Fuß über beide: links die feste
                              Verstärkung (gilt nur ohne automatische Lautstärke, "Nur ohne Automatik nötig.") und Mithören (nur mit Headset, nach jedem Neustart
                              aus), rechts die Klangfarbe. Gezählt werden Mithören und Klangfarbe, nicht die offenen Schalter darüber und seit Q117
                              (Sarevoc 13.10.2026) auch nicht die Seite Sprachaktivierung, die ihre eigenen Standardwerte hat; die feste Verstärkung ist
                              eingemessen, nicht gestellt.
                            -->
                            <Expander x:Name="SendenFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,2,0,0" Header="{Binding AbschnittSenden.Feinheiten}"
                                      Tag="{Binding AbschnittSenden.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittSenden.Feinheiten.Offen}">
                                <se:Spaltenwechsel x:Name="SendenErweitertSpalten" Margin="0,0,8,0" Ab="{x:Static m:EinstellungenViewModel.SendenZweiSpaltenAb}" Luecke="24"
                                                   Zeilenluecke="10" DataContext="{Binding Audio}">
                                    <!-- links: feste Verstärkung und Mithören -->
                                    <StackPanel x:Name="SendenErweitertLinks">
                                        <!--
                                          Seit dem Befund der Prüfung wie in m-5: "Feste Verstärkung einmessen" (neben dem Pegelbalken heißt das Einmessen der
                                          Mindest-Funklautstärke "Einmessen") und mit Automatik gesperrt mit Grund, darunter "Nur ohne Automatik nötig."
                                        -->
                                        <StackPanel x:Name="FesteVerstaerkungTeil" DataContext="{Binding Lautstaerke}">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Feste Verstärkung" Margin="0,2,0,4" />
                                            <Button x:Name="FestEinmessenKnopf" Command="{Binding EinmessenCommand}" Content="{Binding EinmessKnopf}" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                    AutomationProperties.Name="Feste Verstärkung einmessen"
                                                    gd:Hilfe.Text="Misst acht Sekunden deine Stimme und legt daraus die feste Verstärkung fest; sie gilt, wenn die automatische Lautstärke aus ist. Ein zweiter Klick bricht ab."
                                                    gd:Hilfe.Gesperrt="{Binding EinmessenGesperrt}" />
                                            <TextBlock x:Name="FestEinmessenHinweis" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding EinmessHinweisText}" />
                                            <TextBlock Foreground="{StaticResource Pinsel.Text}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding EinmessText}"
                                                       Visibility="{Binding EinmessText, Converter={StaticResource SichtbarWennWert}}" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding FestText}" />
                                        </StackPanel>

                                        <!-- Mithören beim Senden (nur mit Headset); seit 0.10.0 hier statt bei der Hörprobe (E19) -->
                                        <StackPanel DataContext="{Binding Hoerprobe}">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Kontrolle" />
                                            <CheckBox x:Name="MithoerenSchalter" IsChecked="{Binding Mithoeren}" IsEnabled="{Binding KannMithoeren}" AutomationProperties.Name="Beim Senden mithören"
                                                      gd:Hilfe.Text="{x:Static m:EinstellungenViewModel.MithoerenHilfe}"
                                                      gd:Hilfe.Gesperrt="Mithören geht nur mit Headset: Über Lautsprecher käme deine Stimme verzögert zurück ins Mikrofon.">
                                                <StackPanel>
                                                    <TextBlock Text="Beim Senden mithören" />
                                                    <TextBlock x:Name="MithoerenHinweis" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{Binding MithoerenText}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- rechts: die Klangfarbe -->
                                    <StackPanel x:Name="SendenErweitertRechts">
                                        <!--
                                          Klangfarbe (Q70 bis Q72, 0.9.3): Wärme, Klarheit und Schärfe je -6 bis +6 dB in ganzen dB, ab Werk neutral, "Zurück auf neutral".
                                          Die Namen stehen über den Reglern (Prüfung 0.9.3), die Regler sind zweiseitig. Seit 0.10.0 ohne eigenen Klappbereich (m-5).
                                        -->
                                        <StackPanel x:Name="KlangfarbeTeil" DataContext="{Binding Klangfarbe}">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Klangfarbe" Margin="0,2,0,4" />
                                            <TextBlock x:Name="KlangfarbeErklaerung" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Text="{x:Static m:KlangfarbeTeil.Erklaerung}" />
                                            <TextBlock Style="{StaticResource Text.Etikett}" Text="Wärme" />
                                            <DockPanel>
                                                <TextBlock x:Name="WaermeWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding WaermeText}" Width="44" TextAlignment="Right" />
                                                <Slider x:Name="WaermeRegler" Style="{StaticResource Regler.Zweiseitig}" Minimum="-6" Maximum="6" SmallChange="1" LargeChange="2"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Waerme}" AutomationProperties.Name="Wärme der Klangfarbe in dB"
                                                        gd:Hilfe.Text="{x:Static m:KlangfarbeTeil.WaermeHilfe}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Text.Etikett}" Text="Klarheit" Margin="0,6,0,0" />
                                            <DockPanel>
                                                <TextBlock x:Name="KlarheitWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding KlarheitText}" Width="44" TextAlignment="Right" />
                                                <Slider x:Name="KlarheitRegler" Style="{StaticResource Regler.Zweiseitig}" Minimum="-6" Maximum="6" SmallChange="1" LargeChange="2"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Klarheit}" AutomationProperties.Name="Klarheit der Klangfarbe in dB"
                                                        gd:Hilfe.Text="{x:Static m:KlangfarbeTeil.KlarheitHilfe}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Text.Etikett}" Text="Schärfe" Margin="0,6,0,0" />
                                            <DockPanel>
                                                <TextBlock x:Name="SchaerfeWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding SchaerfeText}" Width="44" TextAlignment="Right" />
                                                <Slider x:Name="SchaerfeRegler" Style="{StaticResource Regler.Zweiseitig}" Minimum="-6" Maximum="6" SmallChange="1" LargeChange="2"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Schaerfe}" AutomationProperties.Name="Schärfe der Klangfarbe in dB"
                                                        gd:Hilfe.Text="{x:Static m:KlangfarbeTeil.SchaerfeHilfe}" />
                                            </DockPanel>
                                            <Button x:Name="KlangfarbeZurueck" HorizontalAlignment="Left" Margin="0,10,0,4" Command="{Binding ZurueckCommand}" Content="Zurück auf neutral"
                                                    gd:Hilfe.Text="{x:Static m:KlangfarbeTeil.ZurueckHilfe}" gd:Hilfe.Gesperrt="Steht schon auf neutral."
                                                    AutomationProperties.Name="Klangfarbe zurück auf neutral" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- unten über beide Spalten: Zurück auf Werkseinstellung -->
                                    <ContentControl Content="{Binding DataContext.AbschnittSenden.Feinheiten, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                    ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                                </se:Spaltenwechsel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- ================= Funkfeld und Darstellung ================= -->
                    <Border Style="{StaticResource Abschnitt.Trenner}">
                        <StackPanel x:Name="AbschnittFunkfeld">
                            <ContentControl Content="{Binding AbschnittFunkfeld}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                            <Expander x:Name="FunkfeldFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,4,0,0" Header="{Binding AbschnittFunkfeld.Feinheiten}"
                                      Tag="{Binding AbschnittFunkfeld.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittFunkfeld.Feinheiten.Offen}">
                                <StackPanel Margin="0,0,8,0">
                                    <!-- Funkfeld: ohne 5/10 und Raster/Liste (#74, #75: die stehen im Funkfeld selbst) -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Funkfeld" Margin="0,2,0,4" />
                                    <!-- Sarevoc, 30.09.2026: Durchsichtig wird das ganze Funkfeld, bis 85 %, und beim Schieben sofort; darunter steht, was der Regler bewirkt -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding DurchsichtigkeitText}" Width="52" TextAlignment="Right" />
                                        <Label Target="{Binding ElementName=DurchsichtRegler}" Padding="0" VerticalAlignment="Center" Width="150">
                                            <AccessText Style="{StaticResource Text.Zugang}" Text="_Durchsichtigkeit" />
                                        </Label>
                                        <Slider x:Name="DurchsichtRegler" Minimum="0" Maximum="85" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding Durchsichtigkeit}" AutomationProperties.Name="Durchsichtigkeit des Funkfelds in Prozent"
                                                AutomationProperties.HelpText="{Binding DurchsichtWirkung}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="150,2,52,6" Text="{Binding DurchsichtWirkung}" />
                                    <CheckBox IsChecked="{Binding SchriftDeckend}" AutomationProperties.Name="Schrift und Symbole deckend halten" gd:Hilfe.Text="Hält Kacheln, Schrift und Symbole deckend; durchsichtig werden dann nur Lücken und Titelzeile.">
                                        <DockPanel>
                                            <AccessText DockPanel.Dock="Top" Text="Schrift und Symbole dec_kend halten" />
                                            <TextBlock Foreground="{StaticResource Pinsel.Text2}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                                       Text="{Binding Source={x:Static m:EinstellungenViewModel.SchriftDeckendHinweis}}" />
                                        </DockPanel>
                                    </CheckBox>
                                    <!-- Sarevoc Q12 (Stufe 3): Skalierung des Funkfelds von -30 bis +30 Prozent; die feste Mindestgröße wächst und schrumpft mit -->
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding SkalierungText}" Width="52" TextAlignment="Right" />
                                        <Label Target="{Binding ElementName=SkalierungRegler}" Padding="0" VerticalAlignment="Center" Width="150">
                                            <AccessText Style="{StaticResource Text.Zugang}" Text="Skalierung (_Größe)" />
                                        </Label>
                                        <Slider x:Name="SkalierungRegler" Minimum="-30" Maximum="30" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding Skalierung}" AutomationProperties.Name="Skalierung des Funkfelds in Prozent" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="150,2,52,6"
                                               Text="Macht das ganze Funkfeld kleiner oder größer. Es hat je Ansicht eine feste Mindestgröße, gerade so, dass alles zu sehen ist; kleiner lässt es sich nicht ziehen." />
                                    <CheckBox Content="Funkfeld beim Start _zeigen" IsChecked="{Binding FunkfeldBeimStart}" gd:Hilfe.Text="Zeigt das Funkfeld gleich beim Start; ohne Häkchen liegt es im Infobereich bereit." />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="24,0,0,0"
                                               Text="Aus heißt: Es liegt beim Start im Infobereich der Taskleiste. Die Taste Funkfeld ablegen/holen, das Symbol dort und Strg+F holen es." />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Left" Command="{Binding GroesseNachInhaltCommand}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Größe des Funkfelds nach dem Inhalt" gd:Hilfe.Text="Vergisst die gezogene Größe des Funkfelds; es nimmt wieder die Größe, die sein Inhalt braucht.">
                                            <AccessText Text="Größe _nach Inhalt" />
                                        </Button>
                                        <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Text="Das Funkfeld startet gerade so groß, dass alles zu sehen ist, und merkt sich je Ansicht Lage und Größe, so wie du es hinschiebst und am Rand ziehst. Der Knopf setzt die Größe wieder auf die optimale, die Lage bleibt." />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Das Funkfeld bleibt immer im Vordergrund und lässt sich weder minimieren noch maximieren; das X legt es in den Infobereich. Über dem Spiel ist es nur im Modus &quot;Randloses Fenster&quot; sichtbar, nicht im exklusiven Vollbild." />

                                    <!-- 0.11.1 (Sarevoc 12.10.2026): die Meldezeile an einem festen Platz, Raster aus neun Feldern (ein Klick setzt und zeigt die Probe), Monitor, Probe -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Meldezeile" />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:MeldezeilePlatzViewModel.Erklaerung}" />
                                    <se:Spaltenwechsel x:Name="MeldezeileSpalten" Margin="0,8,0,0" DataContext="{Binding Meldezeile}" Ab="460" Aufteilung="ErsteFest" ErsteBreite="220"
                                                       Luecke="0" Zeilenluecke="10">
                                        <Border x:Name="MeldezeileRaster" Style="{StaticResource Meldezeile.Monitor}" VerticalAlignment="Top"
                                                AutomationProperties.Name="Stelle der Meldezeile auf dem Monitor">
                                            <ItemsControl ItemsSource="{Binding Felder}" Style="{StaticResource Liste}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="3" Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:Stellenfeld}">
                                                        <!-- Der Klick ist ein Command (auch auf das gewählte Feld: Probe); IsChecked folgt nur dem Modell, der eigene Umschlag des
                                                             RadioButtons setzt den aktuellen Wert und lässt die Bindung stehen -->
                                                        <RadioButton Style="{StaticResource Meldezeile.Feld}" GroupName="Meldezeilenstelle" IsChecked="{Binding Gewaehlt, Mode=OneWay}"
                                                                     Command="{Binding WaehlenCommand}" AutomationProperties.Name="{Binding Name}" gd:Hilfe.Text="{Binding Hilfe}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <StackPanel VerticalAlignment="Top">
                                            <!-- Alt+O: M hat "Automatik" unter Senden -->
                                            <Label Target="{Binding ElementName=MeldezeileMonitorWahl}" Padding="0" Margin="0,0,0,4">
                                                <AccessText Style="{StaticResource Text.Zugang}" Text="Monit_or" />
                                            </Label>
                                            <ComboBox x:Name="MeldezeileMonitorWahl" ItemsSource="{Binding Monitore}" SelectedItem="{Binding GewaehlterMonitor}" ItemTemplate="{StaticResource NameVorlage}"
                                                      MaxWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="Monitor der Meldezeile"
                                                      gd:Hilfe.Text="{x:Static m:MeldezeilePlatzViewModel.MonitorHilfe}" />
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="Automatisch: der Monitor, auf dem das Spiel läuft, sonst der Hauptmonitor. Nicht angeschlossen heißt Hauptmonitor." />
                                            <Button x:Name="MeldezeileProbeKnopf" Command="{Binding ProbeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    AutomationProperties.Name="Probe der Meldezeile zeigen" gd:Hilfe.Text="{x:Static m:MeldezeilePlatzViewModel.ProbeHilfe}">
                                                <AccessText Text="_Probe zeigen" />
                                            </Button>
                                        </StackPanel>
                                    </se:Spaltenwechsel>

                                    <!-- Hilfetexte an den Knöpfen (Design\Hilfe.cs) -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Tooltips" />
                                    <CheckBox Content="Tooltips zeigen" IsChecked="{Binding Hilfetexte}" gd:Hilfe.Text="Zeigt diese Hilfetexte, wenn die Maus kurz auf einem Knopf ruht; ohne Häkchen schweigen alle." />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="24,0,0,0"
                                               Text="Ruht die Maus kurz auf einem Knopf, sagt ein Text, was er tut, welche Taste dazu gehört und warum er gerade gesperrt ist." />

                                    <!-- Beim Start; "Beim Start verbinden" nach der Freigabe ab Werk an (E12) -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Beim Start" />
                                    <CheckBox Content="_Audio beim Start öffnen" IsChecked="{Binding AudioBeimStart}" gd:Hilfe.Text="Öffnet Mikrofon und Ausgabe gleich beim Start. Aus: &quot;Audio starten&quot; steht dann unter Fehlersuche." />
                                    <CheckBox Content="Beim Start _verbinden" IsChecked="{Binding VerbindenBeimStart}" Margin="0,4,0,0" gd:Hilfe.Text="{x:Static m:EinstellungenViewModel.VerbindenBeimStartHilfe}" />
                                    <ContentControl Content="{Binding AbschnittFunkfeld.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!--
                      ================= Sprecheranzeige (seit 0.11.9, Sarevoc 11.10. und 15.10.2026, Bild m-6) =================
                      Offen der Schalter "Sprecheranzeige an" (ab Werk an) und unter "Wo im Bild" die Regler Waagerecht und Senkrecht, je 0 bis 100 % des
                      Monitors (ab Werk 0 und 0, ganz oben links; Sarevoc 15.10.2026: "die Position mit Schieberegler einstellen, nicht fest vorgeschlagen", bis
                      dahin ein Raster mit neun Feldern). Solange geschoben wird, steht die Probezeile live dort über dem Spiel, und noch 3 s danach (kein
                      eigener Knopf). Die Regler gehen mit den Pfeiltasten in ganzen Prozent, mit Bild auf und ab in Zehnern. Unter Erweitert links Größe,
                      Durchsichtigkeit der Schrift, Zeilen, Nachhalten, Ausblenden, eigene Sendung und Monitor, rechts die Vorschau "So sieht sie aus" auf
                      neutralem dunklem Grund (kein Spielbild) mit der echten Schrift und dem Schatten (Vorlage Sprecheranzeige.Bild wie über dem Spiel);
                      unten über beide "Zurück auf Werkseinstellung". Das Vollbild meldet der Kasten oben. Keine Zugriffstasten (die übrigen Abschnitte
                      brauchen die Buchstaben).
                    -->
                    <Border Style="{StaticResource Abschnitt.Trenner}">
                        <StackPanel x:Name="AbschnittSprecheranzeige">
                            <ContentControl Content="{Binding AbschnittSprecheranzeige}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                            <se:Spaltenwechsel x:Name="SprecheranzeigeSpalten" Margin="8,8,8,6" Ab="{x:Static m:EinstellungenViewModel.SendenZweiSpaltenAb}" Luecke="24"
                                               Zeilenluecke="10" DataContext="{Binding Sprecheranzeige}">
                                <CheckBox x:Name="SprecheranzeigeSchalter" IsChecked="{Binding An}" VerticalAlignment="Top" AutomationProperties.Name="Sprecheranzeige an"
                                          gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.AnHilfe}">
                                    <StackPanel>
                                        <TextBlock Text="Sprecheranzeige an" />
                                        <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:SprecheranzeigeViewModel.Erklaerung}" />
                                    </StackPanel>
                                </CheckBox>
                                <!-- Wo im Bild: zwei Regler, die linke obere Ecke der Anzeige folgt ihnen; Beschriftung über dem Regler, der Wert rechts -->
                                <StackPanel x:Name="SprecheranzeigeWo">
                                    <TextBlock Text="Wo im Bild" Foreground="{StaticResource Pinsel.Text}" />
                                    <TextBlock Text="Waagerecht" Foreground="{StaticResource Pinsel.Text}" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock x:Name="SprecheranzeigeWaagerechtWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding WaagerechtText}"
                                                   Width="56" TextAlignment="Right" />
                                        <Slider x:Name="SprecheranzeigeWaagerecht" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding Waagerecht}" AutomationProperties.Name="Sprecheranzeige waagerecht in Prozent des Monitors"
                                                gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.WaagerechtHilfe}" />
                                    </DockPanel>
                                    <TextBlock Text="Senkrecht" Foreground="{StaticResource Pinsel.Text}" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock x:Name="SprecheranzeigeSenkrechtWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding SenkrechtText}"
                                                   Width="56" TextAlignment="Right" />
                                        <Slider x:Name="SprecheranzeigeSenkrecht" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding Senkrecht}" AutomationProperties.Name="Sprecheranzeige senkrecht in Prozent des Monitors"
                                                gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.SenkrechtHilfe}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static m:SprecheranzeigeViewModel.LageSatz}" />
                                </StackPanel>
                            </se:Spaltenwechsel>
                            <Expander x:Name="SprecheranzeigeFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,2,0,0" Header="{Binding AbschnittSprecheranzeige.Feinheiten}"
                                      Tag="{Binding AbschnittSprecheranzeige.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittSprecheranzeige.Feinheiten.Offen}">
                                <StackPanel Margin="0,0,8,0">
                                    <se:Spaltenwechsel x:Name="SprecheranzeigeErweitertSpalten" Ab="{x:Static m:EinstellungenViewModel.SendenZweiSpaltenAb}" Luecke="24"
                                                       Zeilenluecke="10" DataContext="{Binding Sprecheranzeige}">
                                        <!-- links: Aussehen, Zeit, Inhalt und Monitor -->
                                        <StackPanel x:Name="SprecheranzeigeErweitertLinks">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Aussehen" Margin="0,2,0,4" />
                                            <TextBlock Text="Größe" Foreground="{StaticResource Pinsel.Text}" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding GroesseText}" Width="56" TextAlignment="Right" />
                                                <Slider x:Name="SprecheranzeigeGroesse" Minimum="60" Maximum="200" SmallChange="10" LargeChange="20" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" Value="{Binding Groesse}" AutomationProperties.Name="Größe der Sprecheranzeige in Prozent"
                                                        gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.GroesseHilfe}" />
                                            </DockPanel>
                                            <TextBlock Text="Durchsichtigkeit der Schrift" Foreground="{StaticResource Pinsel.Text}" Margin="0,8,0,0" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding DurchsichtigkeitText}" Width="56" TextAlignment="Right" />
                                                <Slider x:Name="SprecheranzeigeDurchsicht" Minimum="0" Maximum="80" SmallChange="5" LargeChange="10" TickFrequency="5"
                                                        IsSnapToTickEnabled="True" Value="{Binding Durchsichtigkeit}"
                                                        AutomationProperties.Name="Durchsichtigkeit der Schrift der Sprecheranzeige in Prozent"
                                                        gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.DurchsichtigkeitHilfe}" />
                                            </DockPanel>
                                            <TextBlock Text="Höchstens so viele Zeilen" Foreground="{StaticResource Pinsel.Text}" Margin="0,8,0,0" />
                                            <WrapPanel x:Name="SprecheranzeigeZeilen" Margin="0,4,0,0">
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="Sprecheranzeigezeilen" Content="1" MinWidth="40" Margin="0,0,6,6"
                                                             IsChecked="{Binding Zeilen1}" AutomationProperties.Name="Höchstens 1 Zeile" gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.ZeilenHilfe}" />
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="Sprecheranzeigezeilen" Content="2" MinWidth="40" Margin="0,0,6,6"
                                                             IsChecked="{Binding Zeilen2}" AutomationProperties.Name="Höchstens 2 Zeilen" gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.ZeilenHilfe}" />
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="Sprecheranzeigezeilen" Content="3" MinWidth="40" Margin="0,0,6,6"
                                                             IsChecked="{Binding Zeilen3}" AutomationProperties.Name="Höchstens 3 Zeilen" gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.ZeilenHilfe}" />
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="Sprecheranzeigezeilen" Content="4" MinWidth="40" Margin="0,0,6,6"
                                                             IsChecked="{Binding Zeilen4}" AutomationProperties.Name="Höchstens 4 Zeilen" gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.ZeilenHilfe}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{Binding ZeilenSatz}" />

                                            <TextBlock Style="{StaticResource Gruppe}" Text="Zeit" />
                                            <TextBlock Text="Nachhalten" Foreground="{StaticResource Pinsel.Text}" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding NachhaltenText}" Width="56" TextAlignment="Right" />
                                                <Slider x:Name="SprecheranzeigeNachhalten" Minimum="0" Maximum="5" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                                        IsSnapToTickEnabled="True" Value="{Binding Nachhalten}" AutomationProperties.Name="Nachhalten der Sprecheranzeige in Sekunden"
                                                        gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.NachhaltenHilfe}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="So lange bleibt ein Name nach dem letzten Wort stehen." />
                                            <TextBlock Text="Ausblenden" Foreground="{StaticResource Pinsel.Text}" Margin="0,8,0,0" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding AusblendenText}" Width="56" TextAlignment="Right" />
                                                <Slider x:Name="SprecheranzeigeAusblenden" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                                        IsSnapToTickEnabled="True" Value="{Binding Ausblenden}" AutomationProperties.Name="Ausblenden der Sprecheranzeige in Sekunden"
                                                        gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.AusblendenHilfe}" />
                                            </DockPanel>

                                            <TextBlock Style="{StaticResource Gruppe}" Text="Inhalt und Monitor" />
                                            <CheckBox x:Name="SprecheranzeigeEigene" IsChecked="{Binding EigeneSendung}" AutomationProperties.Name="Eigene Sendung zeigen"
                                                      gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.EigeneSendungHilfe}">
                                                <StackPanel>
                                                    <TextBlock Text="Eigene Sendung zeigen" />
                                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="Als Zeile: Du -> Kanal (Ch.)" />
                                                </StackPanel>
                                            </CheckBox>
                                            <TextBlock Text="Monitor" Foreground="{StaticResource Pinsel.Text}" Margin="0,10,0,4" />
                                            <ComboBox x:Name="SprecheranzeigeMonitorWahl" ItemsSource="{Binding Monitore}" SelectedItem="{Binding GewaehlterMonitor}"
                                                      ItemTemplate="{StaticResource NameVorlage}" MaxWidth="360" HorizontalAlignment="Left"
                                                      AutomationProperties.Name="Monitor der Sprecheranzeige" gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.MonitorHilfe}" />
                                            <!-- Spiel (Umbau 19.10.2026, Sarevoc Q10): Star Citizen ab Werk oder ein anderes über seine Programmdatei; gilt auch für Meldungen
                                                 und Meldezeile. Das Textfeld nimmt den Namen oder den Pfad und merkt den Prozessnamen beim Verlassen. -->
                                            <TextBlock Text="Spiel" Foreground="{StaticResource Pinsel.Text}" Margin="0,10,0,4" />
                                            <WrapPanel x:Name="SpielWahl">
                                                <RadioButton x:Name="SpielStarCitizen" Style="{StaticResource Umschalter.Radio}" GroupName="Spielprofil" Content="Star Citizen (ab Werk)"
                                                             Margin="0,0,6,6" IsChecked="{Binding SpielStarCitizen}" AutomationProperties.Name="Spiel: Star Citizen, ab Werk"
                                                             gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.SpielHilfe}" />
                                                <RadioButton x:Name="SpielAnderes" Style="{StaticResource Umschalter.Radio}" GroupName="Spielprofil" Content="Anderes Spiel"
                                                             Margin="0,0,6,6" IsChecked="{Binding SpielAnderes}" AutomationProperties.Name="Spiel: ein anderes"
                                                             gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.SpielHilfe}" />
                                            </WrapPanel>
                                            <DockPanel x:Name="SpielDatei" Margin="0,2,0,0" IsEnabled="{Binding SpielAnderes}" MaxWidth="360" HorizontalAlignment="Left">
                                                <Button x:Name="SpielDateiWaehlen" DockPanel.Dock="Right" Margin="6,0,0,0" Content="Programmdatei wählen ..."
                                                        Command="{Binding SpielDateiWaehlenCommand}" AutomationProperties.Name="Programmdatei des Spiels wählen"
                                                        gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.SpielHilfe}" />
                                                <TextBox x:Name="SpielProzess" Text="{Binding SpielProzess, UpdateSourceTrigger=LostFocus}" MinWidth="120"
                                                         AutomationProperties.Name="Programmdatei des Spiels" gd:Hilfe.Text="{x:Static m:SprecheranzeigeViewModel.SpielHilfe}" />
                                            </DockPanel>
                                            <TextBlock x:Name="SpielSatz" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding SpielSatz}" />
                                        </StackPanel>
                                        <!-- rechts: die Vorschau auf neutralem dunklem Grund, so groß wie über dem Spiel, wenn sie passt, sonst verkleinert -->
                                        <StackPanel x:Name="SprecheranzeigeErweitertRechts">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="So sieht sie aus" Margin="0,2,0,4" />
                                            <Border x:Name="SprecheranzeigeVorschau" Background="#1E1E1E" CornerRadius="4" Padding="6" MinHeight="120"
                                                    AutomationProperties.Name="Vorschau der Sprecheranzeige">
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <ContentControl Content="{Binding Vorschau}" ContentTemplate="{StaticResource Sprecheranzeige.Bild}" Focusable="False" IsTabStop="False" />
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{x:Static m:SprecheranzeigeViewModel.VorschauSatz}" />
                                        </StackPanel>
                                    </se:Spaltenwechsel>
                                    <ContentControl Content="{Binding AbschnittSprecheranzeige.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!--
                      ================= Meldungen (seit 0.12.0, Meldesystem, SPEZ "Client") =================
                      Offen links der Satz, was kommt, rechts unter "Wo im Bild" die Regler Waagerecht und Senkrecht wie bei der Sprecheranzeige, je 0 bis 100 %
                      des Monitors (ab Werk 50 und 0, oben Mitte); beim Schieben steht eine Probe über dem Spiel, noch 3 s danach. Kein Schalter zum ganz
                      Abschalten (Vorgabe). Unter Erweitert links Grundgröße und Ton, rechts Ausführung und Bild beim Stopp als Wahl mit Bild; unten
                      "Zurück auf Werkseinstellung". Keine Zugriffstasten (die übrigen Abschnitte brauchen die Buchstaben).
                    -->
                    <Border Style="{StaticResource Abschnitt.Trenner}">
                        <StackPanel x:Name="AbschnittMeldungen">
                            <ContentControl Content="{Binding AbschnittMeldungen}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                            <se:Spaltenwechsel x:Name="MeldungenSpalten" Margin="8,8,8,6" Ab="{x:Static m:EinstellungenViewModel.SendenZweiSpaltenAb}" Luecke="24"
                                               Zeilenluecke="10" DataContext="{Binding Meldungen}">
                                <TextBlock x:Name="MeldungenErklaerung" Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" VerticalAlignment="Top"
                                           Text="{x:Static m:MeldungenEinstellungViewModel.Erklaerung}" />
                                <StackPanel x:Name="MeldungenWo">
                                    <TextBlock Text="Wo im Bild" Foreground="{StaticResource Pinsel.Text}" />
                                    <TextBlock Text="Waagerecht" Foreground="{StaticResource Pinsel.Text}" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock x:Name="MeldungenWaagerechtWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding WaagerechtText}"
                                                   Width="56" TextAlignment="Right" />
                                        <Slider x:Name="MeldungenWaagerecht" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding Waagerecht}" AutomationProperties.Name="Meldungen waagerecht in Prozent des Monitors"
                                                gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.WaagerechtHilfe}" />
                                    </DockPanel>
                                    <TextBlock Text="Senkrecht" Foreground="{StaticResource Pinsel.Text}" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock x:Name="MeldungenSenkrechtWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding SenkrechtText}"
                                                   Width="56" TextAlignment="Right" />
                                        <Slider x:Name="MeldungenSenkrecht" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding Senkrecht}" AutomationProperties.Name="Meldungen senkrecht in Prozent des Monitors"
                                                gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.SenkrechtHilfe}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static m:MeldungenEinstellungViewModel.LageSatz}" />
                                </StackPanel>
                            </se:Spaltenwechsel>
                            <Expander x:Name="MeldungenFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,2,0,0" Header="{Binding AbschnittMeldungen.Feinheiten}"
                                      Tag="{Binding AbschnittMeldungen.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittMeldungen.Feinheiten.Offen}">
                                <StackPanel Margin="0,0,8,0">
                                    <se:Spaltenwechsel x:Name="MeldungenErweitertSpalten" Ab="{x:Static m:EinstellungenViewModel.SendenZweiSpaltenAb}" Luecke="24"
                                                       Zeilenluecke="10" DataContext="{Binding Meldungen}">
                                        <!-- links: Grundgröße und Ton -->
                                        <StackPanel x:Name="MeldungenErweitertLinks">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Größe" Margin="0,2,0,4" />
                                            <TextBlock Text="Grundgröße" Foreground="{StaticResource Pinsel.Text}" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock x:Name="MeldungenGroesseWert" DockPanel.Dock="Right" Style="{StaticResource Text.Wert}" Text="{Binding GrundgroesseText}"
                                                           Width="56" TextAlignment="Right" />
                                                <Slider x:Name="MeldungenGroesse" Minimum="100" Maximum="400" SmallChange="10" LargeChange="40" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" Value="{Binding Grundgroesse}" AutomationProperties.Name="Grundgröße der Meldungen"
                                                        gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.GroesseHilfe}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap"
                                                       Text="Längste Seite einer Meldung bei normal; die Leitung kann doppelt oder dreifach senden, nie größer als der Monitor." />
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Ton" />
                                            <CheckBox x:Name="MeldungenTon" IsChecked="{Binding Ton}" AutomationProperties.Name="Ton bei Befehlen, Texten und Countdown"
                                                      gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.TonHilfe}">
                                                <StackPanel>
                                                    <TextBlock Text="Ton bei Befehlen, Texten und Countdown" />
                                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="Kurz, bei jedem Befehl und Text und in den letzten 10 s des Countdowns." />
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                        <!-- rechts: Ausführung und Bild beim Stopp, je als Wahl mit Bild -->
                                        <StackPanel x:Name="MeldungenErweitertRechts">
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Ausführung" Margin="0,2,0,4" />
                                            <WrapPanel x:Name="MeldungenAusfuehrung">
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="MeldungenAusfuehrung" Margin="0,0,6,6" Padding="8,4"
                                                             IsChecked="{Binding AusfuehrungSchlicht}" AutomationProperties.Name="Ausführung Schlicht"
                                                             gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.AusfuehrungHilfe}">
                                                    <StackPanel>
                                                        <Image Source="{Binding BildSchlicht}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="Schlicht" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="MeldungenAusfuehrung" Margin="0,0,6,6" Padding="8,4"
                                                             IsChecked="{Binding AusfuehrungMetall}" AutomationProperties.Name="Ausführung Metall"
                                                             gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.AusfuehrungHilfe}">
                                                    <StackPanel>
                                                        <Image Source="{Binding BildMetall}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="Metall" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="MeldungenAusfuehrung" Margin="0,0,6,6" Padding="8,4"
                                                             IsChecked="{Binding AusfuehrungSchrift}" AutomationProperties.Name="Ausführung Nur Schrift"
                                                             gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.AusfuehrungHilfe}">
                                                    <StackPanel>
                                                        <Image Source="{Binding BildSchrift}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="Nur Schrift" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap"
                                                       Text="Metall fehlt für Los, Stopfen und Pause, Nur Schrift gibt es nur für diese drei; sonst kommt Schlicht." />
                                            <TextBlock Style="{StaticResource Gruppe}" Text="Bild beim Stopp" />
                                            <WrapPanel x:Name="MeldungenStopp">
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="MeldungenStopp" Margin="0,0,6,6" Padding="8,4"
                                                             IsChecked="{Binding StoppHandschuh}" AutomationProperties.Name="Stopp mit Handschuh"
                                                             gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.StoppHilfe}">
                                                    <StackPanel>
                                                        <Image Source="{Binding BildHandschuh}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="Handschuh" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource Umschalter.Radio}" GroupName="MeldungenStopp" Margin="0,0,6,6" Padding="8,4"
                                                             IsChecked="{Binding StoppXeno}" AutomationProperties.Name="Stopp mit Xeno-Schild"
                                                             gd:Hilfe.Text="{x:Static m:MeldungenEinstellungViewModel.StoppHilfe}">
                                                    <StackPanel>
                                                        <Image Source="{Binding BildXeno}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="Xeno" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </WrapPanel>
                                        </StackPanel>
                                    </se:Spaltenwechsel>
                                    <ContentControl Content="{Binding AbschnittMeldungen.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- ================= Fehlersuche: nichts läuft von selbst, darum kein Kasten, nur ein Satz ================= -->
                    <Border Style="{StaticResource Abschnitt.Trenner}">
                        <StackPanel x:Name="AbschnittFehlersuche">
                            <ContentControl Content="{Binding AbschnittFehlersuche}" ContentTemplate="{StaticResource AbschnittKopf}" Focusable="False" />
                            <!--
                              "Audio starten" (seit 0.11.2 hier; 0.10.0 bis 0.11.1 auf Start, Sarevoc 13.10.2026: auf Start nur das Audio): für "Audio beim Start öffnen" aus
                              und nach einem Startfehler; der Grund steht gekürzt daneben, ganz im Hilfetext.
                            -->
                            <DockPanel Margin="0,6,0,6">
                                <Button x:Name="FehlersucheAudioStarten" DockPanel.Dock="Left" Content="Audio starten" Command="{Binding Audio.StartenCommand}" VerticalAlignment="Top"
                                        gd:Hilfe.Text="{x:Static m:StartViewModel.AudioStartenHilfe}" />
                                <TextBlock Style="{StaticResource Text.Warnung}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Audio.HinweisKurz}"
                                           ToolTip="{Binding Audio.Hinweis}" Visibility="{Binding Audio.HinweisKurz, Converter={StaticResource SichtbarWennWert}}" />
                            </DockPanel>
                            <Expander x:Name="FehlersucheFeinheiten" Style="{StaticResource Klappbereich}" Margin="0,4,0,0" Header="{Binding AbschnittFehlersuche.Feinheiten}"
                                      Tag="{Binding AbschnittFehlersuche.Feinheiten.KopfHilfe}" IsExpanded="{Binding AbschnittFehlersuche.Feinheiten.Offen}">
                                <StackPanel Margin="0,0,8,0">
                                    <!-- Klang (E13): der Klangtreiber stand bis 0.9.3 in der Fußzeile; die Warnungen beim Start stehen weiter dort -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Klang" Margin="0,2,0,4" />
                                    <TextBlock x:Name="KlangtreiberText" FontSize="13" TextWrapping="Wrap" Text="{Binding Klangtreiber}" />
                                    <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Starthinweise, StringFormat='Beim Start: {0}'}"
                                               Visibility="{Binding Starthinweise, Converter={StaticResource SichtbarWennWert}}" />
                                    <StackPanel DataContext="{Binding Audio}">
                                        <TextBlock Style="{StaticResource Text.Hinweis}" Margin="0,4,0,0" Text="{Binding ZustandText}" />
                                        <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding Hinweis, Converter={StaticResource SichtbarWennWert}}">
                                            <TextBlock Style="{StaticResource Text.Warnung}" Text="{Binding Hinweis}" />
                                        </Border>
                                        <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,6,0,0" Visibility="{Binding LetzterFehler, Converter={StaticResource SichtbarWennWert}}">
                                            <TextBlock Style="{StaticResource Text.Warnung}" Text="{Binding LetzterFehler, StringFormat='Zuletzt meldete die Klangmaschine: {0}'}" />
                                        </Border>
                                        <CheckBox DataContext="{Binding Lautstaerke}" IsChecked="{Binding Klangprotokoll}" Margin="0,10,0,0" AutomationProperties.Name="Klangprotokoll schreiben"
                                                  gd:Hilfe.Text="Schreibt Messwerte deiner Sendekette (Pegel, Verstärkung, Rechenzeit) in eine Datei im Ordner deiner Einstellungen. Nur zur Fehlersuche, ab Werk aus.">
                                            <StackPanel>
                                                <TextBlock Text="Klangprotokoll schreiben" />
                                                <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="Nur zur Fehlersuche." />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>

                                    <!-- Ordner der Einstellungen, ohne den Pfad zu zeigen (N1, Gegenprüfung Stufe 2) -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Einstellungen" />
                                    <DockPanel x:Name="AblageZeile">
                                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="Ordner öffnen" Command="{Binding OrdnerOeffnenCommand}"
                                                gd:Hilfe.Text="Öffnet den Ordner mit deinen Einstellungen im Explorer, etwa um das Klangprotokoll oder die Stimmproben weiterzugeben." />
                                        <TextBlock Style="{StaticResource Text.Hinweis}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding OrtText, StringFormat='Einstellungen: {0}'}" />
                                    </DockPanel>
                                    <Border Style="{StaticResource Warnung.Unterlage}" Margin="0,8,0,0" Visibility="{Binding Fehler, Converter={StaticResource SichtbarWennWert}}">
                                        <TextBlock Style="{StaticResource Text.Warnung}" Text="{Binding Fehler}" />
                                    </Border>

                                    <!-- Stimmproben (Sarevoc 08.10.2026, Q60; seit 0.9.3 für Klangmessungen allgemein, nach Q65 hier): fünf Aufnahmen je Sprecher, nur auf diesem PC. -->
                                    <TextBlock Style="{StaticResource Gruppe}" Text="Stimmproben" />
                                    <Border x:Name="StimmprobenKarte" DataContext="{Binding Audio.Stimmproben}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{x:Static m:StimmprobenViewModel.Erklaerung}" />
                                            <!-- Das Feld höchstens 240 breit und schmaler, wenn der Platz fehlt (bei 640 Fensterbreite blieben 220, gemessen in AP3) -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MaxWidth="240" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Etikett}" Text="Wessen Stimme" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBox x:Name="StimmprobenSprecher" Grid.Column="1" Text="{Binding Sprecher, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Wessen Stimme" gd:Hilfe.Text="Der Name kommt in den Ordner der Proben; für jede Person einen eigenen, etwa ihren SC-Namen." />
                                            </Grid>
                                            <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{Binding OrdnerText}" Margin="0,4,0,0" />
                                            <Border Background="{StaticResource Pinsel.FlaecheTief}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                                                <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Pinsel.Text}" Text="{x:Static m:StimmprobenViewModel.Lesetext}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Schritte}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:StimmprobenSchritt}">
                                                        <DockPanel Margin="0,10,0,0">
                                                            <Button DockPanel.Dock="Left" Content="{Binding KnopfText}" Command="{Binding AufnehmenCommand}" MinWidth="150" Margin="0,0,14,0" VerticalAlignment="Top"
                                                                    AutomationProperties.Name="{Binding Titel, StringFormat='Stimmprobe {0} aufnehmen'}"
                                                                    gd:Hilfe.Text="Die Aufnahme beginnt sofort nach dem Klick und endet von selbst." gd:Hilfe.Gesperrt="Es läuft schon eine Aufnahme." />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Titel}" FontWeight="SemiBold" Foreground="{StaticResource Pinsel.Text}" />
                                                                <TextBlock Style="{StaticResource Text.Hinweis}" TextWrapping="Wrap" Text="{Binding Anweisung}" />
                                                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Pinsel.Text}" Text="{Binding Zustand}"
                                                                           Visibility="{Binding Zustand, Converter={StaticResource SichtbarWennWert}}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <ContentControl Content="{Binding AbschnittFehlersuche.Feinheiten}" ContentTemplate="{StaticResource FeinheitenFuss}" Focusable="False" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Erweitert (E21): Host, Port, Profil, Konto, Gerät und Adresse, nur im Admin-Setup; eine eigene Karte unter den Abschnitten. -->
            <ContentControl x:Name="DetailsBereich" Content="{Binding Details}" ContentTemplate="{StaticResource VerbindungDetailsVorlage}" Focusable="False"
                            Visibility="{Binding Details, Converter={StaticResource SichtbarWennWert}}" />
        </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
