<!-- JG TacRelay - Maintainer: Sarevoc -->
<Window x:Class="Funk.Client.Fenster.FunkfeldFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Funk.Client.Modelle"
        xmlns:se="clr-namespace:Funk.Client.Steuerelemente"
        xmlns:d="clr-namespace:Funk.Client.Design"
        xmlns:gd="clr-namespace:Glasdesign;assembly=Glasdesign"
        Title="Funkfeld" MinWidth="150" MinHeight="60"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" AllowsTransparency="True"
        Style="{StaticResource Fenster.Basis}" Background="{DynamicResource Funkfeld.Grund}">

    <!--
      A24: eigenes Fenster, immer vorn, schließbar, verschiebbar, größenveränderlich, NICHT minimierbar und NICHT maximierbar
      (Fensterrahmen.cs). Sarevoc, 29.09.2026: kompakt wie ein 10er-Feld gängiger Funkprogramme, weil es als Overlay über dem Spiel läuft, in
      zwei Ansichten (A Raster, C Liste; A29) und durchsichtig nach Wahl. Sarevoc, 30.09.2026 (A32, A33): Es startet in der
      optimalen Größe und merkt sich Lage und Größe (FunkfeldFenster.xaml.cs, Platzfuehrung.cs), es ist immer geschichtet
      (AllowsTransparency), damit der Regler stufenlos wirkt und nie ein neues Fenster braucht, und durchsichtig wird das ganze
      Fenster. Mit der Option "Schrift und Symbole deckend halten" nehmen die Flächen ihre Pinsel als DynamicResource aus
      Window.Resources, die der Code nach Design\Lesbarkeit.cs (FunkfeldDeckung) setzt: Lücken und Titelzeile folgen dem
      Regler, Kacheln, Global und die dunklen Unterlagen der Titelzeile bleiben so deckend, dass alles über hellem Spielbild
      lesbar bleibt. Fokusrahmen sind hier weiß: Der Akzent hat auf der Kachel schon deckend nur 3,27:1.

      Stufe 3, Schritt 3.4 (0.6.0, STUFE3-ENTWURF 5.1 bis 5.4, Sarevocs Antworten Q1 bis Q16): Kanäle mit Ch. Oben links die
      Rollenliste ("3 Kapitän"), daneben "Mehrere senden" (nur Führung, Einsatzleitung, Admin); auf jeder Kachel ein
      Statuspunkt (grün sendet, gelb hört, rot nur gesperrt, grauer Ring aus, ohne Kanal und auf Ruhe keiner), der Feldname (seit
      0.8.1 eine feste Beschriftung, Q44) und der Ch.-Wähler mit der Bezeichnung aus der Ch.-Liste. Die Kacheln bleiben flach, die
      Knöpfe (VA/Taste, Aus, Mehrere senden) sind Glas mit einfachem Schatten; VA leuchtet grün. Die Liste ist 264 breit und trägt
      die Rolle in einer zweiten Kopfzeile. Mindestgröße und Skalierung -30 bis +30 % setzt der Code (Inhalt.LayoutTransform, Q12).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="24" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Flächen des Funkfelds; deckend, bis der Code sie nach der Durchsichtigkeit ersetzt -->
        <SolidColorBrush x:Key="Funkfeld.Grund" Color="{StaticResource Farbe.Anthrazit}" />
        <SolidColorBrush x:Key="Funkfeld.Kopf" Color="{StaticResource Farbe.FlaecheTief}" />
        <SolidColorBrush x:Key="Funkfeld.Unterlage" Color="{StaticResource Farbe.FlaecheTief}" />
        <SolidColorBrush x:Key="Funkfeld.Kachel" Color="{StaticResource Farbe.Flaeche}" />
        <SolidColorBrush x:Key="Funkfeld.Global" Color="{StaticResource Farbe.Leitfarbe}" />
        <!-- Dimmung einer Kachel im Zustand AUS (A17): deckend Palette.AusDeckkraft, durchsichtig nur so weit, wie es lesbar bleibt -->
        <x:Static x:Key="Funkfeld.AusDeckkraft" Member="d:Palette.AusDeckkraft" />
        <!-- Dimmung eines leeren Felds und eines Felds auf Ruhe: deckend mindestens Palette.LeerDeckkraft, je Farbstellung und Durchsicht aus FunkfeldDeckung -->
        <x:Static x:Key="Funkfeld.LeerDeckkraft" Member="d:Palette.LeerDeckkraft" />

        <!-- Schloss am Mikro-Knopf, wenn die Einsatzleitung dich stummschaltet (Q33; bis 0.8.0 auch an festen Feldern), selbst gezeichnet in einem 10x10-Feld -->
        <Geometry x:Key="Funkfeld.Schloss">M 3,5 V 3.5 A 2,2 0 0 1 7,3.5 V 5 M 2,5 H 8 V 9.5 H 2 Z</Geometry>
        <!-- Mehrere senden: zwei Sendepunkte mit Welle, selbst gezeichnet im 24x24-Feld der Symbole -->
        <Geometry x:Key="Funkfeld.Mehrfach">M 5,12 A 2,2 0 1 0 9,12 A 2,2 0 1 0 5,12 Z M 15,12 A 2,2 0 1 0 19,12 A 2,2 0 1 0 15,12 Z M 3.2,8 A 5.6,5.6 0 0 0 3.2,16 M 20.8,8 A 5.6,5.6 0 0 1 20.8,16 M 12,7 V 17</Geometry>

        <!-- Weiße Fokusrahmen: außen um Kachelkopf, Knopf und Regler (liegt im Raster noch auf der Kachel), innen in der Titelzeile und in der Zeile der Liste -->
        <!-- Geprüft in OberflaecheFunkfeldDurchsichtTests.Durchsicht_Fokusrahmen_AufTragenderFlaeche -->

        <Style x:Key="Funkfeld.Fokus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="5" RadiusY="5" Stroke="{StaticResource Pinsel.Text}" StrokeThickness="2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Funkfeld.FokusInnen">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="1" RadiusX="3" RadiusY="3" Stroke="{StaticResource Pinsel.Text}" StrokeThickness="2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
          Zeile der Liste: Der Kachelkopf deckt dort die ganze Kachel, ein Rahmen außen herum läge über den durchsichtigen
          Lücken (bei 80 % über Weiß 1,5:1). Innen, 2 vom Rand: noch vor Nummer und Punkt, neben dem dicken Rand von SENDET.
        -->
        <Style x:Key="Funkfeld.FokusZeile">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" RadiusX="3" RadiusY="3" Stroke="{StaticResource Pinsel.Text}" StrokeThickness="2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Wählbarer Teil einer Kachel: Klick wählt den Sendekanal, Strg+Klick (oder "Mehrere senden") nimmt ihn dazu. Er liegt unter
          Punkt, Name, Ch.-Wähler, Sprecher und Pegel; der Ch.-Wähler ist ein eigenes Klappfeld darüber, der Rest lässt den Klick durch,
          seit 0.8.1 auch der Name (Q44, eine feste Beschriftung). Sein Tooltip nennt den vollen Namen und woher der Kanal kommt.
        -->
        <Style x:Key="Kachelkopf" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.Fokus}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="gd:Hilfe.Text" Value="{Binding KopfHilfe}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding KanalText, StringFormat='{}{0} als Sendekanal wählen'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Knopf auf der Kachel (Aus, Hören an oder aus): Glas wie die Knöpfe im Hauptfenster (Stufe 3, Sarevocs Vorgabe: Kacheln flach,
          Knöpfe Glas), klein und mit einfachem Schatten (gd:Glas.Schatten am Inhalt), weißer Fokusrahmen wie überall im Funkfeld.
        -->
        <Style x:Key="Kachel.Knopf" TargetType="ButtonBase" BasedOn="{StaticResource Knopf}">
            <!-- Knopf.Flach (seit 0.11.2) setzt MinHeight 32; ohne diese Zeile wären Aus, Hören und der Mikro-Knopf 32 hoch statt 20 (Glas setzte nur Height). -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.Fokus}" />
        </Style>

        <!--
          VA/Taste je Feld (Sarevoc Q15): ein Umschalter aus Glas; steht er auf Sprachaktivierung, leuchtet er grün (Farbe
          Senden mit einem hellen Schein), die Schrift dunkel darauf (4,5:1 und mehr), auf Taste bleibt er neutral. Die Farbe ist nie
          allein: Er sagt "VA" oder "Taste".
        -->
        <ControlTemplate x:Key="VA.Vorlage" TargetType="ToggleButton">
            <Grid x:Name="Wurzel" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <!-- Seit 0.11.2 flach statt Glas (Sarevoc 13.10.2026: "überall die Glasbuttons raus") -->
                <Border x:Name="Koerper" CornerRadius="9" BorderThickness="1" Background="{StaticResource Pinsel.Flaeche}" BorderBrush="{StaticResource Pinsel.TextAus}" />
                <Border x:Name="Schleier" CornerRadius="9" Background="White" Opacity="0" IsHitTestVisible="False" />
                <Border x:Name="Gruen" Margin="1" CornerRadius="9" Background="{StaticResource Pinsel.Senden}" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border CornerRadius="9">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0.25" Center="0.5,0.35" RadiusX="0.7" RadiusY="0.8">
                                <GradientStop Color="#66FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
                <ContentPresenter x:Name="Inhalt" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Gruen" Property="Visibility" Value="Visible" />
                    <Setter Property="Foreground" Value="{StaticResource Pinsel.AufFarbe}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Schleier" Property="Opacity" Value="0.07" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Schleier" Property="Background" Value="Black" />
                    <Setter TargetName="Schleier" Property="Opacity" Value="0.18" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Koerper" Property="Opacity" Value="0.6" />
                    <Setter Property="Foreground" Value="{DynamicResource Glas.Schrift.Gesperrt}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="VA.Umschalter" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource VA.Vorlage}" />
            <Setter Property="Foreground" Value="{DynamicResource Glas.Schrift}" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="6,0,7,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.Fokus}" />
        </Style>

        <!-- "Mehrere senden" (gleichzeitig in mehrere Kanäle): Umschalter, an in der gedrückten Leitfarbe und mit Haken -->
        <Style x:Key="Mehrfach.Schalter" TargetType="ToggleButton" BasedOn="{StaticResource Umschalter}">
            <!-- Umschalter (seit 0.11.2 auf Knopf.Flach) setzt MinHeight 28; ohne diese Zeile ragte der Schalter aus der Titelzeile. -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="7,0,8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.FokusInnen}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="IsChecked" Value="{Binding MehrfachAn}" />
            <Setter Property="Visibility" Value="{Binding MehrfachSichtbar, Converter={StaticResource SichtbarWenn}}" />
            <Setter Property="AutomationProperties.Name" Value="Mehrfachsenden an oder aus" />
        </Style>
        <Style x:Key="Mehrfach.Haken" TargetType="Path" BasedOn="{StaticResource Symbol}">
            <Setter Property="Data" Value="{StaticResource Funkfeld.Mehrfach}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="StrokeThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MehrfachAn}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Symbol.Haken}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Wahl in der Titelzeile (Ansicht Raster oder Liste): gewählt mit hellem Symbol auf einer helleren Fläche, ohne Rot. -->
        <Style x:Key="Kopf.Wahl" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.FokusInnen}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Rand" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rand" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rand" Property="Background" Value="{StaticResource Pinsel.FlaecheHover}" />
                                <Setter TargetName="Rand" Property="BorderBrush" Value="{StaticResource Pinsel.Grenze}" />
                                <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Klappfeld (se:Klappwahl) für Rollenliste und Ch.-Wähler (die Kanalwahl am Namen gibt es seit 0.8.1 nicht mehr, Q44): flach, ein
          kleiner Pfeil zeigt, dass es aufklappt.
          Die Liste darunter hat dunkle Fläche und grauen Rand; nicht wählbare Einträge grau mit Grund im Tooltip (auch gesperrt).
        -->
        <Style x:Key="Klappliste.Eintrag" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
            <Setter Property="Padding" Value="6,2,6,2" />
            <Setter Property="IsEnabled" Value="{Binding Waehlbar}" />
            <Setter Property="ToolTip" Value="{Binding Hilfe}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.FokusInnen}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Grund" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grund" Property="Background" Value="{StaticResource Pinsel.FlaecheHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Grund" Property="Background" Value="{StaticResource Pinsel.FlaecheHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Pinsel.TextAus}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Klappwahl.Flach" TargetType="se:Klappwahl">
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,0,3,0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.Fokus}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="se:Klappwahl">
                        <Grid>
                            <Border x:Name="Rand" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <DockPanel Margin="{TemplateBinding Padding}">
                                    <Path x:Name="Pfeil" DockPanel.Dock="Right" Data="M 0,0 L 6,0 L 3,3.5 Z" Fill="{TemplateBinding Foreground}" Width="6" Height="4"
                                          Stretch="Fill" Margin="3,1,0,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
                                <Border Background="{StaticResource Pinsel.FlaecheTief}" BorderBrush="{StaticResource Pinsel.Grenze}" BorderThickness="1" CornerRadius="3"
                                        Padding="2" MinWidth="{TemplateBinding ListenBreite}">
                                    <ListBox x:Name="PART_Liste" ItemsSource="{TemplateBinding Eintraege}" ItemTemplate="{TemplateBinding EintragVorlage}"
                                             SelectedItem="{Binding Gewaehlt, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                             ItemContainerStyle="{StaticResource Klappliste.Eintrag}" MaxHeight="{x:Static se:Klappwahl.ListenHoeheMax}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource Pinsel.Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rand" Property="Background" Value="{StaticResource Pinsel.FlaecheHover}" />
                                <Setter TargetName="Rand" Property="BorderBrush" Value="{StaticResource Pinsel.Grenze}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rand" Property="Background" Value="{StaticResource Pinsel.FlaecheHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pfeil" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Ch.-Wähler: flach mit dünner Linie, die Bezeichnung aus der Ch.-Liste -->
        <Style x:Key="Klappwahl.Ch" TargetType="se:Klappwahl" BasedOn="{StaticResource Klappwahl.Flach}">
            <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Grenze}" />
            <Setter Property="ListenBreite" Value="132" />
            <Setter Property="EintragVorlage" Value="{DynamicResource ChEintragVorlage}" />
        </Style>
        <!-- Rollenliste oben links: auf der dunklen Unterlage der Titelzeile, mit dünner Linie -->
        <Style x:Key="Klappwahl.Rolle" TargetType="se:Klappwahl" BasedOn="{StaticResource Klappwahl.Flach}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="{DynamicResource Funkfeld.Unterlage}" />
            <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Grenze}" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="ListenBreite" Value="232" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.FokusInnen}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="EintragVorlage" Value="{DynamicResource RolleEintragVorlage}" />
            <Setter Property="Eintraege" Value="{Binding Rollen}" />
            <!-- Ohne gewählte Rolle markiert die Liste die Rolle des Platzes (0.11.0); nur Anzeige, gewählt wird über Waehlen und Schritt -->
            <Setter Property="Gewaehlt" Value="{Binding RolleMarkiert, Mode=OneWay}" />
            <Setter Property="Waehlen" Value="{Binding RolleWaehlenCommand}" />
            <Setter Property="Schritt" Value="{Binding RolleSchrittCommand}" />
            <Setter Property="IsEnabled" Value="{Binding RolleWaehlbar}" />
            <Setter Property="gd:Hilfe.Text" Value="{Binding RolleHilfe}" />
            <Setter Property="gd:Hilfe.Gesperrt" Value="{Binding RolleHilfe}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding RolleText, StringFormat='Rolle: {0}'}" />
        </Style>
        <DataTemplate x:Key="RolleEintragVorlage" DataType="{x:Type m:RollenEintrag}">
            <TextBlock Text="{Binding Text}" FontSize="12" />
        </DataTemplate>
        <!-- Gesperrt (6.17): roter Punkt mit weißem Querstrich wie auf der Kachel davor, der Grund im Tooltip des Eintrags -->
        <Style x:Key="SperrPunkt" TargetType="Grid">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding Gesperrt, Converter={StaticResource SichtbarWenn}}" />
        </Style>
        <DataTemplate x:Key="ChEintragVorlage" DataType="{x:Type m:ChEintrag}">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Style="{StaticResource SperrPunkt}">
                    <Ellipse Fill="{StaticResource Pinsel.RotSchrift}" />
                    <Rectangle Width="5" Height="1.4" Fill="{StaticResource Pinsel.Text}" />
                </Grid>
                <TextBlock Text="{Binding Text}" FontSize="12" />
            </DockPanel>
        </DataTemplate>

        <!-- Kleiner Lautstärkeregler: Spur in der Grenzfarbe, der Wert im Akzent der Farbstellung, Knauf 12 Einheiten. -->
        <Style x:Key="Kachel.Regler" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.Fokus}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource Pinsel.Grenze}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Regler.Leer}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource Pinsel.Akzent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Regler.Leer}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Regler.Daumen}" Width="12" Height="12" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Regler der Durchsichtigkeit in der Titelzeile (A30): wie der Lautstärkeregler, 0 bis 85 % (FunkfeldEinstellungen.
          DurchsichtigkeitMax, geprüft im Test) in Schritten zu 5 wie unter Einstellungen. Im Raster 72 breit, in der Liste
          aufgeklappt so breit wie Platz ist. Er wirkt beim Ziehen sofort (A33).
        -->
        <Style x:Key="Titel.Regler" TargetType="Slider" BasedOn="{StaticResource Kachel.Regler}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="85" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="5" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="18" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="Durchsichtigkeit des Funkfelds in Prozent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReglerBreit}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          Schiebeschalter 5 oder 10 Felder in der Titelzeile (A33, Sarevoc: "Schiebebutton" statt des Knopfs): ein weißer Knauf in
          einer dunklen Spur, links 5, rechts 10. Die Spur ist neutral, nicht im Akzent: Beide Stellungen sind gleichwertig,
          keine ist "an". Im Raster stehen "5" und "10" an den Enden, die gewählte weiß, die andere zweitrangig; so sieht man
          beide Möglichkeiten. In der Liste (Kompakt) trägt der Knauf die Zahl, und die Enden bleiben leer: Die Liste bleibt
          schmal, und "Senden: Crew" passt weiter ganz neben die Knöpfe. Kontrast: Knauf weiß auf #1E1E1E, Spurrand
          Palette.Grenze auf der Unterlage (3:1), Zahlen 4,5:1, die Zahl im Knauf #141414 auf Weiß.
        -->
        <Style x:Key="Titel.Schalter" TargetType="se:Schiebeschalter">
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- So hoch wie die Titelzeile: Der weiße Fokusrahmen innen liegt dann über und unter der Spur auf der Unterlage. -->
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3,0,3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.FokusInnen}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="LinksText" Value="5" />
            <Setter Property="RechtsText" Value="10" />
            <Setter Property="AutomationProperties.Name" Value="5 oder 10 Felder" />
            <Setter Property="gd:Hilfe.Text" Value="Schaltet zwischen 5 und 10 Feldern um: Knauf links heißt 5, rechts 10. Klicke oder ziehe ihn; die Leertaste schaltet um, die Pfeiltasten setzen." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="se:Schiebeschalter">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Links" Text="{TemplateBinding LinksText}" Foreground="{StaticResource Pinsel.Text}" Margin="2,0,4,0" VerticalAlignment="Center" />
                            <Border x:Name="PART_Spur" Width="30" Height="16" CornerRadius="8" BorderThickness="1" Padding="1" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource Pinsel.Grenze}" Background="{StaticResource Pinsel.FlaecheTief}">
                                <!-- Der Schalter verschiebt den Knauf selbst (RenderTransform aus dem Code, Schiebeschalter.KnaufVersatz). -->
                                <Border x:Name="PART_Knauf" Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource Pinsel.Text}">
                                    <TextBlock x:Name="Zahl" Text="{TemplateBinding LinksText}" Foreground="{StaticResource Pinsel.AufFarbe}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <TextBlock x:Name="Rechts" Text="{TemplateBinding RechtsText}" Margin="4,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Links" Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
                                <Setter TargetName="Rechts" Property="Foreground" Value="{StaticResource Pinsel.Text}" />
                                <Setter TargetName="Zahl" Property="Text" Value="{Binding RechtsText, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Spur" Property="BorderBrush" Value="{StaticResource Pinsel.Text}" />
                            </Trigger>
                            <Trigger Property="Kompakt" Value="True">
                                <Setter TargetName="Links" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Rechts" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Zahl" Property="Visibility" Value="Visible" />
                                <!-- Die Zahl braucht Höhe: Knauf 16 x 14 ohne Innenabstand der Spur, der Weg bleibt 12 -->
                                <Setter TargetName="PART_Spur" Property="Padding" Value="0" />
                                <Setter TargetName="PART_Knauf" Property="Width" Value="16" />
                                <Setter TargetName="PART_Knauf" Property="Height" Value="14" />
                                <Setter TargetName="PART_Knauf" Property="CornerRadius" Value="7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Schmal nur so viel Rand wie nötig: 30 plus 2, zwei Einheiten mehr als der alte Knopf (24 plus 5). -->
                <Trigger Property="Kompakt" Value="True">
                    <Setter Property="Margin" Value="1,0,1,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Zustand einer Kachel (A17, A18, Stufe 3): Punkt, Rand und Wort; gemeinsam für beide Ansichten ===== -->

        <!-- Fläche; Global in der Leitfarbe (A23) -->
        <Style x:Key="Kachel.Grund" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource Funkfeld.Kachel}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstGlobal}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Funkfeld.Global}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rand über dem Inhalt, damit ein dickerer Rand nichts verschiebt: HÖRT gelb, SENDET grün und dick, GESPERRT rot -->
        <Style x:Key="Kachel.Rand" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Linie}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Hoeren}">
                    <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Hoeren}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Senden}">
                    <Setter Property="BorderBrush" Value="{StaticResource Pinsel.Senden}" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Gesperrt}">
                    <Setter Property="BorderBrush" Value="{StaticResource Pinsel.RotSchrift}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          Ein leeres Feld und ein Feld auf Ruhe sind blass, aber nur ihr Inhalt: Die Fläche bleibt, sonst verschwände ein getrenntes
          Funkfeld (alle Felder leer) über hellem Spiel fast ganz. Name und Wort halten dabei 4,5:1 (Funkfeld.LeerDeckkraft, deckend
          0,55, auf Global je Farbstellung aus FunkfeldDeckung); bei 0,45 hatten sie nur 4,03:1 und 2,95:1.
        -->
        <Style x:Key="Kachel.Blass" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Leer}">
                    <Setter Property="Opacity" Value="{DynamicResource Funkfeld.LeerDeckkraft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Ruhe}">
                    <Setter Property="Opacity" Value="{DynamicResource Funkfeld.LeerDeckkraft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Name, Wort und Sprecher: im Zustand AUS gedimmt, aber lesbar (Funkfeld.AusDeckkraft, deckend 4,9:1) -->
        <Style x:Key="Kachel.Inhalt" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Aus}">
                    <Setter Property="Opacity" Value="{DynamicResource Funkfeld.AusDeckkraft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          Statuspunkt (Sarevoc, Stufe 3): grün gefüllt sendet, gelb gefüllt hört, rot mit weißem Querstrich nur gesperrt (Einsatzleitung
          oder Admin), grauer Ring aus; ohne Kanal und auf Ruhe keiner. Das Wort steht daneben (Zustandstext) und im Tooltip der Kachel.
        -->
        <Style x:Key="Punkt" TargetType="Grid">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="{Binding HatPunkt, Converter={StaticResource SichtbarWenn}}" />
        </Style>
        <Style x:Key="Punkt.Kreis" TargetType="Ellipse">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Fill" Value="{StaticResource Pinsel.Hoeren}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Senden}">
                    <Setter Property="Fill" Value="{StaticResource Pinsel.Senden}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Gesperrt}">
                    <Setter Property="Fill" Value="{StaticResource Pinsel.RotSchrift}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Aus}">
                    <!-- Hell genug, dass der Ring auch in der gedimmten Kachel AUS (0,7) 3:1 hält; Pinsel.TextAus käme nur auf 2,7:1 -->
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="{StaticResource Pinsel.Text2}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
                <!-- Klangstufe C2b (Q33): von der Einsatzleitung in diesem Kanal stummgeschaltet, rot wie eine Sperre; zuletzt, damit es gilt -->
                <DataTrigger Binding="{Binding StummGeschaltet}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Pinsel.RotSchrift}" />
                    <Setter Property="StrokeThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Punkt.Strich" TargetType="Rectangle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="1.6" />
            <Setter Property="Fill" Value="{StaticResource Pinsel.Text}" />
            <!-- Gesperrt (6.17) oder, seit Klangstufe C2b, von der Einsatzleitung einzeln stummgeschaltet (Q33): derselbe rote Punkt mit Querstrich -->
            <Setter Property="Visibility" Value="{Binding RoterPunkt, Converter={StaticResource SichtbarWenn}}" />
        </Style>

        <!--
          Klangstufe C2b: das gelbe "!" an einem Sprecher, der dauernd sendet (Klappwahl.Ausrufe aus Design\Stile.xaml), mit dem weißen Fokusrahmen des
          Funkfelds. Datenkontext ist das Zeichen der Kachel; ohne Zeichen ist es nicht da.
        -->
        <Style x:Key="Funkfeld.Ausrufe" TargetType="se:Klappwahl" BasedOn="{StaticResource Klappwahl.Ausrufe}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.Fokus}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <!--
          Mikro stumm (Klangstufe C2b, Q31 bis Q34): Knopf in der Titelzeile neben dem Regler, Glas wie die anderen Knöpfe des Funkfelds (Kachel.Knopf).
          Selbst gezeichnetes Mikrofon, mit Querstrich, wenn es stumm ist; rote Leuchte, wenn gar nichts hinausgeht; bei Stummschaltung durch die
          Einsatzleitung dazu das Schloss; "bis Uhrzeit" steht seit 0.6.2 nur im Tooltip, damit "Senden: ..." daneben ungekürzt bleibt. Datenkontext
          ist FunkfeldViewModel.Mikro.
        -->
        <Style x:Key="Mikro.Knopf" TargetType="Button" BasedOn="{StaticResource Kachel.Knopf}">
            <Setter Property="Padding" Value="5,0,5,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Funkfeld.FokusInnen}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="Mikro.Symbol" TargetType="Path" BasedOn="{StaticResource Symbol}">
            <Setter Property="Data" Value="{StaticResource Symbol.Mikrofon}" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- Q42: stumm (auch durch die Einsatzleitung) ist das Zeichen selbst rot, im Rot der Farbstellung wie die Leuchte; frei wie bisher -->
                <DataTrigger Binding="{Binding Querstrich}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Symbol.MikrofonStumm}" />
                    <Setter Property="Stroke" Value="{StaticResource Pinsel.RotSchrift}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sprecher live (A18); ohne Sprecher das Wort zum Zustand (auf Ruhe keins, der Ch.-Wähler sagt es), beim eigenen Senden "Du sprichst" in Grün -->
        <Style x:Key="Sprecher.Symbol" TargetType="Path" BasedOn="{StaticResource Symbol}">
            <Setter Property="Data" Value="{StaticResource Symbol.Sprecher}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource Pinsel.Text2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SprecherAktiv}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EigeneSendung}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Sprecher.Text" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Sprecher}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SprecherAktiv}" Value="False">
                    <Setter Property="Text" Value="{Binding ZustandText}" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
                </DataTrigger>
                <!-- FREI weiß: Das leere Feld dimmt seinen Inhalt, zweitrangige Schrift käme dann nur auf 3,6:1 -->
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Leer}">
                    <Setter Property="Foreground" Value="{StaticResource Pinsel.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Zustand}" Value="{x:Static m:KachelZustand.Ruhe}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EigeneSendung}" Value="True">
                    <Setter Property="Text" Value="Du sprichst" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource Pinsel.Senden}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Empfangspegel: orange (Hören), beim eigenen Senden grün; Q43: gelb, wenn du senden würdest, aber nichts hinausgeht. Die Spur bleibt dunkel und deckend -->
        <Style x:Key="Kachel.Pegel" TargetType="se:Anteilbalken">
            <Setter Property="Anteil" Value="{Binding PegelAnteil}" />
            <Setter Property="Spur" Value="{StaticResource Pinsel.FlaecheTief}" />
            <Setter Property="Fuellung" Value="{StaticResource Pinsel.Hoeren}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EigeneSendung}" Value="True">
                    <Setter Property="Fuellung" Value="{StaticResource Pinsel.Senden}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WuerdeSenden}" Value="True">
                    <Setter Property="Fuellung" Value="{StaticResource Pinsel.WuerdeSenden}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Aus-Schalter (A17) zeigt, was er tut: an = Aus-Symbol, aus = Hören-Symbol -->
        <Style x:Key="Aus.Symbol" TargetType="Path" BasedOn="{StaticResource Symbol}">
            <Setter Property="Data" Value="{StaticResource Symbol.Aus}" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Hoeren}" Value="False">
                    <Setter Property="Data" Value="{StaticResource Symbol.Hoeren}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ausloeser.Symbol" TargetType="Path" BasedOn="{StaticResource Symbol}">
            <Setter Property="Data" Value="{StaticResource Symbol.Sprechtaste}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sprachaktivierung}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Symbol.Sprachaktivierung}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== A Raster: je Feld Punkt, Name, Ch.-Wähler, Sprecher, Pegel, Regler, VA/Taste, Aus; etwa 150 x 79 ===== -->
        <DataTemplate x:Key="RasterVorlage" DataType="{x:Type m:KachelViewModel}">
            <Grid AutomationProperties.Name="{Binding Beschreibung}">
                <Border Style="{StaticResource Kachel.Grund}" />
                <Grid Style="{StaticResource Kachel.Blass}" Margin="6,5,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="19" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Sendekanal wählen: die obere Kachel, auch über dem Namen; nur der Ch.-Wähler liegt als eigenes Klappfeld darüber -->
                    <Button Grid.RowSpan="3" Style="{StaticResource Kachelkopf}" Click="Kachelkopf_Click" />
                    <DockPanel Style="{StaticResource Kachel.Inhalt}">
                        <Grid x:Name="Punkt" DockPanel.Dock="Left" Style="{StaticResource Punkt}" Margin="0,0,4,0">
                            <Ellipse Style="{StaticResource Punkt.Kreis}" />
                            <Rectangle Style="{StaticResource Punkt.Strich}" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Taste}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Margin="4,1,0,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False" />
                        <!-- Q44 (0.8.1): der Name als feste Beschriftung; den Kanal legen Rolle, Admin und Einsatzleitung fest -->
                        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Foreground="{StaticResource Pinsel.Text}" Margin="1,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,1,0,0" Style="{StaticResource Kachel.Inhalt}">
                        <se:Klappwahl x:Name="ChWaehler" DockPanel.Dock="Left" Style="{StaticResource Klappwahl.Ch}" MaxWidth="86" Margin="0,0,6,0"
                                      Visibility="{Binding HatCh, Converter={StaticResource SichtbarWenn}}" Eintraege="{Binding ChListe}"
                                      Gewaehlt="{Binding ChWahl, Mode=OneWay}" Waehlen="{Binding ChWaehlenCommand}" Schritt="{Binding ChSchrittCommand}"
                                      IsEnabled="{Binding ChWaehlbar}" gd:Hilfe.Text="{Binding ChHilfe}" gd:Hilfe.Gesperrt="{Binding ChHilfe}"
                                      AutomationProperties.Name="{Binding ChText, StringFormat='Ch.: {0}'}">
                            <TextBlock Text="{Binding ChText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </se:Klappwahl>
                        <!-- Global: fest auf Ch. 1 von Global (Global selbst), ohne Wähler -->
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ChText}" FontSize="11.5" Foreground="{StaticResource Pinsel.Text}" Margin="0,0,6,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IstGlobal, Converter={StaticResource SichtbarWenn}}" />
                        <Path DockPanel.Dock="Left" Style="{StaticResource Sprecher.Symbol}" IsHitTestVisible="False" />
                        <Image DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Source="{Binding SprecherZeichen.Bild}"
                               IsHitTestVisible="False" Visibility="{Binding HatSprecherZeichen, Converter={StaticResource SichtbarWenn}}" />
                        <!-- Klangstufe C2b: gelbes "!" vor dem Namen eines Dauersenders, klickbar (Auswahl), über dem Kachelkopf -->
                        <se:Klappwahl x:Name="DauersendZeichen" DockPanel.Dock="Left" Style="{StaticResource Funkfeld.Ausrufe}" Margin="0,0,3,0"
                                      DataContext="{Binding DauersendZeichen}" Visibility="{Binding Converter={StaticResource SichtbarWennWert}}" />
                        <TextBlock Style="{StaticResource Sprecher.Text}" FontSize="12" IsHitTestVisible="False" />
                    </DockPanel>
                    <se:Anteilbalken Grid.Row="2" Style="{StaticResource Kachel.Pegel}" Height="4" Margin="0,3,0,0" />

                    <!-- Lautstärke (A9), VA/Taste (A10, Q15), Hören an/aus (A17); Global hört immer (A23) -->
                    <DockPanel Grid.Row="3" Margin="0,4,0,0" Height="20">
                        <Button x:Name="AusKnopf" DockPanel.Dock="Right" Style="{StaticResource Kachel.Knopf}" Width="24" Command="{Binding HoerenUmschaltenCommand}"
                                Visibility="{Binding KannAusschalten, Converter={StaticResource SichtbarWenn}}"
                                gd:Hilfe.Text="{Binding AusSchalterText, StringFormat='Dieses Feld ganz aus- oder wieder einschalten ({0})'}"
                                AutomationProperties.Name="{Binding Name, StringFormat='{}{0} an oder aus'}">
                            <Path Style="{StaticResource Aus.Symbol}" />
                        </Button>
                        <Border DockPanel.Dock="Right" Width="24" Background="Transparent" ToolTip="Global hört immer."
                                Visibility="{Binding IstGlobal, Converter={StaticResource SichtbarWenn}}">
                            <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Hoeren}" Width="11" Height="11" Stroke="{StaticResource Pinsel.Text2}" />
                        </Border>
                        <ToggleButton x:Name="VaSchalter" DockPanel.Dock="Right" Style="{StaticResource VA.Umschalter}" Margin="4,0" IsChecked="{Binding Sprachaktivierung}"
                                      IsEnabled="{Binding KannSprachaktivierung}" gd:Hilfe.Text="Schaltet diesen Kanal zwischen Sprachaktivierung (VA, leuchtet grün) und Sprechtaste um; gilt für alle Ch. des Kanals."
                                      gd:Hilfe.Gesperrt="Nicht umschaltbar: Der Kanal erlaubt nur die Sprechtaste (vom Server festgelegt), das Feld ist noch frei, oder auf Start ist &quot;Senden mit Stimme&quot; ausgeschaltet."
                                      AutomationProperties.Name="{Binding Name, StringFormat='Sprachaktivierung {0}'}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ausloeser.Symbol}" />
                                <TextBlock Text="{Binding AusloesungText}" />
                            </StackPanel>
                        </ToggleButton>
                        <Slider Style="{StaticResource Kachel.Regler}" Minimum="-30" Maximum="12" SmallChange="0.5" LargeChange="3" Value="{Binding LautstaerkeDb}"
                                IsEnabled="{Binding HatNetz}" ToolTip="{Binding LautstaerkeText}" AutomationProperties.Name="{Binding Name, StringFormat='Lautstärke {0}'}" />
                    </DockPanel>
                </Grid>
                <Border Style="{StaticResource Kachel.Rand}" />
            </Grid>
        </DataTemplate>

        <!-- ===== C Liste: eine Zeile je Feld (Taste, Punkt, Name, Ch.-Wähler, Sprecher); etwa 256 x 26 ===== -->
        <DataTemplate x:Key="ListeVorlage" DataType="{x:Type m:KachelViewModel}">
            <Grid AutomationProperties.Name="{Binding Beschreibung}">
                <Border Style="{StaticResource Kachel.Grund}" />
                <Button Style="{StaticResource Kachelkopf}" FocusVisualStyle="{StaticResource Funkfeld.FokusZeile}" Click="Kachelkopf_Click" />
                <DockPanel Style="{StaticResource Kachel.Blass}" Margin="5,4,6,4">
                    <DockPanel Style="{StaticResource Kachel.Inhalt}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Taste}" FontSize="11" Foreground="{StaticResource Pinsel.Text2}" Width="10" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <Grid x:Name="Punkt" DockPanel.Dock="Left" Style="{StaticResource Punkt}" Margin="3,0,5,0">
                            <Ellipse Style="{StaticResource Punkt.Kreis}" />
                            <Rectangle Style="{StaticResource Punkt.Strich}" />
                        </Grid>
                        <DockPanel DockPanel.Dock="Right" MaxWidth="58" Margin="5,0,0,0" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Left" Style="{StaticResource Sprecher.Symbol}" />
                            <Image DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Source="{Binding SprecherZeichen.Bild}"
                                   Visibility="{Binding HatSprecherZeichen, Converter={StaticResource SichtbarWenn}}" />
                            <TextBlock Style="{StaticResource Sprecher.Text}" FontSize="12" />
                        </DockPanel>
                        <!-- Klangstufe C2b: gelbes "!" direkt vor dem Sprecher, außerhalb des durchklickbaren Teils, damit es sich klicken lässt -->
                        <se:Klappwahl x:Name="DauersendZeichen" DockPanel.Dock="Right" Style="{StaticResource Funkfeld.Ausrufe}" Margin="4,0,-3,0"
                                      DataContext="{Binding DauersendZeichen}" Visibility="{Binding Converter={StaticResource SichtbarWennWert}}" />
                        <!-- VA/Taste je Feld auch in der Liste (Sarevoc Q15, Schritt 3.5): derselbe Umschalter wie auf der Kachel, nur mit dem Wort -->
                        <ToggleButton x:Name="VaSchalter" DockPanel.Dock="Right" Style="{StaticResource VA.Umschalter}" Height="18" MinWidth="38" Padding="4,0" Margin="4,0,0,0" IsChecked="{Binding Sprachaktivierung}"
                                      IsEnabled="{Binding KannSprachaktivierung}" FocusVisualStyle="{StaticResource Funkfeld.Fokus}"
                                      Visibility="{Binding HatNetz, Converter={StaticResource SichtbarWenn}}"
                                      gd:Hilfe.Text="Schaltet diesen Kanal zwischen Sprachaktivierung (VA, leuchtet grün) und Sprechtaste um; gilt für alle Ch. des Kanals."
                                      gd:Hilfe.Gesperrt="Nicht umschaltbar: Der Kanal erlaubt nur die Sprechtaste (vom Server festgelegt), oder auf Start ist &quot;Senden mit Stimme&quot; ausgeschaltet."
                                      AutomationProperties.Name="{Binding Name, StringFormat='Sprachaktivierung {0}'}">
                            <TextBlock Text="{Binding AusloesungText}" />
                        </ToggleButton>
                        <se:Klappwahl x:Name="ChWaehler" DockPanel.Dock="Right" Style="{StaticResource Klappwahl.Ch}" MaxWidth="74" Margin="4,0,0,0" FocusVisualStyle="{StaticResource Funkfeld.FokusInnen}"
                                      Visibility="{Binding HatCh, Converter={StaticResource SichtbarWenn}}" Eintraege="{Binding ChListe}"
                                      Gewaehlt="{Binding ChWahl, Mode=OneWay}" Waehlen="{Binding ChWaehlenCommand}" Schritt="{Binding ChSchrittCommand}"
                                      IsEnabled="{Binding ChWaehlbar}" gd:Hilfe.Text="{Binding ChHilfe}" gd:Hilfe.Gesperrt="{Binding ChHilfe}"
                                      AutomationProperties.Name="{Binding ChText, StringFormat='Ch.: {0}'}">
                            <TextBlock Text="{Binding ChText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </se:Klappwahl>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChText}" FontSize="11.5" Foreground="{StaticResource Pinsel.Text}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IstGlobal, Converter={StaticResource SichtbarWenn}}" />
                        <!-- Q44 (0.8.1): der Name als feste Beschriftung, der Klick geht an die Zeile (Sendekanal wählen) -->
                        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Foreground="{StaticResource Pinsel.Text}" Margin="1,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </DockPanel>
                </DockPanel>
                <Border Style="{StaticResource Kachel.Rand}" />
            </Grid>
        </DataTemplate>

        <!-- Anordnung: Global immer als letztes Feld, im Raster rechts unten, in der Liste unten (A23) -->
        <ItemsPanelTemplate x:Key="RasterFlaeche">
            <se:Kachelraster MindestBreite="150" Abstand="4" BevorzugteSpalten="5" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListeFlaeche">
            <!-- 280: die Liste wird 288 breit (Entwurf 5.2 sah 264 vor; mit VA/Taste je Feld, Schritt 3.5, behält der Kanalname sonst keinen Platz), Platz für Kanal, VA/Taste und Ch.; der Text der Titelzeile bestimmt die Breite nicht mit -->
            <se:Kachelraster MindestBreite="280" Abstand="2" BevorzugteSpalten="1" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- Inhalt: Der Code setzt hier die Skalierung (LayoutTransform, -30 bis +30 %); Glas mit einfachem Schatten, das Fenster ist geschichtet -->
    <Grid x:Name="Inhalt" gd:Glas.Schatten="Einfach">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Titelzeile so schmal wie möglich: Marke, im Raster die Rollenliste und "Mehrere senden", die Sendekanäle (davor seit Klangstufe C2b das
          gelbe "!" des eigenen Urteils), Regler der Durchsichtigkeit, der Mikro-Knopf (C2b), Ansicht Raster oder Liste, in der Liste das Symbol des
          Reglers, der Schiebeschalter 5 oder 10, Schließen.
          Ziehen an jeder freien Stelle. Mit der Option "deckend halten" folgt ihre Fläche dem Regler wie die Lücken; Text, Regler und
          Knöpfe stehen auf eigenen dunklen Unterlagen, die deckend genug für ihren Inhalt bleiben.
        -->
        <Grid x:Name="Kopf" Background="{DynamicResource Funkfeld.Kopf}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Marke" Width="26" Background="{DynamicResource Funkfeld.Global}" ToolTip="Funkfeld">
                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Funkfeld}" Width="13" Height="13" StrokeThickness="1.8" Stroke="{StaticResource Pinsel.Text}" />
            </Border>
            <!--
              Rollenliste oben links (Q1, Q2, Q12) und "Mehrere senden": nur im Raster in der Titelzeile, in der Liste darunter
              (Kopf2). Sichtbar schaltet der Code (DarstellungAnwenden), damit die Mindestgröße schon im Konstruktor stimmt. Beide
              stehen auf einer dunklen Unterlage wie Text und Knöpfe rechts: Mit "deckend halten" bleibt ihr Grund lesbar.
            -->
            <Border x:Name="RolleUnterlage" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource Funkfeld.Unterlage}">
                <StackPanel Orientation="Horizontal">
                    <se:Klappwahl x:Name="RolleWahl" Style="{StaticResource Klappwahl.Rolle}" Width="196" Margin="3,0,2,0">
                        <DockPanel>
                            <TextBlock x:Name="RolleGeaendertText" DockPanel.Dock="Right" Text=" (geändert)" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Pinsel.Text2}" VerticalAlignment="Center"
                                       Visibility="{Binding RolleGeaendert, Converter={StaticResource SichtbarWenn}}" />
                            <TextBlock Text="{Binding RolleName}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                    </se:Klappwahl>
                    <ToggleButton x:Name="MehrfachSchalter" Style="{StaticResource Mehrfach.Schalter}" gd:Hilfe.Text="Mehrfachsenden: Ein Klick nimmt einen Kanal dazu oder heraus. Nur für Führung, Einsatzleitung und Admin. Strg+Klick geht auch ohne den Schalter.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Mehrfach.Haken}" Margin="0,0,5,0" />
                            <TextBlock Text="Mehrere senden" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>
            <!-- Sendekanäle, oder eine Ablehnung in roter Schrift (etwa "hier darfst du nicht senden"). Der Text bestimmt die
                 Breite nicht mit (Restbreite): Sonst zöge ein langer Name die Liste in die Breite. Die Ablehnung steht hier
                 statt in einer eigenen Zeile unter den Kacheln; die nahm den Kacheln sonst die Höhe, und der Pegel fiel weg.
                 Rechts daneben, direkt links der Fensterknöpfe, der Regler der Durchsichtigkeit (A30); auch er zählt nicht zur
                 Breite des Fensters: Wird es schmal, kürzt erst der Text, dann schneidet die Restbreite ab. -->
            <!-- Klangstufe C2b: davor das gelbe "!" des eigenen Urteils, zwischen Text und Regler der Mikro-Knopf; liegt der Regler in der Liste
                 aufgeklappt über der Breite, rückt der Knopf vor ihn (der Regler bleibt direkt links der Fensterknöpfe, A30). -->
            <se:Restbreite Grid.Column="3" Margin="2,0,2,0">
                <Grid x:Name="KopfMitte" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Klangstufe C2b: gelbes "!" des eigenen Urteils (Echo, Spielton, Raumgeräusch, klemmende Taste) vor der eigenen Sendeanzeige, Tooltip mit
                         Ursache und Hinweis; ohne Urteil nicht da -->
                    <ContentControl x:Name="EigenesUrteilZeichen" Style="{StaticResource Ausrufe}" Margin="1,0,3,0" DataContext="{Binding Dauersend}"
                                    Visibility="{Binding HatEigenesUrteil, Converter={StaticResource SichtbarWenn}}" gd:Hilfe.Text="{Binding EigeneHilfe}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding EigeneHilfe}" />
                    <TextBlock x:Name="KopfText" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="3,2" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Background="{DynamicResource Funkfeld.Unterlage}"
                               Visibility="{Binding ReglerBreit, Converter={StaticResource SichtbarWennNicht}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Hinweis}" />
                                <Setter Property="Foreground" Value="{StaticResource Pinsel.RotSchrift}" />
                                <Setter Property="ToolTip" Value="{Binding Hinweis}" />
                                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hinweis}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{Binding Kopfzeile}" />
                                        <Setter Property="Foreground" Value="{StaticResource Pinsel.Text2}" />
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="False" />
                                    </DataTrigger>
                                    <!-- Q41: die eigene Sendeanzeige grün, solange tatsächlich etwas hinausgeht -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Hinweis}" Value="{x:Null}" />
                                            <Condition Binding="{Binding SendetGerade}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{StaticResource Pinsel.Senden}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--
                      Mikro stumm (Klangstufe C2b, Q34: nur hier): zwischen "Senden: ..." und dem Regler der Durchsichtigkeit, in Raster und Liste. Ein Klick
                      schaltet das eigene Mikro stumm oder wieder an; eine Stummschaltung der Einsatzleitung zeigt Schloss und "bis Uhrzeit" und lässt sich
                      hier nicht aufheben. Auf eigener dunkler Unterlage wie Text und Regler (mit "deckend halten" lesbar).
                    -->
                    <Border x:Name="MikroUnterlage" Background="{DynamicResource Funkfeld.Unterlage}" Padding="1,0,1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Grid.Column" Value="3" />
                                <Setter Property="Margin" Value="3,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReglerBreit}" Value="True">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Margin" Value="0,0,3,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button x:Name="MikroKnopf" Style="{StaticResource Mikro.Knopf}" DataContext="{Binding Mikro}" Command="{Binding UmschaltenCommand}"
                                gd:Hilfe.Text="{Binding KnopfHilfe}" AutomationProperties.Name="{Binding ZustandText}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="MikroSymbol" Style="{StaticResource Mikro.Symbol}" />
                                <Path x:Name="MikroSchloss" Data="{StaticResource Funkfeld.Schloss}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="10" Height="10" Margin="3,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding LeitungStumm, Converter={StaticResource SichtbarWenn}}" />
                                <!-- rote Leuchte: nichts geht hinaus (selbst stumm oder durch die Einsatzleitung in allen Kanälen); rot wie eine Sperre, mit dunklem Ring auf dem Glas -->
                                <Ellipse x:Name="MikroLeuchte" Width="8" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{StaticResource Pinsel.RotSchrift}"
                                         Stroke="{StaticResource Pinsel.FlaecheTief}" StrokeThickness="1"
                                         Visibility="{Binding Leuchte, Converter={StaticResource SichtbarWenn}}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <!-- Raster: rechts neben dem Text, 72 breit. Liste aufgeklappt: über die ganze Breite, der Text ruht. Der Wert
                         daneben zeigt, was der Regler gerade zeigt, auch beim Ziehen über 0 hinweg (FunkfeldViewModel.ReglerWert). -->
                    <Border x:Name="ReglerUnterlage" Background="{DynamicResource Funkfeld.Unterlage}" Padding="5,0,4,0"
                            Visibility="{Binding ReglerSichtbar, Converter={StaticResource SichtbarWenn}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Grid.Column" Value="4" />
                                <Setter Property="Margin" Value="4,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReglerBreit}" Value="True">
                                        <Setter Property="Grid.Column" Value="2" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock x:Name="ReglerWertText" DockPanel.Dock="Right" Text="{Binding ReglerText}" FontSize="11" Width="28" Margin="4,0,0,0"
                                       TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Pinsel.Text2}" />
                            <Slider x:Name="TitelRegler" Style="{StaticResource Titel.Regler}" Value="{Binding ReglerWert}" ToolTip="{Binding ReglerHinweis}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </se:Restbreite>
            <Border x:Name="KnopfUnterlage" Grid.Column="4" Grid.ColumnSpan="4" Background="{DynamicResource Funkfeld.Unterlage}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0"
                        Visibility="{Binding ReglerBreit, Converter={StaticResource SichtbarWennNicht}}">
                <RadioButton Style="{StaticResource Kopf.Wahl}" IsChecked="{Binding IstRaster}" gd:Hilfe.Text="Ansicht Raster: 2 Reihen mit Reglern."
                             AutomationProperties.Name="Ansicht Raster">
                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.AnsichtRaster}" Width="13" Height="13" StrokeThickness="1.4" />
                </RadioButton>
                <RadioButton Style="{StaticResource Kopf.Wahl}" IsChecked="{Binding IstListe}" gd:Hilfe.Text="Ansicht Liste: schmal für den Bildschirmrand."
                             AutomationProperties.Name="Ansicht Liste">
                    <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.AnsichtListe}" Width="13" Height="13" StrokeThickness="1.4" />
                </RadioButton>
            </StackPanel>
            <!-- Nur in der Liste: klappt den Regler auf und zu (Escape im Regler klappt zu). Rechts der Ansichten, damit es beim
                 Aufklappen nicht springt, wenn die Ansichten ruhen. -->
            <ToggleButton x:Name="ReglerSymbol" Grid.Column="5" Style="{StaticResource Kopf.Wahl}" Margin="0" IsChecked="{Binding ReglerOffen}"
                          Visibility="{Binding IstListe, Converter={StaticResource SichtbarWenn}}"
                          gd:Hilfe.Text="Klappt den Regler für die Durchsichtigkeit des Funkfelds auf oder zu." AutomationProperties.Name="Regler der Durchsichtigkeit auf- oder zuklappen">
                <Path Style="{StaticResource Symbol}" Data="{StaticResource Symbol.Durchsicht}" Width="13" Height="13" StrokeThickness="1.4" />
            </ToggleButton>
            <!-- 5 oder 10 Felder als Schiebeschalter (A33), dieselbe Einstellung wie unter Einstellungen -->
            <se:Schiebeschalter x:Name="FeldSchalter" Grid.Column="6" Style="{StaticResource Titel.Schalter}" IsChecked="{Binding IstZehner}"
                                Kompakt="{Binding IstListe}" />
            <Button Grid.Column="7" Style="{StaticResource Knopf.Schliessen}" Content="&#xE8BB;" Height="24" Width="30"
                    Command="SystemCommands.CloseWindowCommand" WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="{Binding AblegenTooltip}" AutomationProperties.Name="Funkfeld ablegen" />
        </Grid>

        <!--
          Liste: zweite Kopfzeile mit der Rollenliste über die Breite und "Mehrere senden" als Symbol (STUFE3-ENTWURF 5.2), ganz auf
          der dunklen Unterlage wie die Bedienelemente der Titelzeile (mit "deckend halten" lesbar über hellem Spielbild).
        -->
        <Grid x:Name="Kopf2" Grid.Row="1" Height="24" Background="{DynamicResource Funkfeld.Unterlage}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <se:Klappwahl x:Name="RolleWahlListe" Style="{StaticResource Klappwahl.Rolle}" Margin="3,0,2,0">
                <DockPanel>
                    <TextBlock x:Name="RolleGeaendertTextListe" DockPanel.Dock="Right" Text=" (geändert)" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Pinsel.Text2}" VerticalAlignment="Center"
                               Visibility="{Binding RolleGeaendert, Converter={StaticResource SichtbarWenn}}" />
                    <TextBlock Text="{Binding RolleName}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </se:Klappwahl>
            <ToggleButton x:Name="MehrfachSymbol" Grid.Column="1" Style="{StaticResource Mehrfach.Schalter}" Padding="0" Width="28"
                          gd:Hilfe.Text="Mehrfachsenden: Ein Klick nimmt einen Kanal dazu oder heraus. Nur für Führung, Einsatzleitung und Admin. Strg+Klick geht auch ohne den Schalter.">
                <Path Style="{StaticResource Mehrfach.Haken}" />
            </ToggleButton>
        </Grid>

        <!-- Felder, Vorlage, Fläche und Rand je Ansicht setzt der Code (FunkfeldFenster.DarstellungAnwenden), vor dem Messen der optimalen Größe -->
        <ItemsControl x:Name="Felder" Grid.Row="2" Focusable="False" KeyboardNavigation.TabNavigation="Continue" />
    </Grid>
</Window>
