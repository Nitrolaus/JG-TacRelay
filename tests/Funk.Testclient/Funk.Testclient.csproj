<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Funk.Protokoll\Funk.Protokoll.csproj" />
    <ProjectReference Include="..\..\src\Funk.ClientKern\Funk.ClientKern.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Simulierte Funker gegen einen Server (Lasttest nach server-sicherheit.md B20), auf Basis von Funk.ClientKern. -->
