<?xml version="1.0" encoding="utf-8"?>
<!--
  Absichtlich ohne nuget.org: Ein Build darf nichts aus dem Netz nachladen.
  Neue Pakete kommen nur nach ausdrücklicher Freigabe in den Zonen-Cache
  C:\Claude\tools\nuget-packages (siehe tools\dev-umgebung.ps1).
-->
<configuration>
  <config>
    <!-- Entpackte Pakete in der Zone, auch aus einer Shell ohne dev-umgebung.ps1 (NUGET_PACKAGES leer); sonst nähme
         jedes Restore den Standardordner im Benutzerprofil. -->
    <add key="globalPackagesFolder" value="C:\Claude\tools\nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="zone" value="C:\Claude\tools\nuget-packages" />
  </packageSources>
</configuration>
