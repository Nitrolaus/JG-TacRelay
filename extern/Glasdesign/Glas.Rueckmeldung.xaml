<!-- Glasdesign - Maintainer: Sarevoc -->
<!--
  Stilfamilien 2, Stufe 2, Teilschritt A1 (0.5.0-beta.8): Rückmeldungen. Tooltip mit Zipfel (gd:Sprechblase), Toast und
  Toast-Stapel, Hinweisbanner, Dialog, Skelettzeilen, Spinner und Leerzustand, je in Glas 4 und in den Familien ihres
  Vorbilds (Taktil, Glutglas). Glas.Stile.xaml bindet diese Datei nach Glas.Familien.xaml ein; sie steht für sich: nach
  außen nur DynamicResource, auch für Stile aus anderen Dateien (Knöpfe der Familien). Vorgabestile nur für die neuen
  gd:-Typen (unten), keiner für ToolTip. Die Schrift folgt der Fläche, auf der sie steht (Schriftwahl, LIESMICH 4n):
  Glas 4 über gd:Schriftwahl.Wandler mit dem Background als Fläche, Taktil und Glutglas über ihren Körper.
  Zustände wie überall: überfahren, gedrückt, Fokus (nur nach Tastatur), gesperrt zuletzt; die Zustandsvorschau reicht an
  die Knöpfe darin (Schließen, Abbrechen, Bestätigen).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gd="clr-namespace:Glasdesign">

    <!-- Text in Meldungen, Tooltips und Dialogen bricht um. -->
    <Style x:Key="Glas.Rueckmeldung.Teil.Text" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Glas.Rueckmeldung.Teil.TextMittig" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================== Tooltip mit Zipfel -->

    <!-- Glas 4: Material der Hilfekarte, Zipfel unten mittig, mittig über dem Ziel (gd:Sprechblase.Darueber). Der Rand um
         die Blase gibt dem Schatten Platz im Popup; VerticalOffset rückt den Zipfel bis 6 DIP an das Ziel heran. -->
    <ControlTemplate x:Key="Glas.Vorlage.Tooltip.Zipfel" TargetType="ToolTip">
        <gd:Sprechblase x:Name="Blase" Margin="18,12,18,22" Zipfelseite="Unten" Ecke="6"
                        Zipfelgroesse="{DynamicResource Glas.Mass.Sprechblase.Zipfel}"
                        Fuellung="{TemplateBinding Background}" Rand="{TemplateBinding BorderBrush}" Innenabstand="{TemplateBinding Padding}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True">
            <ContentPresenter>
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                </ContentPresenter.Resources>
            </ContentPresenter>
        </gd:Sprechblase>
    </ControlTemplate>

    <Style x:Key="Glas.Tooltip.Zipfel" TargetType="ToolTip">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Tooltip.Zipfel}" />
        <Setter Property="Background" Value="{DynamicResource Glas.Karte}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glas.Karte.Linie}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Karte.Text}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{x:Static gd:Schriftwahl.Wandler}">
                    <Binding Path="(gd:Glas.Schriftwunsch)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Hilfe.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Hilfe.Innenabstand}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Glas.Mass.Hilfe.Breite}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Custom" />
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static gd:Sprechblase.Darueber}" />
        <Setter Property="VerticalOffset" Value="16" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Taktil (Vorbild "More details"): gehobene dunkle Fläche, feiner Kupferrand, Zipfel nach unten. -->
    <Style x:Key="Glas.Taktil.Tooltip" TargetType="ToolTip" BasedOn="{StaticResource Glas.Tooltip.Zipfel}">
        <Setter Property="gd:Glas.Ableitungsquelle" Value="{DynamicResource Glas.Taktil.Flaeche.Farbe}" />
        <Setter Property="Background">
            <Setter.Value>
                <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
                    <Binding.Converter>
                        <gd:Farbableitung Von="#FF2E2E2F" Zu="#FF363637" ZuUnten="#FF2A2A2B" />
                    </Binding.Converter>
                </Binding>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource Glas.Taktil.Kupfer}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <gd:Sprechblase x:Name="Blase" Margin="18,12,18,22" Zipfelseite="Unten" Ecke="6"
                                    Zipfelgroesse="{DynamicResource Glas.Mass.Sprechblase.Zipfel}"
                                    Fuellung="{TemplateBinding Background}" Rand="{TemplateBinding BorderBrush}" Innenabstand="{TemplateBinding Padding}"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </gd:Sprechblase>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Schließknöpfe der Familien -->

    <!-- Taktil: nur das Kreuz; überfahren hebt sich ein runder Knopf heraus, gedrückt sinkt er ein, Fokus der Kupfersaum. -->
    <Style x:Key="Glas.Taktil.Teil.Schliessen" TargetType="ButtonBase">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="Schließen" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <gd:Leuchtsaum x:Name="Saum" Rundung="0.5" EigenerTon="{DynamicResource Glas.Taktil.Kupfer}" />
                        <gd:Taktilkoerper x:Name="Koerper" Ebene="Gehoben" Rundung="0.5" Visibility="Hidden" />
                        <gd:Glassymbol x:Name="Zeichen" Symbol="Kreuz" Anteil="0.36" StrichAnteil="0.07" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Ueberfahren" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Ueberfahren">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Ueberfahren" />
                        </Trigger>
                        <Trigger Property="gd:Glas.Tastaturfokus" Value="True">
                            <Setter TargetName="Saum" Property="Fokus" Value="True" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Fokus">
                            <Setter TargetName="Saum" Property="Fokus" Value="True" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Gedrueckt" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Gedrueckt">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Gedrueckt" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glutglas: das Kreuz oben rechts; überfahren und gedrückt eine kleine Rauchglasscheibe, Fokus der Saum im Glutton. -->
    <Style x:Key="Glas.Glutglas.Teil.Schliessen" TargetType="ButtonBase" BasedOn="{StaticResource Glas.Taktil.Teil.Schliessen}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <gd:Leuchtsaum x:Name="Saum" Form="Pille" EigenerTon="{DynamicResource Glas.Glutglas.Glut}" />
                        <gd:Glutscheibe x:Name="Koerper" Rundung="0.5" Visibility="Hidden" />
                        <gd:Glassymbol x:Name="Zeichen" Symbol="Kreuz" Anteil="0.4" StrichAnteil="0.07" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Ueberfahren" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Ueberfahren">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Ueberfahren" />
                        </Trigger>
                        <Trigger Property="gd:Glas.Tastaturfokus" Value="True">
                            <Setter TargetName="Saum" Property="Fokus" Value="True" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Fokus">
                            <Setter TargetName="Saum" Property="Fokus" Value="True" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Gedrueckt" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Gedrueckt">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Koerper" Property="Zustand" Value="Gedrueckt" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Koerper" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Toast und Toast-Stapel -->

    <!-- Glas 4: schwebende Fläche im Material der Hilfekarte (Sprechblase ohne Zipfel, Schatten von Glas 4), rechts der
         Schließknopf als runder Glasknopf mit Kreuz. -->
    <ControlTemplate x:Key="Glas.Vorlage.Toast" TargetType="gd:Toast">
        <gd:Sprechblase x:Name="Blase" Zipfelseite="Keine" Ecke="{DynamicResource Glas.Mass.Feld.Ecke}"
                        Fuellung="{TemplateBinding Background}" Rand="{TemplateBinding BorderBrush}" Innenabstand="{TemplateBinding Padding}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Inhalt" Margin="0,0,10,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <Button x:Name="Zu" Grid.Column="1" Style="{DynamicResource Glas.Knopf.Rund}" Width="26" Height="26" MinWidth="0" VerticalAlignment="Center"
                        Command="{x:Static gd:Toast.Schliessen}" AutomationProperties.Name="Schließen"
                        gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}">
                    <gd:Glassymbol Symbol="Kreuz" Anteil="0.34" />
                </Button>
            </Grid>
        </gd:Sprechblase>
        <ControlTemplate.Triggers>
            <Trigger Property="Schliessbar" Value="False">
                <Setter TargetName="Zu" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Inhalt" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Toast" TargetType="gd:Toast">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Toast}" />
        <Setter Property="Background" Value="{DynamicResource Glas.Karte}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glas.Karte.Linie}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Karte.Text}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{x:Static gd:Schriftwahl.Wandler}">
                    <Binding Path="(gd:Glas.Schriftwunsch)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Rueckmeldung.Innenabstand}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Taktil (Vorbild "Toast Stack"): gehobene Fläche, Text hell und kräftig, rechts das Kreuz. -->
    <ControlTemplate x:Key="Glas.Vorlage.Taktil.Toast" TargetType="gd:Toast">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Taktilkoerper x:Name="Koerper" Ebene="Gehoben" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}"
                              Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True" />
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Inhalt" Margin="0,0,10,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <Button x:Name="Zu" Grid.Column="1" Style="{StaticResource Glas.Taktil.Teil.Schliessen}" VerticalAlignment="Center"
                        Foreground="{TemplateBinding Foreground}" Command="{x:Static gd:Toast.Schliessen}"
                        gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Schliessbar" Value="False">
                <Setter TargetName="Zu" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Inhalt" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Taktil.Toast" TargetType="gd:Toast">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Taktil.Toast}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Rueckmeldung.Innenabstand}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Glutglas (Vorbild "Toast"): Rauchglas mit Versatzscheibe, Kantenglut unten, Kreuz oben rechts, Text in zwei Zeilen. -->
    <ControlTemplate x:Key="Glas.Vorlage.Glutglas.Toast" TargetType="gd:Toast">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Glutscheibe x:Name="Koerper" Versatz="{DynamicResource Glas.Mass.Glutglas.Versatz}" Farbe="{TemplateBinding Background}" Glut="0.75" Kantenglut="0.85"
                            Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True"
                            gd:Glas.Ableitungsquelle="{DynamicResource Glas.Mass.Glutglas.Ecke}">
                <gd:Glutscheibe.Ecke>
                    <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}" Converter="{x:Static gd:Glasumrechnung.Kartenecke}" />
                </gd:Glutscheibe.Ecke>
            </gd:Glutscheibe>
            <ContentPresenter x:Name="Inhalt" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                </ContentPresenter.Resources>
            </ContentPresenter>
            <Button x:Name="Zu" Style="{StaticResource Glas.Glutglas.Teil.Schliessen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                    Foreground="{TemplateBinding Foreground}" Command="{x:Static gd:Toast.Schliessen}"
                    gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Schliessbar" Value="False">
                <Setter TargetName="Zu" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Glutglas.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Glutglas.Toast" TargetType="gd:Toast">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Glutglas.Toast}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Glutglas.Schrift}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Glas.Glutglas.Glut}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Glutglas.Schrift}" />
        <Setter Property="Padding" Value="14,10,32,14" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Stapel: untereinander mit gleichem Abstand; die Familie der Toasts über ItemContainerStyle. -->
    <Style x:Key="Glas.Toaststapel" TargetType="gd:Toaststapel">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <gd:Abstandsstapel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gd:Toaststapel">
                    <ItemsPresenter UseLayoutRounding="True" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================================================================== Hinweisbanner -->

    <!-- Glas 4: wie Glas.Feld, die Leiste links und das Zeichen in der Statusfarbe der Art. -->
    <ControlTemplate x:Key="Glas.Vorlage.Hinweisbanner" TargetType="gd:Hinweisbanner">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Feldkoerper Flaeche="{TemplateBinding Background}" Rand="{TemplateBinding BorderBrush}" Akzent="{TemplateBinding Statusfarbe}"
                            Ecke="{DynamicResource Glas.Mass.Feld.Ecke}" Randbreite="{DynamicResource Glas.Mass.Feld.Rand}"
                            Akzentbreite="{DynamicResource Glas.Mass.Feld.Akzentbreite}" Glanz="{DynamicResource Glas.Mass.Feld.Glanz}" />
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <gd:Statuszeichen x:Name="Zeichen" Art="{TemplateBinding Art}" Farbe="{TemplateBinding Statusfarbe}" Width="18" Height="18"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Zeichen" Property="Farbe" Value="{DynamicResource Glas.Schrift.Gesperrt}" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Text.Gedaempft}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Hinweisbanner" TargetType="gd:Hinweisbanner">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Hinweisbanner}" />
        <Setter Property="Background" Value="{DynamicResource Glas.Feld.Flaeche}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glas.Feld.Rand}" />
        <Setter Property="Statusfarbe" Value="{DynamicResource Glas.Status.Info}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Text}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{x:Static gd:Schriftwahl.Wandler}">
                    <Binding Path="(gd:Glas.Schriftwunsch)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Feld.Innenabstand}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Art" Value="Erfolg">
                <Setter Property="Statusfarbe" Value="{DynamicResource Glas.Status.Erfolg}" />
            </Trigger>
            <Trigger Property="Art" Value="Warnung">
                <Setter Property="Statusfarbe" Value="{DynamicResource Glas.Status.Warnung}" />
            </Trigger>
            <Trigger Property="Art" Value="Fehler">
                <Setter Property="Statusfarbe" Value="{DynamicResource Glas.Status.Gefahr}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Taktil (Vorbild "Alert Banner"): gehobene, warm getönte Fläche (Familienfläche mit einem Viertel der Statusfarbe),
         das Zeichen gefüllt, bei Warnung das Dreieck in Bernstein. -->
    <ControlTemplate x:Key="Glas.Vorlage.Taktil.Hinweisbanner" TargetType="gd:Hinweisbanner">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Taktilkoerper x:Name="Koerper" Ebene="Kupfer" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}"
                              Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True"
                              gd:Glas.Ableitungsquelle="{DynamicResource Glas.Taktil.Flaeche.Farbe}">
                <gd:Taktilkoerper.Farbe>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <gd:Farbmischung Anteil="0.24" />
                        </MultiBinding.Converter>
                        <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="Statusfarbe" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                </gd:Taktilkoerper.Farbe>
            </gd:Taktilkoerper>
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <gd:Statuszeichen x:Name="Zeichen" Art="{TemplateBinding Art}" Farbe="{TemplateBinding Statusfarbe}" Gefuellt="True" Width="20" Height="20"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.Text}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Zeichen" Property="Farbe" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Taktil.Hinweisbanner" TargetType="gd:Hinweisbanner" BasedOn="{StaticResource Glas.Hinweisbanner}">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Taktil.Hinweisbanner}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Rueckmeldung.Innenabstand}" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- ===================================================================== Dialog -->

    <!-- Glas 4: Karte im Material der Hilfekarte mit Schatten, Zeichen im Akzent, Titel, Text, Abbrechen und Bestätigen. -->
    <ControlTemplate x:Key="Glas.Vorlage.Dialog" TargetType="gd:Dialog">
        <gd:Sprechblase x:Name="Blase" Zipfelseite="Keine" Ecke="{DynamicResource Glas.Mass.Feld.Ecke}"
                        Fuellung="{TemplateBinding Background}" Rand="{TemplateBinding BorderBrush}" Innenabstand="{TemplateBinding Padding}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True">
            <StackPanel>
                <gd:Glassymbol x:Name="Zeichen" Symbol="{TemplateBinding Symbol}" Width="28" Height="28" Anteil="1" StrichAnteil="0.08"
                               HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource Glas.Akzent}" />
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,0,0,6"
                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="{DynamicResource Glas.Mass.Knopf.Schrift}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter HorizontalAlignment="Center">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <UniformGrid Columns="2" Margin="0,18,0,0">
                    <Button x:Name="PART_Abbrechen" Style="{DynamicResource Glas.Knopf}" Margin="0,0,6,0" Padding="10,0,10,1" Content="{TemplateBinding AbbrechenText}"
                            Command="{x:Static gd:Dialog.Abbrechen}" gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
                    <Button x:Name="PART_Bestaetigen" Style="{DynamicResource Glas.Knopf.Haupt}" Margin="6,0,0,0" Padding="10,0,10,1" Content="{TemplateBinding BestaetigenText}"
                            Command="{x:Static gd:Dialog.Bestaetigen}" gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
                </UniformGrid>
            </StackPanel>
        </gd:Sprechblase>
        <ControlTemplate.Triggers>
            <Trigger Property="Symbol" Value="Keins">
                <Setter TargetName="Zeichen" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Die Vorschau Fokus nur am Knopf, der beim Erscheinen den Fokus bekäme (Startknopf): gefährlich Abbrechen,
                 sonst Bestätigen. Am Bildschirm hat immer nur einer den Fokus; überfahren und gedrückt erreichen beide. -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="gd:Glas.ZustandVorschau" Value="Fokus" />
                    <Condition Property="Gefaehrlich" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Bestaetigen" Property="gd:Glas.ZustandVorschau" Value="Keine" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="gd:Glas.ZustandVorschau" Value="Fokus" />
                    <Condition Property="Gefaehrlich" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Abbrechen" Property="gd:Glas.ZustandVorschau" Value="Keine" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Schrift.Gesperrt}" />
                <Setter TargetName="Zeichen" Property="Foreground" Value="{DynamicResource Glas.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Dialog" TargetType="gd:Dialog">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Dialog}" />
        <Setter Property="Background" Value="{DynamicResource Glas.Karte}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glas.Karte.Linie}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Karte.Text}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{x:Static gd:Schriftwahl.Wandler}">
                    <Binding Path="(gd:Glas.Schriftwunsch)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Dialog.Innenabstand}" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Taktil (Vorbild "Modal Confirmation"): Karte mit Bronzefassung, Abbrechen gehoben, Bestätigen in Kupfer. Den Schatten
         der großen Karte zeichnet die Sprechblase als Ringe (der Unschärfeeffekt der Karte kostete bei 175 Prozent rund
         15 ms je Bild). -->
    <ControlTemplate x:Key="Glas.Vorlage.Taktil.Dialog" TargetType="gd:Dialog">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Sprechblase Zipfelseite="Keine" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}" />
            <gd:Taktilkoerper x:Name="Koerper" Ebene="Karte" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}" Schatten="Aus"
                              Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True" />
            <gd:Fassungsrand Farbe="{DynamicResource Glas.Taktil.Fassung.Farbe}" Breite="{DynamicResource Glas.Mass.Taktil.Fassung}" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}" />
            <StackPanel Margin="{TemplateBinding Padding}">
                <gd:Glassymbol x:Name="Zeichen" Symbol="{TemplateBinding Symbol}" Width="28" Height="28" Anteil="1" StrichAnteil="0.09"
                               HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource Glas.Taktil.Kupfer}" />
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,0,0,6"
                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="{DynamicResource Glas.Mass.Taktil.Schrift}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter HorizontalAlignment="Center">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <UniformGrid Columns="2" Margin="0,18,0,0">
                    <Button x:Name="PART_Abbrechen" Style="{DynamicResource Glas.Taktil.Knopf}" Margin="0,0,6,0" Padding="10,0,10,1" Content="{TemplateBinding AbbrechenText}"
                            Command="{x:Static gd:Dialog.Abbrechen}" gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
                    <Button x:Name="PART_Bestaetigen" Style="{DynamicResource Glas.Taktil.Knopf.Haupt}" Margin="6,0,0,0" Padding="10,0,10,1" Content="{TemplateBinding BestaetigenText}"
                            Command="{x:Static gd:Dialog.Bestaetigen}" gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
                </UniformGrid>
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Symbol" Value="Keins">
                <Setter TargetName="Zeichen" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Die Vorschau Fokus nur am Startknopf (wie Glas.Vorlage.Dialog). -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="gd:Glas.ZustandVorschau" Value="Fokus" />
                    <Condition Property="Gefaehrlich" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Bestaetigen" Property="gd:Glas.ZustandVorschau" Value="Keine" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="gd:Glas.ZustandVorschau" Value="Fokus" />
                    <Condition Property="Gefaehrlich" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Abbrechen" Property="gd:Glas.ZustandVorschau" Value="Keine" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Zeichen" Property="Foreground" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Taktil.Dialog" TargetType="gd:Dialog">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Taktil.Dialog}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Dialog.Innenabstand}" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Glutglas (Vorbild "Modal"): zwei versetzte Scheiben mit Glut, oben die Raute als gefülltes Glas in kühlem Licht
         (andere Zeichen als Linie in derselben Farbe), Abbrechen als Zweitknopf, Bestätigen glüht. -->
    <ControlTemplate x:Key="Glas.Vorlage.Glutglas.Dialog" TargetType="gd:Dialog">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Glutscheibe x:Name="Koerper" Versatz="{DynamicResource Glas.Mass.Glutglas.Versatz}" Farbe="{TemplateBinding Background}" Glut="0.9" Kantenglut="0.8"
                            Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True"
                            gd:Glas.Ableitungsquelle="{DynamicResource Glas.Mass.Glutglas.Ecke}">
                <gd:Glutscheibe.Ecke>
                    <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}" Converter="{x:Static gd:Glasumrechnung.Kartenecke}" />
                </gd:Glutscheibe.Ecke>
            </gd:Glutscheibe>
            <StackPanel Margin="{TemplateBinding Padding}">
                <gd:Glutraute x:Name="Raute" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"
                              Farbe="{DynamicResource Glas.Glutglas.Symbol.Farbe}" />
                <gd:Glassymbol x:Name="Zeichen" Symbol="{TemplateBinding Symbol}" Width="28" Height="28" Anteil="1" StrichAnteil="0.08"
                               HorizontalAlignment="Center" Margin="0,0,0,12">
                    <gd:Glassymbol.Foreground>
                        <SolidColorBrush Color="{DynamicResource Glas.Glutglas.Symbol.Farbe}" />
                    </gd:Glassymbol.Foreground>
                </gd:Glassymbol>
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,0,0,6"
                                  TextElement.FontSize="{DynamicResource Glas.Mass.Glutglas.Schrift}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter HorizontalAlignment="Center">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <UniformGrid Columns="2" Margin="0,18,0,0">
                    <Button x:Name="PART_Abbrechen" Style="{DynamicResource Glas.Glutglas.Knopf}" Margin="0,0,8,0" Padding="10,0,10,1" Content="{TemplateBinding AbbrechenText}"
                            Command="{x:Static gd:Dialog.Abbrechen}" gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
                    <Button x:Name="PART_Bestaetigen" Style="{DynamicResource Glas.Glutglas.Knopf.Haupt}" Margin="8,0,0,0" Padding="10,0,10,1" Content="{TemplateBinding BestaetigenText}"
                            Command="{x:Static gd:Dialog.Bestaetigen}" gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" />
                </UniformGrid>
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Symbol" Value="Keins">
                <Setter TargetName="Zeichen" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Symbol" Value="Raute">
                <Setter TargetName="Zeichen" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Raute" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Die Vorschau Fokus nur am Startknopf (wie Glas.Vorlage.Dialog). -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="gd:Glas.ZustandVorschau" Value="Fokus" />
                    <Condition Property="Gefaehrlich" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Bestaetigen" Property="gd:Glas.ZustandVorschau" Value="Keine" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="gd:Glas.ZustandVorschau" Value="Fokus" />
                    <Condition Property="Gefaehrlich" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Abbrechen" Property="gd:Glas.ZustandVorschau" Value="Keine" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Raute" Property="Opacity" Value="0.45" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Glutglas.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Glutglas.Dialog" TargetType="gd:Dialog">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Glutglas.Dialog}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Glutglas.Schrift}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Glas.Glutglas.Glut}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="{DynamicResource Glas.Mass.Dialog.Innenabstand}" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================================================================== Skelettzeilen -->

    <!-- Glas 4: Kreis und Balken als Mulde (Fläche und Rand des Textfelds), der Schimmer ein Hauch Licht. -->
    <ControlTemplate x:Key="Glas.Vorlage.Skelett" TargetType="gd:Skelett">
        <gd:Skelettbild x:Name="Bild" Margin="{TemplateBinding Padding}" Zeilen="{TemplateBinding Zeilen}" Kreis="{TemplateBinding Kreis}"
                        Laengen="{TemplateBinding Laengen}" Balken="{TemplateBinding Balken}" Rand="{TemplateBinding Rand}"
                        Schimmer="{TemplateBinding Schimmer}" Balkenhoehe="{TemplateBinding Balkenhoehe}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True" />
    </ControlTemplate>

    <Style x:Key="Glas.Skelett" TargetType="gd:Skelett">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Skelett}" />
        <Setter Property="Balken" Value="{DynamicResource Glas.Textfeld.Flaeche}" />
        <Setter Property="Rand" Value="{DynamicResource Glas.Textfeld.Rand}" />
        <Setter Property="Schimmer">
            <Setter.Value>
                <SolidColorBrush Color="#1FFFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="Balkenhoehe" Value="{DynamicResource Glas.Mass.Skelett.Balken}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Taktil (Vorbild "Skeleton Rows"): eingelassene Tafel, darin Kreis und vier Balken, heller als die Fläche. -->
    <ControlTemplate x:Key="Glas.Vorlage.Taktil.Skelett" TargetType="gd:Skelett">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Taktilkoerper x:Name="Koerper" Ebene="Eingelassen" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}" />
            <gd:Skelettbild x:Name="Bild" Margin="{TemplateBinding Padding}" Zeilen="{TemplateBinding Zeilen}" Kreis="{TemplateBinding Kreis}"
                            Laengen="{TemplateBinding Laengen}" Balken="{TemplateBinding Balken}" Rand="{TemplateBinding Rand}"
                            Schimmer="{TemplateBinding Schimmer}" Balkenhoehe="{TemplateBinding Balkenhoehe}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Taktil.Skelett" TargetType="gd:Skelett" BasedOn="{StaticResource Glas.Skelett}">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Taktil.Skelett}" />
        <Setter Property="gd:Glas.Ableitungsquelle" Value="{DynamicResource Glas.Taktil.Flaeche.Farbe}" />
        <Setter Property="Balken">
            <Setter.Value>
                <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
                    <Binding.Converter>
                        <gd:Farbableitung Von="#FF2E2E2F" Zu="#FF4A4A4C" ZuUnten="#FF424244" />
                    </Binding.Converter>
                </Binding>
            </Setter.Value>
        </Setter>
        <Setter Property="Rand" Value="{x:Null}" />
        <Setter Property="Schimmer">
            <Setter.Value>
                <SolidColorBrush Color="#2EFFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ===================================================================== Spinner -->

    <!-- Eine Vorlage für beide: Glas 4 ein Bogen im Licht des Fortschritts auf der eingelassenen Rinne, Taktil das Zahnrad
         aus dem Metall der Familie. -->
    <ControlTemplate x:Key="Glas.Vorlage.Spinner" TargetType="gd:Spinner">
        <gd:Spinnerbild x:Name="Bild" Art="{TemplateBinding Art}" Laeuft="{TemplateBinding Laeuft}"
                        Spur="{DynamicResource Glas.Fortschritt.Spur}" Kante="{DynamicResource Glas.Fortschritt.Spur.Kante}"
                        Licht="{DynamicResource Glas.Fortschritt.Licht.Farbe}" Metall="{DynamicResource Glas.Taktil.Metall.Farbe}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True" />
    </ControlTemplate>

    <Style x:Key="Glas.Spinner" TargetType="gd:Spinner">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Spinner}" />
        <Setter Property="Art" Value="Bogen" />
        <Setter Property="Width" Value="{DynamicResource Glas.Mass.Spinner.Groesse}" />
        <Setter Property="Height" Value="{DynamicResource Glas.Mass.Spinner.Groesse}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Glas.Taktil.Spinner" TargetType="gd:Spinner" BasedOn="{StaticResource Glas.Spinner}">
        <Setter Property="Art" Value="Zahnrad" />
    </Style>

    <!-- ===================================================================== Leerzustand -->

    <!-- Glas 4: Fläche wie Glas.Feld ohne Leiste, großes Zeichen in der silbrigen Schrift, Titel, darunter die Aktion. -->
    <ControlTemplate x:Key="Glas.Vorlage.Leerzustand" TargetType="gd:Leerzustand">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Feldkoerper Flaeche="{TemplateBinding Background}" Rand="{TemplateBinding BorderBrush}"
                            Ecke="{DynamicResource Glas.Mass.Feld.Ecke}" Randbreite="{DynamicResource Glas.Mass.Feld.Rand}" Glanz="{DynamicResource Glas.Mass.Feld.Glanz}" />
            <StackPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                <gd:Glassymbol x:Name="Zeichen" Symbol="{TemplateBinding Symbol}" Anteil="0.9" StrichAnteil="0.06" HorizontalAlignment="Center"
                               Width="{DynamicResource Glas.Mass.Leerzustand.Symbol}" Height="{DynamicResource Glas.Mass.Leerzustand.Symbol}"
                               Foreground="{DynamicResource Glas.Schrift}" />
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,12,0,14"
                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="{DynamicResource Glas.Mass.Knopf.Schrift}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Zeichen" Property="Foreground" Value="{DynamicResource Glas.Schrift.Gesperrt}" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Text.Gedaempft}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Leerzustand" TargetType="gd:Leerzustand">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Leerzustand}" />
        <Setter Property="Background" Value="{DynamicResource Glas.Feld.Flaeche}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glas.Feld.Rand}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Text}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{x:Static gd:Schriftwahl.Wandler}">
                    <Binding Path="(gd:Glas.Schriftwunsch)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource Glas.Mass.Textfeld.Schrift}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Taktil (Vorbild "Empty State"): eingelassene Tafel, die getrennte Kette groß in gebürstetem Metall (ein Verlauf aus
         Glas.Taktil.Metall.Farbe), Titel hell, darunter ein gehobener Knopf (Inhalt, etwa Glas.Taktil.Knopf). -->
    <ControlTemplate x:Key="Glas.Vorlage.Taktil.Leerzustand" TargetType="gd:Leerzustand">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Taktilkoerper x:Name="Koerper" Ebene="Eingelassen" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}"
                              Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True" />
            <StackPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                <gd:Glassymbol x:Name="Zeichen" Symbol="{TemplateBinding Symbol}" Anteil="0.9" StrichAnteil="0.09" HorizontalAlignment="Center"
                               Width="{DynamicResource Glas.Mass.Leerzustand.Symbol}" Height="{DynamicResource Glas.Mass.Leerzustand.Symbol}"
                               gd:Glas.Ableitungsquelle="{DynamicResource Glas.Taktil.Metall.Farbe}">
                    <gd:Glassymbol.Foreground>
                        <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
                            <Binding.Converter>
                                <gd:Farbableitung Von="#FF7A726B" Zu="#FFA79F98" ZuUnten="#FF5E5752" />
                            </Binding.Converter>
                        </Binding>
                    </gd:Glassymbol.Foreground>
                </gd:Glassymbol>
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,12,0,14"
                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="{DynamicResource Glas.Mass.Taktil.Schrift}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Rueckmeldung.Teil.TextMittig}" />
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Zeichen" Property="Foreground" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Taktil.Leerzustand" TargetType="gd:Leerzustand" BasedOn="{StaticResource Glas.Leerzustand}">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Taktil.Leerzustand}" />
        <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift}" />
        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Vorgabestile der neuen Typen (keiner für ToolTip) -->

    <Style TargetType="gd:Toast" BasedOn="{StaticResource Glas.Toast}" />
    <Style TargetType="gd:Toaststapel" BasedOn="{StaticResource Glas.Toaststapel}" />
    <Style TargetType="gd:Hinweisbanner" BasedOn="{StaticResource Glas.Hinweisbanner}" />
    <Style TargetType="gd:Dialog" BasedOn="{StaticResource Glas.Dialog}" />
    <Style TargetType="gd:Skelett" BasedOn="{StaticResource Glas.Skelett}" />
    <Style TargetType="gd:Spinner" BasedOn="{StaticResource Glas.Spinner}" />
    <Style TargetType="gd:Leerzustand" BasedOn="{StaticResource Glas.Leerzustand}" />
</ResourceDictionary>
