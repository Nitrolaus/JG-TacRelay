            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Inhalt" Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Glutglas.Schrift.Gesperrt}" />
