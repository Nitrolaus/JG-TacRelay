                    </TextElement.Foreground>
                </ContentPresenter>
                <Grid x:Name="Fuss" Grid.Row="3" Margin="0,14,0,0">
                    <ContentPresenter Content="{TemplateBinding Aktionen}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <ContentPresenter x:Name="Zahl" Content="{TemplateBinding Zahl}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      TextElement.FontSize="{DynamicResource Glas.Mass.Glutglas.Schrift}" />
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Kopfbild" Value="{x:Null}">
                <Setter TargetName="Kopfbild" Property="Visibility" Value="Collapsed" />
