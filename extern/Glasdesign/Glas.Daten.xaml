        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Taktil (Vorbild "Cards"): eine eingelassene Fläche etwas dunkler als die Karte, das Zeichen in warmem Metallgrau; beide
         aus Glas.Taktil.Flaeche.Farbe abgeleitet. -->
    <Style x:Key="Glas.Taktil.Bildplatzhalter" TargetType="gd:Bildplatzhalter" BasedOn="{StaticResource Glas.Bildplatzhalter}">
        <Setter Property="gd:Glas.Ableitungsquelle" Value="{DynamicResource Glas.Taktil.Flaeche.Farbe}" />
        <Setter Property="Flaeche">
            <Setter.Value>
                <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
                    <Binding.Converter>
                        <gd:Farbableitung Von="#FF2E2E2F" Zu="#FF242425" ZuUnten="#FF2A2A2B" />
                    </Binding.Converter>
                </Binding>
            </Setter.Value>
        </Setter>
        <Setter Property="Rand" Value="{x:Null}" />
        <Setter Property="Zeichenfarbe">
            <Setter.Value>
                <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
