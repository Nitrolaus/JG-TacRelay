         von selbst im Taktil-Stil), der Titel hell und halbfett, der Text gedämpft, unten die Aktion (etwa
         Glas.Taktil.Knopf.Haupt). Den Schatten zeichnet die Sprechblase als Ringe, nicht der Körper als Effekt. -->
    <ControlTemplate x:Key="Glas.Vorlage.Taktil.Karte" TargetType="gd:Karte">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <gd:Sprechblase Zipfelseite="Keine" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}" Zwischenbild="True" />
            <gd:Taktilkoerper x:Name="Koerper" Ebene="Karte" Ecke="{DynamicResource Glas.Mass.Taktil.Ecke}" Schatten="Aus" Zwischenbild="True"
                              Schriftwunsch="{TemplateBinding gd:Glas.Schriftwunsch}" SchriftAnSteuerelement="True" />
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter x:Name="Kopfbild" Content="{TemplateBinding Kopfbild}" Margin="0,0,0,14" />
                <Grid x:Name="Kopf" Grid.Row="1" Margin="0,0,0,4">
