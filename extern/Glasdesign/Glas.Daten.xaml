            <gd:Feldkoerper x:Name="Flaeche" Ecke="100" Randbreite="0" Flaeche="{TemplateBinding Background}" Visibility="Hidden" />
            <gd:Glassymbol x:Name="Zeichen" Symbol="WinkelLinks" Anteil="0.5" StrichAnteil="0.075" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Flaeche" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="gd:Glas.ZustandVorschau" Value="Ueberfahren">
                <Setter TargetName="Flaeche" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="gd:Glas.Tastaturfokus" Value="True">
                <Setter TargetName="Saum" Property="Fokus" Value="True" />
            </Trigger>
            <Trigger Property="gd:Glas.ZustandVorschau" Value="Fokus">
                <Setter TargetName="Saum" Property="Fokus" Value="True" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Flaeche" Property="Visibility" Value="Visible" />
                <Setter TargetName="Zeichen" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="gd:Glas.ZustandVorschau" Value="Gedrueckt">
                <Setter TargetName="Flaeche" Property="Visibility" Value="Visible" />
                <Setter TargetName="Zeichen" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Flaeche" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Zeichen" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Glas.Taktil.Karte.Teil.Zurueck" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Glas.Vorlage.Karte.Teil.Zurueck}" />
