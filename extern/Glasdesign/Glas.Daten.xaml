                                      TextElement.FontWeight="SemiBold" TextElement.FontSize="{DynamicResource Glas.Mass.Taktil.Schrift}">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Daten.Teil.Text}" />
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </Grid>
                <ContentPresenter x:Name="Inhalt" Grid.Row="2" gd:Glas.Ableitungsquelle="{DynamicResource Glas.Taktil.Schrift}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glas.Daten.Teil.Text}" />
                    </ContentPresenter.Resources>
                    <gd:Glas.Schriftwunsch>
                        <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
                            <Binding.Converter>
                                <gd:Farbableitung Von="#FFE6E6E8" Zu="#FFA9A9AD" />
                            </Binding.Converter>
                        </Binding>
                    </gd:Glas.Schriftwunsch>
                    <TextElement.Foreground>
                        <MultiBinding Converter="{x:Static gd:Schriftwahl.Wandler}">
                            <Binding Path="(gd:Glas.Schriftwunsch)" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="Koerperflaeche" ElementName="Koerper" />
                            <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </TextElement.Foreground>
                </ContentPresenter>
                <Grid x:Name="Fuss" Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{TemplateBinding Aktionen}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <ContentPresenter x:Name="Zahl" Grid.Column="1" Content="{TemplateBinding Zahl}" Margin="12,0,0,0" VerticalAlignment="Bottom"
                                      TextElement.FontSize="{DynamicResource Glas.Mass.Taktil.Schrift}" />
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Kopfbild" Value="{x:Null}">
                <Setter TargetName="Kopfbild" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Zurueck" Value="True">
                <Setter TargetName="PART_Zurueck" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Header" Value="{x:Null}" />
                    <Condition Property="Zurueck" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Kopf" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Aktionen" Value="{x:Null}" />
                    <Condition Property="Zahl" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Fuss" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                <Setter Property="gd:Glas.Schriftwunsch" Value="{DynamicResource Glas.Taktil.Schrift.Gesperrt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

