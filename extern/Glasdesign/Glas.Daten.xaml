    <!-- ===================================================================== Bildplatzhalter -->

    <!-- Glas 4: eingelassen wie die Mulde des Textfelds, das Zeichen in der gedämpften Schrift. -->
    <Style x:Key="Glas.Bildplatzhalter" TargetType="gd:Bildplatzhalter">
        <Setter Property="Flaeche" Value="{DynamicResource Glas.Textfeld.Flaeche}" />
        <Setter Property="Rand" Value="{DynamicResource Glas.Textfeld.Rand}" />
        <Setter Property="Zeichenfarbe" Value="{DynamicResource Glas.Text.Gedaempft}" />
        <Setter Property="Tiefe" Value="0.5" />
        <Setter Property="Ecke" Value="{DynamicResource Glas.Mass.Textfeld.Ecke}" />
        <Setter Property="Height" Value="{DynamicResource Glas.Mass.Bildplatzhalter.Hoehe}" />
