    <Style x:Key="Glas.Glutglas.Karte.Teil.Zurueck" TargetType="ButtonBase" BasedOn="{StaticResource Glas.Taktil.Karte.Teil.Zurueck}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="gd:Glas.Ableitungsquelle" Value="{DynamicResource Glas.Glutglas.Scheibe.Farbe}" />
        <Setter Property="Background">
            <Setter.Value>
                <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
