    <!-- Schieber (Slider): dunkle Bahn mit grauer Kugel im Ring (Glas.Glanzkugel.Regler) oder Chrombahn mit Kugel in der
         Farbe des Knopfs (Glas.Glanzkugel.Regler.Silber). -->
    <Style x:Key="Glas.Glanzkugel.Regler.Teil.Leer" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Glas.Glanzkugel.Regler.Teil.Knauf" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <gd:Leuchtsaum x:Name="Saum" Form="Pille" EigenerTon="{DynamicResource Glas.Glanzkugel.Kugel}">
                            <gd:Leuchtsaum.Fokus>
                                <Binding Path="(gd:Glas.Tastaturfokus)" RelativeSource="{RelativeSource AncestorType=Slider}" />
                            </gd:Leuchtsaum.Fokus>
                        </gd:Leuchtsaum>
                        <gd:Kugelkoerper x:Name="Koerper" Art="{TemplateBinding gd:Glas.Kugelart}" Farbe="{TemplateBinding Background}" Rand="0.09" Rundung="0.5" Boden="False" />
                        <gd:Chromrand x:Name="Ring" Familie="Glanzkugel" Anteil="0.09" Rundung="0.5" Zustand="{Binding Zustand, ElementName=Koerper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Koerper" Property="Zustand" Value="Ueberfahren" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Ueberfahren">
                            <Setter TargetName="Koerper" Property="Zustand" Value="Ueberfahren" />
                        </Trigger>
                        <Trigger Property="gd:Glas.ZustandVorschau" Value="Fokus">
                            <Setter TargetName="Saum" Property="Fokus" Value="True" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Koerper" Property="Zustand" Value="Gedrueckt" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Koerper" Property="Zustand" Value="Gesperrt" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Glas.Vorlage.Glanzkugel.Regler" TargetType="Slider">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True" Height="{DynamicResource Glas.Mass.Glanzkugel.Schieber}">
            <gd:Kugelkoerper x:Name="Bahn" Art="Bahn" Ecke="10" />
            <!-- Die Silberbahn folgt der Kuppelfarbe (0.5.0-beta.7, gd:Farbableitung): die helle Bahn zur dunklen, um denselben
                 Abstand heller wie in der Vorgabe (#1C1C1C zu #DCDCDE, bis beta.6 fest). -->
            <gd:Kugelkoerper x:Name="Silberbahn" Art="Rahmen" Rand="0.12" Rundung="0.5" Visibility="Collapsed" gd:Glas.Ableitungsquelle="{DynamicResource Glas.Glanzkugel.Kuppel.Farbe}">
                <gd:Kugelkoerper.Farbe>
                    <Binding Path="(gd:Glas.Ableitungsquelle)" RelativeSource="{RelativeSource Self}">
                        <Binding.Converter>
                            <gd:Farbableitung Von="#FF1C1C1C" Zu="#FFDCDCDE" />
                        </Binding.Converter>
                    </Binding>
                </gd:Kugelkoerper.Farbe>
            </gd:Kugelkoerper>
            <gd:Chromrand x:Name="Silberrand" Familie="Glanzkugel" Anteil="0.12" Rundung="0.5" Visibility="Collapsed" />
            <Track x:Name="PART_Track" Margin="4">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Glas.Glanzkugel.Regler.Teil.Leer}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Glas.Glanzkugel.Regler.Teil.Leer}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Knauf" Style="{StaticResource Glas.Glanzkugel.Regler.Teil.Knauf}" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                           Background="{TemplateBinding Background}" gd:Glas.Kugelart="{TemplateBinding gd:Glas.Kugelart}"
                           gd:Glas.ZustandVorschau="{TemplateBinding gd:Glas.ZustandVorschau}" gd:Glas.Tastaturfokus="{TemplateBinding gd:Glas.Tastaturfokus}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="gd:Glas.Kugelart" Value="Kugel">
                <Setter TargetName="Bahn" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Silberbahn" Property="Visibility" Value="Visible" />
                <Setter TargetName="Silberrand" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_Track" Property="Margin" Value="5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bahn" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Silberbahn" Property="Zustand" Value="Gesperrt" />
                <Setter TargetName="Silberrand" Property="Zustand" Value="Gesperrt" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

