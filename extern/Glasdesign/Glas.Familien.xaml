        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="(gd:Glas.Kontrastschrift)" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Glas.Glanzkugel.Kugel}" />
