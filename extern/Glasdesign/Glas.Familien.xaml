        <ControlTemplate.Triggers>
            <Trigger Property="gd:Glas.Ringanteil" Value="0">
                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
