        <GradientStop Color="#33FFFFFF" Offset="0.3" />
        <GradientStop Color="#26FFFFFF" Offset="0.7" />
        <GradientStop Color="#7AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glas.Kante.Gesperrt" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.5" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glas.Kante.Haupt" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#8CC6EEEE" Offset="0" />
        <GradientStop Color="#24C6EEEE" Offset="0.3" />
        <GradientStop Color="#1AC6EEEE" Offset="0.7" />
        <GradientStop Color="#5CC6EEEE" Offset="1" />
    </LinearGradientBrush>
    <!-- Glas 4: Haarlinie eingerastet und Ton des Leuchtsaums (Petrol, eingerastet etwas heller). -->
    <LinearGradientBrush x:Key="Glas.Kante.Leuchten" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#C74FB3B4" Offset="0" />
        <GradientStop Color="#804FB3B4" Offset="0.3" />
        <GradientStop Color="#734FB3B4" Offset="0.7" />
        <GradientStop Color="#B34FB3B4" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="Glas.Leuchtsaum.Farbe">#FF2F8A8C</Color>
    <Color x:Key="Glas.Leuchtsaum.Auswahl.Farbe">#FF3A9FA1</Color>
