         die Vorgaben (Bauplan.cs), in Glint einstellbar. -->
    <gd:Bauplan x:Key="Glas.Bauplan" />
    <!-- Farbglasknöpfe (Gel und Kissen, Sarevocs Vorbild vom 07.10.2026): Wulst, Glanzband, Funkeln, Spiegelung; in Glint einstellbar.
         Die Grundfarbe gilt nur, wenn ein Knopf keinen eigenen Background mitbringt. -->
    <gd:Farbglasprofil x:Key="Glas.Farbglasprofil" KissenWulst="0.17" KissenTiefe="0.55" KissenLicht="0.38" KissenGlanz="0.95"
                       KissenSchatten="0.4" GelRand="0.34" GelGlanz="0.78" GelGlanzHoehe="0.46" GelBodenlicht="0.5"
                       GelFunkeln="0.95" GelSpiegelung="0.28" GelBodenlinie="0.3" Ueberfahren="0.08" Gedrueckt="0.12"
                       MetallHorizont="0.7" MetallKontrast="0.62" MetallGlanz="0.85" MetallKuehle="0.25" MetallWischer="0.5" MetallSchatten="0.45"
                       ClayLicht="0.55" ClayTiefe="0.15" ClaySchatten="0.6" BrutalVersatz="6" BrutalRand="2.5" />
