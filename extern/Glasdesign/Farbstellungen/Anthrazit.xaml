    <sys:Double x:Key="Glas.Mass.Regler.Hoehe">22</sys:Double>
    <sys:Double x:Key="Glas.Mass.Regler.Knauf">16</sys:Double>
    <sys:Double x:Key="Glas.Mass.Regler.Spur">4</sys:Double>
    <Thickness x:Key="Glas.Mass.Regler.Spurrand">8,0,8,0</Thickness>
    <sys:Double x:Key="Glas.Mass.Zahlenfeld.Breite">96</sys:Double>
