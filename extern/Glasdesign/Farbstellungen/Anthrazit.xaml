    <Thickness x:Key="Glas.Mass.Feld.Innenabstand">20,10,18,10</Thickness>
    <!-- Textfeld (Stile Glas.Textfeld, Glas.Passwortfeld): Höhe, Innenabstand, Schrift, Ecke, Leuchten im Fokus. -->
    <sys:Double x:Key="Glas.Mass.Textfeld.Hoehe">32</sys:Double>
    <Thickness x:Key="Glas.Mass.Textfeld.Innenabstand">10,0,10,0</Thickness>
    <sys:Double x:Key="Glas.Mass.Textfeld.Schrift">14</sys:Double>
