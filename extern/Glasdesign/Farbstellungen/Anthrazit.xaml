    <sys:Double x:Key="Glas.Mass.Fluessigglas.Farbsaum">0.12</sys:Double>
    <Thickness x:Key="Glas.Mass.Fluessigglas.Innenabstand">22,12,22,12</Thickness>
    <sys:Double x:Key="Glas.Mass.Milchglas.Unschaerfe">26</sys:Double>
    <sys:Double x:Key="Glas.Mass.Milchglas.Ecke">18</sys:Double>
    <sys:Double x:Key="Glas.Mass.Milchglas.Koernung">0.05</sys:Double>
    <Thickness x:Key="Glas.Mass.Milchglas.Innenabstand">20,16,20,16</Thickness>
