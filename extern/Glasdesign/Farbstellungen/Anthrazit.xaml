    <gd:Glanzprofil x:Key="Glas.Glanzprofil" Kantenspiegel="0.51" Randlicht="1.55" Schein="0.45" Randglanz="1" RandglanzLage="131"
                    RandglanzLaenge="0.48" RandglanzBreite="2" RandglanzHof="0.68" Gegenglanz="1" GegenglanzLage="-39"
                    Schatten="0.85" Ueberfahren="1.25" Gedrueckt="0.95" Dunkel="0.85"
                    LeuchtsaumUeberfahren="0.12" LeuchtsaumFokus="0.12" LeuchtsaumEingerastet="0.19" LeuchtsaumReichweite="14"
                    LeuchtsaumAbfall="1.5" LeuchtsaumOben="0.45" LeuchtsaumUnten="1.4" LeuchtsaumInnen="0" LeuchtsaumEinblenden="150"
                    SpotlichtRand="0.55" SpotlichtInnen="0.05" SpotlichtRadius="80" SpotlichtEinblenden="120"
                    LichtkanteBreite="1.5" LichtkanteSchein="0.35" LichtkanteReichweite="10" LichtkanteKomet="0.45" LichtkanteUmlauf="2400" />
