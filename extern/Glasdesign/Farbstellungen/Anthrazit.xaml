    <LinearGradientBrush x:Key="Glas.Schrift" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFF6F7F8" Offset="0" />
        <GradientStop Color="#FFD8DCDF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glas.Schrift.Gesperrt" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFA0A4A7" Offset="0" />
        <GradientStop Color="#FF909497" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Glas.Kante" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#8CFFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.3" />
        <GradientStop Color="#1AFFFFFF" Offset="0.7" />
        <GradientStop Color="#5CFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glas.Kante.Ueber" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
