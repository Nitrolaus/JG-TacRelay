    <SolidColorBrush x:Key="Glas.Textfeld.Rand" Color="#FF3E4549" po:Freeze="True" />
    <SolidColorBrush x:Key="Glas.Textfeld.Rand.Ueber" Color="#FF5A6368" po:Freeze="True" />
    <SolidColorBrush x:Key="Glas.Textfeld.Rand.Fokus" Color="#FF4FB3B4" po:Freeze="True" />
