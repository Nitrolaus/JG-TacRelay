<!-- Glasdesign - Maintainer: Sarevoc -->
<!--
  Farbstellung "Anthrazit": Anthrazit und Grau, neutral und ruhig, silberne Haarlinie; ein gedämpfter Akzent Petrol
  (#2F8A8C, hell #4FB3B4) für Hauptaktionen, Auswahl, Haken, Fokusleuchten und Links. Glas 3 wie Standard (Haarlinie,
  gewölbter Körper, Spiegelungen); der Leuchtschalter in neutralem Glas, die Leuchtfarben, Statusfarben und die Farben
  der Stilfamilien wie Standard, weil sie Zustände tragen oder eigene Vorgaben sind. Gleiche Schlüssel wie Standard.xaml
  (Schluessel.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:gd="clr-namespace:Glasdesign"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <sys:String x:Key="Glas.Thema.Name">Anthrazit</sys:String>

    <Color x:Key="Glas.Grund.Farbe">#FF2B2F33</Color>
    <SolidColorBrush x:Key="Glas.Grund" Color="#FF2B2F33" po:Freeze="True" />

    <SolidColorBrush x:Key="Glas.Text" Color="#FFDCDFE1" po:Freeze="True" />
