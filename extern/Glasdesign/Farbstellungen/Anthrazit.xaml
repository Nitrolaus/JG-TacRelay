    <sys:Double x:Key="Glas.Mass.Formknopf.Hoehe">40</sys:Double>
    <gd:Umriss x:Key="Glas.Mass.Formknopf.Umriss" Text="Fase 8" />
    <!-- Feld (Stil Glas.Feld): Eckenradius, Randbreite, Akzentleiste, Leuchten außen, Glanzlinie oben, Innenabstand. -->
    <sys:Double x:Key="Glas.Mass.Feld.Ecke">12</sys:Double>
    <sys:Double x:Key="Glas.Mass.Feld.Rand">1</sys:Double>
    <sys:Double x:Key="Glas.Mass.Feld.Akzentbreite">6</sys:Double>
    <sys:Double x:Key="Glas.Mass.Feld.Leuchten">0</sys:Double>
    <sys:Double x:Key="Glas.Mass.Feld.Leuchtweite">8</sys:Double>
