    <Color x:Key="Glas.Lichtkante.Anfang.Farbe">#FF4FB3B4</Color>
    <Color x:Key="Glas.Lichtkante.Mitte.Farbe">#FFA8DCDA</Color>
    <Color x:Key="Glas.Lichtkante.Ende.Farbe">#FF2F8A8C</Color>

    <Color x:Key="Glas.Spiegel.Farbe">#FFFFFFFF</Color>
