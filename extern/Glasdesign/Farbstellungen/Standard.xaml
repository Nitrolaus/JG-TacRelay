<!-- Glasdesign - Maintainer: Sarevoc -->
<!--
  Farbstellung "Standard": Sarevocs eigenes Design. Anthrazit, Türkis, Blau als zweite Akzentfarbe für Links und Auswahl.
  Glas 3 (Muster 3b, von Sarevoc am 02.10.2026 gewählt): Haarlinie von einem Gerätepixel, halbdurchsichtig weiß, gewölbter
  Körper (oben und unten heller als in der Mitte), Spiegelungen im Ton von Glas.Spiegel.Farbe. Glas.Leucht.* nach dem
  JG-Schalter (Stahlblau). Alle Schlüssel stehen in Schluessel.cs; eine eigene Farbstellung kopiert diese Datei und ändert
  nur Werte. Die Datei ist lose ladbar; ihr einziger Codeverweis ist das Glanzprofil (gd:Glanzprofil, Glas 4), dafür
  muss die Bibliothek im Prozess geladen sein, was sie bei jeder Anwendung von Glasdesign ohnehin ist.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
