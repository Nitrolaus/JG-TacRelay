<!-- JG TacRelay - Maintainer: Sarevoc -->
<Project>
  <!--
    Feste Kopien eigener Bibliotheken aus anderen Projekten (extern\Glasdesign, Herkunft und SHA-256 in HERKUNFT.md daneben).
    Sie bauen mit denselben Analyse- und Warnungseinstellungen wie JG TacRelay (Directory.Build.props eine Ebene höher), tragen
    aber ihren eigenen Produktnamen und ihre eigene Fassung, nicht die von JG TacRelay. Die kopierten Dateien bleiben unverändert.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Glasdesign'">
    <Product>Glasdesign</Product>
    <Version>0.5.0-beta.13</Version>
  </PropertyGroup>
</Project>
